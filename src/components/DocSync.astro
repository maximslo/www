---
// Interactive companion to the "why ProseMirror" design decision: a single
// authored doc, shown live rather than asserted. Typing in the left box
// re-renders the JSON on the right on every keystroke because both read the
// same in-memory doc — there's no second copy to keep in sync. The initial
// schemaJson below and the client script's render() build the same object
// shape by necessity — Astro frontmatter runs at build time (for the
// pre-hydration markup) and the <script> runs in the browser, so there's no
// module boundary to share one copy across both without a build step this
// component doesn't need.
interface Props {
  question?: string;
  initial?: string;
}
const {
  question = 'Can quiche be made ahead of time?',
  initial = 'Quiche tastes best served after 20–30 minutes of cooling, within an hour of baking. It can be fully cooled, then refrigerated for up to 3 days, though the crust softens. See our make-ahead guide for storing and reheating.',
} = Astro.props;

const schemaJson = JSON.stringify(
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: question,
        acceptedAnswer: { '@type': 'Answer', text: initial },
      },
    ],
  },
  null,
  2,
);
---

<div class="docsync cols">
  <div class="docsync-pane">
    <p class="docsync-pane-label">FAQ ANSWER</p>
    <div class="docsync-box docsync-box-light">
      <p class="docsync-question">{question}</p>
      <textarea class="docsync-input" spellcheck="false" autocomplete="off">{initial}</textarea>
    </div>
  </div>
  <div class="docsync-pane">
    <p class="docsync-pane-label">FAQ PAGE SCHEMA</p>
    <pre class="docsync-box docsync-box-dark docsync-schema">{schemaJson}</pre>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.docsync').forEach((root) => {
    const textarea = root.querySelector<HTMLTextAreaElement>('.docsync-input')!;
    const schemaEl = root.querySelector<HTMLElement>('.docsync-schema')!;
    const question = root.querySelector<HTMLElement>('.docsync-question')!.textContent || '';

    function render() {
      const doc = {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: [
          {
            '@type': 'Question',
            name: question,
            acceptedAnswer: { '@type': 'Answer', text: textarea.value },
          },
        ],
      };
      schemaEl.textContent = JSON.stringify(doc, null, 2);
    }

    textarea.addEventListener('input', render);
  });
</script>

<style>
  .docsync {
    --wapo-blue: #6b8afd;
    /* overrides the site's default .cols margin-block (24px) — this exhibit
       reads as heavier than a plain image pair, so it gets more air above
       and below than the padding a collapsed sibling margin would give it */
    margin-block: 40px;
  }

  /* qualified with the parent, not just `.docsync-pane-label`: the outer
     wrapper carries `.cols` (for the site's responsive 2-column grid), and
     [slug].astro's `.prose :global(.cols p) { margin-bottom: 0 }` — meant to
     kill spacing under image captions — otherwise wins on specificity and
     zeroes this out, same qualified-selector fix CodeWindow.astro uses for
     the analogous `.prose p` collision. */
  .docsync-pane .docsync-pane-label {
    margin: 0 0 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: -0.1px;
    color: var(--muted);
  }

  /* both panes sit in the same .cols grid row, which stretches them to equal
     height by default — flex-column here lets the box below fill that full
     stretched height instead of just its own content height */
  .docsync-pane {
    display: flex;
    flex-direction: column;
  }

  .docsync-box {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 14px;
    border-radius: 14px;
    padding: 20px;
  }

  .docsync-box-light {
    background: #f2f3f5;
  }
  .docsync-question {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    color: #24292e;
  }
  .docsync-input {
    display: block;
    width: 100%;
    /* flex-grow fills whatever height the row's tallest pane leaves after
       the question line, so this box always matches the schema pane's
       height — 220px is just the floor before either side has real content */
    flex: 1;
    min-height: 220px;
    /* no manual drag-handle — height instead tracks the taller pane via the
       flex/grid stretch above, so it stays correct across any window resize
       on its own rather than needing the reader to fix it by hand */
    resize: none;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 8px;
    background: #fff;
    padding: 12px;
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.55;
    color: #3f3f46;
  }
  .docsync-input:focus {
    outline: 2px solid var(--wapo-blue);
    outline-offset: 1px;
  }

  /* The FAQ pane stands in for the actual reader-facing page, so unlike the
     schema pane (a terminal/code chrome, always dark by site convention —
     see CodeWindow.astro) it should follow the page's own theme rather than
     stay pinned light. `:root` isn't part of this component's rendered tree,
     so only that part of the selector needs :global() to escape scoping —
     same technique CodeWindow.astro uses for its light/plain dark overrides.
     Kept neutral-grey rather than the schema pane's purple-tinted dark, so
     the two panes still read as distinct cards in dark mode too. */
  :global(:root:not([data-theme='light'])) .docsync-box-light {
    background: #1c1c1c;
  }
  :global(:root:not([data-theme='light'])) .docsync-question {
    color: #fafafa;
  }
  :global(:root:not([data-theme='light'])) .docsync-input {
    background: #161616;
    border-color: rgba(255, 255, 255, 0.12);
    color: #e4e4e7;
  }

  .docsync-box-dark {
    background: hsl(266 14% 10%);
  }
  .docsync-schema {
    min-height: 220px;
    margin: 0;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 1.5;
    color: #e1e4e8;
    white-space: pre-wrap;
    word-break: break-word;
  }
</style>
