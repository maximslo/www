---
// Two "apps" inside the phone: the chat (slotted) and the portfolio, the live
// site's black section (/portfolio-embed). Opening the portfolio plays iOS's
// tapped-a-link-in-Messages switch: the chat zooms out into a card over the
// wallpaper, the cards slide left to bring the portfolio in from the right,
// and it zooms in to fill the phone. The phone frame itself never moves.
// AskMe asks for it with a `phone:open-portfolio` event on window.

// The width the portfolio is laid out at before being scaled into the
// phone: the lab rail (1028) plus its 42px padding either side, so its
// width rules see a desktop screen and it looks exactly as on the site.
const DESIGN_W = 1112;
---

<div class="apps" data-apps data-view="chat" style={`--design-w: ${DESIGN_W}`}>
	<div class="app-card app-chat" data-app-chat tabindex="-1">
		<slot />
	</div>
	<div class="app-card app-portfolio" data-app-portfolio inert tabindex="-1">
		<iframe class="app-frame" title="My work" data-app-frame data-src="/portfolio-embed" tabindex="-1"></iframe>
		<button type="button" class="app-back" data-app-back aria-label="Back to chat">
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
				<path d="m15 18-6-6 6-6" />
			</svg>
			Chat
		</button>
		<!-- Like the chat's: a drawn scrollbar kept clear of the phone's
		     curved corners. -->
		<div class="app-scroll" aria-hidden="true" data-app-scroll>
			<div class="app-scroll-thumb" data-app-scroll-thumb></div>
		</div>
	</div>
</div>

<style>
	.apps {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	/* The wallpaper is painted only mid-switch. Left behind a full-size
	   card, it bled through the phone's anti-aliased rounded corners as a
	   coloured fringe. (The script preloads it, so it's there at once.) */
	/* Painted on the phone itself, not on this box inside it: that way its
	   rounded edge is drawn once. Inside, it was clipped to the curve over
	   the phone's own grey, and the grey showed through the soft edge as a
	   light ring round the wallpaper's corners. */
	:global(.phone:has(.apps[data-view="switching"])) {
		background: #1a1a2e url("/images/wallpaper.jpg") center / cover no-repeat;
	}

	.app-card {
		position: absolute;
		inset: 0;
		overflow: hidden;
		transform-origin: 50% 50%;
		/* Its own stacking context, so the rounded corners clip the iframe
		   too: without it, Chrome left the iframe's square corner showing as
		   a white sliver beside the card mid-switch. */
		isolation: isolate;
		/* Each card on its own GPU layer from the start, so the first frame
		   of a switch isn't spent creating and drawing one; and its layout
		   and painting kept to itself. */
		will-change: transform;
		contain: layout paint;
	}

	.app-card:focus {
		outline: none;
	}

	/* The phone's own screen colour: grey in the frame, white full-screen. */
	.app-chat {
		background: var(--phone-screen, var(--color-bg-page));
	}

	.app-portfolio {
		background: var(--color-bg-reveal);
	}

	/* A black rim inside the phone's edge, as wide as the gap between the
	   projects (--rim, set by the script) and following the phone's curve.
	   Tiles scrolling into the rounded corners end in black before the
	   curve, rather than a white tile running into the white page and
	   breaking the phone's outline. Only in the phone frame: full-screen
	   (PhoneFrame's 768px) there are no rounded corners to keep. */
	.app-portfolio::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		border-radius: var(--phone-radius, 0px);
		box-shadow: inset 0 0 0 var(--rim, 0px) var(--color-bg-reveal);
		pointer-events: none;
	}

	@media (width <= 768px) {
		.app-portfolio::after {
			display: none;
		}
	}

	/* Only the app on screen is drawn; both are while switching. */
	.apps[data-view="chat"] .app-portfolio,
	.apps[data-view="portfolio"] .app-chat {
		visibility: hidden;
	}

	/* Laid out at desktop width, scaled to the card (sizes set by the script). */
	.app-frame {
		position: absolute;
		top: 0;
		left: 0;
		width: calc(var(--design-w) * 1px);
		height: 100%;
		border: 0;
		transform-origin: 0 0;
		background: var(--color-bg-reveal);
	}

	/* iOS's "◀ Messages" breadcrumb, as a dark frosted pill. */
	/* The portfolio's scrollbar, drawn here: its own is hidden, as at a third
	   of its size it would be a sliver. Like the chat's, the track stops
	   where the phone's corners start to curve, the thumb inset 4px from
	   the edge. It shows while scrolling, and can be dragged. */
	.app-scroll {
		position: absolute;
		z-index: 2;
		top: var(--phone-radius, 0px);
		bottom: var(--phone-radius, 0px);
		right: 4px;
		width: 6px;
		pointer-events: none;
	}

	.app-scroll-thumb {
		width: 100%;
		height: var(--thumb-h, 0px);
		transform: translateY(var(--thumb-y, 0px));
		border-radius: 3px;
		background: rgba(255, 255, 255, 0.38);
		opacity: 0;
		transition: opacity 300ms ease;
	}

	.app-scroll[data-active] .app-scroll-thumb {
		opacity: 1;
		transition-duration: 100ms;
		pointer-events: auto;
		cursor: default;
	}

	/* Touch: thinner, like the chat's, and only an indicator. */
	@media (pointer: coarse) {
		.app-scroll {
			width: 3px;
		}

		.app-scroll[data-active] .app-scroll-thumb {
			pointer-events: none;
		}
	}

	/* On the same line as the chat's New chat button: that one is 32px,
	   20px in, inside the chat's 1.1 zoom, so on screen 35.2px tall, 22px
	   from the top and the right. This 32px pill is centred on it (22 +
	   1.6), and inset 22px from the left to mirror it. */
	.app-back {
		position: absolute;
		z-index: 2;
		top: 23.6px;
		left: 22px;
		display: flex;
		align-items: center;
		gap: 2px;
		height: 32px;
		padding: 0 14px 0 8px;
		font: inherit;
		font-size: 15px;
		font-weight: 500;
		color: #fff;
		border: 0;
		border-radius: 16px;
		background: rgba(255, 255, 255, 0.14);
		-webkit-backdrop-filter: blur(8px) saturate(180%);
		backdrop-filter: blur(8px) saturate(180%);
		box-shadow: inset 0 0 0 0.5px rgba(255, 255, 255, 0.25);
		cursor: pointer;
		-webkit-tap-highlight-color: transparent;
		transition: transform 200ms ease-out;
		/* Its own layer, scaled whole on press: without it the browser
		   re-placed the letters every frame and they wobbled. */
		will-change: transform;
	}

	.app-back:active {
		transform: scale(0.94);
	}

	.app-back svg {
		width: 18px;
		height: 18px;
	}

	.app-back:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}
</style>

<script>
	import { prefersReducedMotion } from "../scripts/spring";

	const apps = document.querySelector<HTMLElement>("[data-apps]");
	const chat = apps?.querySelector<HTMLElement>("[data-app-chat]");
	const portfolio = apps?.querySelector<HTMLElement>("[data-app-portfolio]");
	const frame = apps?.querySelector<HTMLIFrameElement>("[data-app-frame]");
	const back = apps?.querySelector<HTMLButtonElement>("[data-app-back]");

	// Once per element: a second run (the dev server re-running this script
	// on the same page) would double every listener, and two switchers
	// fighting over the same cards left one frozen mid-switch.
	if (apps && chat && portfolio && frame && back && !apps.dataset.bound) {
		apps.dataset.bound = "";
		const designW = parseFloat(getComputedStyle(apps).getPropertyValue("--design-w")) || 1112;

		/* ---------- The portfolio, scaled to fit ----------
		   Laid out at desktop width and scaled down to the card, the iframe
		   is made as tall as the card would be at that width. */
		const fit = () => {
			const scale = portfolio.clientWidth / designW;
			if (!scale) return;
			frame.style.transform = `scale(${scale})`;
			frame.style.height = `${portfolio.clientHeight / scale}px`;
			// The rim: the grid's gutter, as drawn at this scale.
			portfolio.style.setProperty("--rim", `${16 * scale}px`);
			clearPill(scale);
		};

		/* The projects start below the "‹ Chat" pill, as far under it as it
		   sits from the top. The pill is out here and the grid is in there, at
		   a different scale, so the page is told where. */
		function clearPill(scale = portfolio!.clientWidth / designW) {
			const root = frame!.contentDocument?.documentElement;
			if (!root || !scale) return;
			// The exact top (offsetTop rounds 23.6 to 24).
			const top = parseFloat(getComputedStyle(back!).top) || 0;
			const below = (top * 2 + back!.offsetHeight) / scale;
			root.style.setProperty("--portfolio-top", `${below}px`);
		}
		frame.addEventListener("load", () => clearPill());

		new ResizeObserver(fit).observe(portfolio);
		fit();

		/* ---------- The drawn scrollbar ----------
		   Follows the portfolio page's scroll: sized to how much of it is in
		   view, placed by how far down it is, shown while it moves. */
		const track = apps.querySelector<HTMLElement>("[data-app-scroll]")!;
		const thumb = apps.querySelector<HTMLElement>("[data-app-scroll-thumb]")!;
		const pageScroller = () => frame.contentDocument?.scrollingElement as HTMLElement | null | undefined;
		let hideThumb = 0;
		let dragging = false;
		const placeThumb = () => {
			const el = pageScroller();
			if (!el) return;
			const span = el.scrollHeight - el.clientHeight;
			const room = track.clientHeight;
			if (span <= 0 || !room) {
				track.removeAttribute("data-active");
				return;
			}
			const h = Math.max(24, (room * el.clientHeight) / el.scrollHeight);
			track.style.setProperty("--thumb-h", `${h}px`);
			track.style.setProperty("--thumb-y", `${(el.scrollTop / span) * (room - h)}px`);
			return { span, room, h };
		};
		const wake = () => {
			if (!placeThumb()) return;
			track.toggleAttribute("data-active", true);
			clearTimeout(hideThumb);
			hideThumb = window.setTimeout(() => {
				if (!dragging) track.removeAttribute("data-active");
			}, 900);
		};
		frame.addEventListener("load", () => {
			frame.contentWindow?.addEventListener("scroll", wake, { passive: true });
			placeThumb();
		});
		new ResizeObserver(() => placeThumb()).observe(track);

		// Dragging the thumb scrolls the page, as a native one would.
		thumb.addEventListener("pointerdown", (event) => {
			const el = pageScroller();
			const m = placeThumb();
			if (!el || !m) return;
			event.preventDefault();
			dragging = true;
			thumb.setPointerCapture(event.pointerId);
			const startY = event.clientY;
			const startTop = el.scrollTop;
			const move = (e: PointerEvent) => {
				el.scrollTop = startTop + ((e.clientY - startY) * m.span) / (m.room - m.h);
			};
			const up = () => {
				dragging = false;
				thumb.removeEventListener("pointermove", move);
				wake();
			};
			thumb.addEventListener("pointermove", move);
			thumb.addEventListener("pointerup", up, { once: true });
			thumb.addEventListener("pointercancel", up, { once: true });
		});

		/* Fetched once the homepage has settled, so the switch is instant
		   when it's asked for, without slowing the first load. */
		let wallpaper: HTMLImageElement | null = null;
		const prepare = () => {
			// Wallpaper fetched and decoded ahead, so its first use in a switch
			// doesn't stall that switch's first frame.
			if (!wallpaper) {
				wallpaper = new Image();
				wallpaper.src = "/images/wallpaper.jpg";
				wallpaper.decode().catch(() => {});
			}
			if (!frame.src) frame.src = frame.dataset.src!;
		};

		/* The portfolio's videos stay paused while it's off screen. Loaded in
		   the background, it can't tell it's hidden, so they played (and
		   decoded) the whole time the chat was up, switches included. They
		   start once it has landed; the slide shows their current frame.
		   data-hold stops its own scroll-into-view player restarting them. */
		function holdVideos(hold: boolean) {
			const doc = frame!.contentDocument;
			if (!doc?.body) return;
			doc.documentElement.toggleAttribute("data-hold", hold);
			for (const video of doc.querySelectorAll("video")) {
				if (hold) video.pause();
				else if (video.src) video.play().catch(() => {});
			}
		}
		frame.addEventListener("load", () => holdVideos(apps.dataset.view !== "portfolio"));
		const idle = (cb: () => void) =>
			"requestIdleCallback" in window ? requestIdleCallback(cb, { timeout: 4000 }) : setTimeout(cb, 2000);
		if (document.readyState === "complete") idle(prepare);
		else addEventListener("load", () => idle(prepare), { once: true });

		/* ---------- The switch ----------
		   Measured off a screen recording of iOS (Messages → a tapped link →
		   Chrome), frame by frame at 60fps. The two apps sit side by side in
		   a strip, a gap apart, and the strip does two things at once:
		   - pans one card over, on a spring: half way at ~135ms, 95% at
		     ~350ms, then a long soft settle with no overshoot;
		   - zooms out and back: both cards shrink together to 84.8% at
		     ~170ms, then grow back to full size.
		   The card leaving ends wholly off the side. A spring like that has no
		   cubic-bezier, so the measured curves are the keyframes: one per
		   20ms, sampled from the recording. Going back plays the same motion
		   the other way (the chat coming in from the left), not a rewind. */
		const DURATION = 700;
		// Zoom (card scale) and pan (0 = old app centred, 1 = new one), every 20ms.
		const ZOOM = [1, 0.993, 0.975, 0.949, 0.923, 0.897, 0.877, 0.861, 0.85, 0.849, 0.853, 0.863, 0.876, 0.888, 0.901, 0.913, 0.924, 0.935, 0.944, 0.952, 0.959, 0.966, 0.972, 0.977, 0.98, 0.983, 0.986, 0.988, 0.99, 0.992, 0.994, 0.994, 0.995, 0.996, 0.997, 1];
		const PAN = [0, 0.002, 0.043, 0.141, 0.24, 0.346, 0.443, 0.533, 0.613, 0.68, 0.739, 0.789, 0.829, 0.864, 0.89, 0.913, 0.93, 0.945, 0.957, 0.966, 0.973, 0.978, 0.983, 0.987, 0.989, 0.992, 0.993, 0.995, 0.996, 0.997, 0.997, 0.998, 0.998, 0.998, 0.998, 1];
		// The gap between cards, as a share of the screen's width (it scales
		// with the cards).
		const GAP = 0.0615;

		// Card corners while zoomed out. In the phone frame they're the phone's
		// own, so a full-size card matches it exactly. Full-screen on a phone,
		// where the screen has square corners, they round in as the card
		// shrinks, to an iPhone's.
		const cornerRadius = () => {
			const phone = apps.closest<HTMLElement>(".phone");
			return phone ? parseFloat(getComputedStyle(phone).borderTopLeftRadius) : 0;
		};

		type Track = { el: HTMLElement; frames: Keyframe[] };

		/* Keyframes for both cards. Each card's centre sits at its slot in the
		   strip, (slot − pan) cards over, a card being the screen's width plus
		   the gap, all zoomed. `translate` applies before `scale`, so these are
		   on-screen pixels. */
		function tracks(to: "chat" | "portfolio"): Track[] {
			const w = apps!.clientWidth;
			const step = w * (1 + GAP);
			const phoneR = cornerRadius();
			// Leaving card in slot 0, arriving in slot 1; the strip runs left to
			// open the portfolio and right to come back to the chat.
			const dir = to === "portfolio" ? 1 : -1;
			const [leaving, arriving] = to === "portfolio" ? [chat!, portfolio!] : [portfolio!, chat!];
			/* Only `transform`, so the browser runs the whole switch on the
			   compositor, off the main thread: nothing the page does meanwhile
			   (the chat, the portfolio loading) can drop a frame. One animated
			   property it can't run there (the corner radius was one) pulls the
			   whole animation back onto the main thread, repainting both cards
			   every frame. */
			const frame = (slot: number) =>
				ZOOM.map((zoom, i) => ({
					offset: i / (ZOOM.length - 1),
					transform: `translateX(${dir * (slot - PAN[i]) * step * zoom}px) scale(${zoom})`,
				}));
			/* Corners, set once for the switch rather than animated: the phone's
			   own in the frame (they shrink with the card, in its own pixels, as
			   the screen's do in iOS), an iPhone's where the phone is the whole
			   screen. They're only seen once the cards have shrunk. */
			const r = `${phoneR || 48}px`;
			leaving.style.borderRadius = r;
			arriving.style.borderRadius = r;
			return [
				{ el: leaving, frames: frame(0) },
				{ el: arriving, frames: frame(1) },
			];
		}

		// Where the phone is headed (or is): the only state there is, so a
		// switch that's interrupted or stalls can't leave it stuck "open".
		let target: "chat" | "portfolio" = "chat";
		let running: Animation[] = [];
		let safety = 0;

		function settle(view: "chat" | "portfolio") {
			clearTimeout(safety);
			for (const a of running) a.cancel();
			running = [];
			chat!.style.borderRadius = "";
			portfolio!.style.borderRadius = "";
			holdVideos(view !== "portfolio");
			apps!.dataset.view = view;
			chat!.inert = view !== "chat";
			portfolio!.inert = view !== "portfolio";
			frame!.tabIndex = view === "portfolio" ? 0 : -1;
		}

		async function play(to: "chat" | "portfolio") {
			for (const a of running) a.cancel();
			apps!.dataset.view = "switching";
			chat!.inert = true;
			portfolio!.inert = true;
			if (prefersReducedMotion()) {
				// A plain crossfade, no zoom or slide.
				const fade = (el: HTMLElement, from: number) =>
					el.animate([{ opacity: from }, { opacity: 1 - from }], { duration: 200, easing: "ease" });
				running = to === "portfolio" ? [fade(chat!, 1), fade(portfolio!, 0)] : [fade(chat!, 0), fade(portfolio!, 1)];
			} else {
				const opts: KeyframeAnimationOptions = { duration: DURATION, fill: "forwards" };
				running = tracks(to).map(({ el, frames }) => el.animate(frames, opts));
			}
			const mine = running;
			const land = () => {
				if (running !== mine) return; // Superseded by the opposite switch.
				settle(to);
				// Focus moves into the app on screen, without a ring on anything.
				(to === "portfolio" ? portfolio! : chat!).focus({ preventScroll: true });
			};
			// Lands on its final state even if the animations never report
			// finishing (a throttled tab, say), rather than freezing mid-switch.
			clearTimeout(safety);
			safety = window.setTimeout(land, Math.max(...mine.map((a) => Number(a.effect?.getTiming().duration) || 0)) + 300);
			try {
				await Promise.all(mine.map((a) => a.finished));
			} catch {
				return; // Cancelled: superseded, or already landed.
			}
			land();
		}

		function openPortfolio() {
			if (target === "portfolio") return;
			target = "portfolio";
			prepare();
			// A phone keyboard closes first.
			(document.activeElement as HTMLElement | null)?.blur?.();
			// A back swipe or the back button returns to the chat, rather than
			// leaving the site.
			history.pushState({ ...(history.state ?? {}), portfolio: true }, "");
			void play("portfolio");
		}

		function closePortfolio() {
			if (target === "chat") return;
			target = "chat";
			void play("chat");
		}

		// Reloaded while the portfolio was open: the page starts on the chat,
		// so that history entry no longer means anything.
		if (history.state?.portfolio) history.replaceState({ ...history.state, portfolio: false }, "");

		addEventListener("phone:open-portfolio", openPortfolio);
		back.addEventListener("click", () => {
			if (history.state?.portfolio) history.back();
			else closePortfolio();
		});
		addEventListener("popstate", () => {
			if (target === "portfolio" && !history.state?.portfolio) closePortfolio();
		});
		// Esc from the portfolio's back pill (the iframe keeps its own keys).
		portfolio.addEventListener("keydown", (event) => {
			if (event.key === "Escape") back.click();
		});
	}
</script>
