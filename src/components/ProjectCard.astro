---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  fallbackRatio: string;
  fallbackGradient: string;
}

const { project, fallbackRatio, fallbackGradient } = Astro.props;
const { data } = project;

const external = Boolean(data.href);
const href = data.href ?? `/projects/${project.id}`;
const ratio = data.ratio ?? fallbackRatio;
const hasMedia = Boolean(data.thumbImage || data.video || data.image);
// Crops the rendered tile itself (not just the media) by clipping the box and
// pulling its layout space in by the same amount, so it actually gets shorter.
const cropTop = data.cropTop ?? data.cropY ?? 0;
const cropBottom = data.cropBottom ?? data.cropY ?? 0;
const cropStyle =
  cropTop || cropBottom
    ? `margin-top:-${cropTop}px;margin-bottom:-${cropBottom}px;clip-path:inset(${cropTop}px 0 ${cropBottom}px 0);`
    : '';
// Optional zoomed-out/repositioned media: scales the media down within its box
// (revealing thumbBg at the edges) and/or shifts it horizontally/vertically.
// translate is applied after scale so the px offset is exact regardless of zoom.
const mediaTransforms = [
  data.thumbOffsetX || data.thumbOffsetY
    ? `translate(${data.thumbOffsetX ?? 0}px, ${data.thumbOffsetY ?? 0}px)`
    : '',
  data.thumbZoom ? `scale(${data.thumbZoom})` : '',
]
  .filter(Boolean)
  .join(' ');
const mediaStyle = mediaTransforms ? `transform:${mediaTransforms};` : '';
const thumbBgStyle = hasMedia && data.thumbBg ? `background-color:${data.thumbBg};` : '';
---

<a
  href={href}
  class="card"
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
>
  <span
    class:list={['thumb', { 'has-media': hasMedia }]}
    style={`aspect-ratio:${ratio};${hasMedia ? thumbBgStyle : `background:${fallbackGradient};`}${cropStyle}`}
  >
    {
      data.thumbImage ? (
        <img class="thumb-media" src={data.thumbImage} alt={data.title} loading="lazy" style={mediaStyle} />
      ) : data.video ? (
        <video class="thumb-media" src={data.video} loop muted playsinline preload="metadata" style={mediaStyle} />
      ) : data.image ? (
        <img class="thumb-media" src={data.image} alt={data.title} loading="lazy" style={mediaStyle} />
      ) : (
        <span class="thumb-label">{data.company}</span>
      )
    }
  </span>
  <span class="cap">
    <span class="cap-title">{data.title}</span>
    <span class="cap-meta">{data.company} • {data.status} {data.year}</span>
  </span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .thumb {
    position: relative;
    display: block;
    width: 100%;
    border: 1px solid var(--line);
    /* keep the (semi-transparent) border a clean hairline: don't let the
       tile gradient/video paint under it */
    background-clip: padding-box;
    overflow: hidden;
    box-sizing: border-box;
    transition: filter 0.3s ease;
  }
  /* subtle scrim so the placeholder label stays legible on any tile */
  .thumb::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(20, 24, 33, 0.32), rgba(20, 24, 33, 0) 55%);
  }
  /* media tiles (video/image) show the asset itself — no scrim/label needed */
  .thumb.has-media::after {
    display: none;
  }
  .thumb-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .card:hover .thumb {
    filter: brightness(0.94);
  }
  .thumb-label {
    position: absolute;
    z-index: 1;
    left: 28px;
    bottom: 24px;
    right: 28px;
    color: #fff;
    font-weight: 600;
    font-size: clamp(1.5rem, 2.4vw, 2.25rem);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  .cap {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }
  .cap-title {
    font-family: var(--font-serif);
    font-size: var(--fs-lg);
    letter-spacing: -0.02em;
    color: var(--fg);
  }
  .cap-meta {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--muted);
    text-transform: uppercase;
    white-space: nowrap;
  }

  @media (max-width: 1199px) {
    .cap {
      flex-direction: column;
      align-items: flex-start;
      gap: 2px;
    }
    .cap-meta {
      white-space: normal; /* let the meta wrap instead of forcing tile width */
    }
  }
</style>

<script>
  // Thumbnail videos only play while scrolled into view, so we don't burn
  // bandwidth/battery on autoplaying tiles the user hasn't scrolled to yet.
  //
  // The Ask The Post AI thumbnail hangs on its first frame for a beat before
  // it starts looping, so the opening state actually registers instead of
  // getting lost in the loop.
  const HANG_MS = 900;
  const pendingPlays = new WeakMap<HTMLVideoElement, number>();

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        const pending = pendingPlays.get(video);
        if (pending) {
          window.clearTimeout(pending);
          pendingPlays.delete(video);
        }

        if (entry.isIntersecting) {
          if (video.src.includes('ask-the-post')) {
            video.pause();
            video.currentTime = 0;
            const id = window.setTimeout(() => video.play().catch(() => {}), HANG_MS);
            pendingPlays.set(video, id);
          } else {
            video.play().catch(() => {});
          }
        } else {
          video.pause();
          if (video.src.includes('ask-the-post')) video.currentTime = 0;
        }
      }
    },
    { rootMargin: '200px' }
  );

  document.querySelectorAll<HTMLVideoElement>('video.thumb-media').forEach((video) => {
    observer.observe(video);
  });
</script>
