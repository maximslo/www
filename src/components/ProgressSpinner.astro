---
// A narrated-progress block for the static "Progress, narrated" CodeWindow
// example, matching the Forge/Ramp reference pattern: a header line led by
// a spinner while work is in flight, which morphs into a check once every
// step below it has printed. Sub-steps print one at a time and stay put
// (never replaced or removed). Loops forever via its own tiny scripted
// loop — this one example is the deliberate exception to CodeWindow's
// usual "static, no script" rule.
//
// The spinner itself is the real "dots" spinner from sindresorhus/
// cli-spinners (the default behind ora, used across most Node CLIs): ten
// Unicode braille frames cycling in a single character cell at 80ms each,
// not a hand-built multi-element grid.
interface Props {
  headline?: string;
  steps?: string[];
  done?: string;
}
const {
  headline = 'Verifying breaking news — last 2h...',
  steps = [
    'Scanning live wire — 247 articles in window',
    'Dropping 198 unverified / developing reports',
    'Cross-checking reporter consensus on remaining 49',
  ],
  done = '6 verified stories in the last 2h',
} = Astro.props;
---

<div class="pspin">
  <div class="pspin-line">
    <span class="pspin-icon" aria-hidden="true">⠋</span> <span class="pspin-headline">{headline}</span>
  </div>
  <div class="pspin-steps"></div>
  <div class="pspin-final"></div>
</div>

<script define:vars={{ headline, steps, done }}>
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

  // cli-spinners' "dots" frames, 80ms/frame — the same spinner ora renders
  const FRAMES = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];

  document.querySelectorAll('.pspin').forEach((root) => {
    const icon = root.querySelector('.pspin-icon');
    const stepsEl = root.querySelector('.pspin-steps');
    const finalEl = root.querySelector('.pspin-final');
    if (!icon || !stepsEl || !finalEl) return;

    const addStep = (text) => {
      const line = document.createElement('div');
      line.className = 'pspin-line';
      line.innerHTML = '<span class="pspin-i">i</span> <span>' + text + '</span>';
      stepsEl.appendChild(line);
    };

    const showFinal = () => {
      finalEl.innerHTML = '<div class="pspin-line"><span class="pspin-check" aria-hidden="true">✔</span> <span>' + done + '</span></div>';
    };

    if (REDUCED) {
      icon.classList.add('pspin-ok');
      icon.textContent = '✔';
      steps.forEach(addStep);
      showFinal();
      return;
    }

    let spinning = false;
    let frame = 0;
    const spin = async () => {
      spinning = true;
      icon.classList.remove('pspin-ok');
      while (spinning) {
        icon.textContent = FRAMES[frame % FRAMES.length];
        frame++;
        await sleep(80);
      }
    };

    const run = async () => {
      for (;;) {
        stepsEl.innerHTML = '';
        finalEl.innerHTML = '';
        spin();

        for (const step of steps) {
          await sleep(650);
          addStep(step);
        }

        await sleep(450);
        spinning = false;
        icon.classList.add('pspin-ok');
        icon.textContent = '✔';
        await sleep(300);
        showFinal();
        await sleep(3200);
      }
    };

    // only run once it's actually visible, like the hero Terminal
    let started = false;
    const io = new IntersectionObserver((entries) => {
      if (started || !entries.some((e) => e.isIntersecting)) return;
      started = true;
      io.disconnect();
      run();
    });
    io.observe(root);
  });
</script>

<style>
  /* Binary spacing, matching the Forge reference: lines in the same group
     sit back to back (no gap at all — see .pspin-steps below), and groups
     are separated by exactly one full blank line (one line-height), never
     a partial nudge. */
  .pspin {
    /* reserves space for the fully-populated state (headline + blank +
       3 steps + blank + final line) up front, so the CodeWindow doesn't
       grow/shrink as lines stream in over the loop */
    min-height: 120px;
    margin-top: 16.9px;
    font-family: var(--font-mono);
    font-size: 13px;
    /* tight, terminal-like ratio (real ttys run ~1.2-1.4x), matching the
       code block above it, not the looser ratio prose text uses */
    line-height: 1.3;
    color: #8d8a94;
  }
  .pspin-line {
    display: flex;
    /* flex-start, not center: a wrapped headline (narrower CodeWindow, e.g.
       inside a .media-row) is 2 lines tall, and centering the icon against
       the full wrapped block pulls it off the first line's baseline */
    align-items: flex-start;
    gap: 5px;
  }
  .pspin-icon,
  :global(.pspin-check),
  :global(.pspin-i) {
    /* nudge down to sit on the first line's baseline instead of its cap
       height, now that align-items is flex-start instead of center */
    margin-top: 0.02em;
  }
  .pspin-headline {
    color: #e1e4e8;
  }
  .pspin-steps {
    margin-top: 16.9px;
  }
  .pspin-final {
    margin-top: 16.9px;
  }
  /* :global() throughout: .pspin-steps/.pspin-final's contents are built
     via innerHTML at runtime, so those elements never carry Astro's scope
     attribute — an unscoped rule here would silently never match them
     (same bug class as Terminal.astro's dynamic t-* spans). */
  .pspin-icon {
    display: inline-block;
    width: 1ch;
    color: #22d3ee;
    /* Geist Mono has no glyphs for the Unicode Braille Patterns block, so
       it falls back per-character to the next font in --font-mono; pin to
       a single font with full braille coverage, same fix as the hero
       Terminal's block-drawing "wp" logo. */
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }
  .pspin-icon.pspin-ok {
    color: #4ade80;
  }
  :global(.pspin-check) {
    display: inline-block;
    color: #4ade80;
  }
  :global(.pspin-i) {
    color: #22d3ee;
  }
</style>
