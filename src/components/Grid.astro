---
// Image grid for the portfolio write-ups. Drop into an .mdx body:
//
//   import Grid from "../../components/Grid.astro";
//
//   // equal-WIDTH columns (heights vary by aspect ratio):
//   <Grid cols={3} images={[
//     { src: "every-movie/overview.png", alt: "Full atlas view" },
//     { src: "every-movie/genres.png",  alt: "Genre breakdown", caption: "13 genres, 90 hybrids" },
//   ]} />
//
//   // equal-HEIGHT row (widths follow each image's aspect ratio):
//   <Grid row images={[
//     { src: "drinkbot/leaderboard.png", alt: "The leaderboard" },
//     { src: "drinkbot/3.png", alt: "Recap" },
//   ]} />
//
// `src` is a path INSIDE src/assets/ (no leading slash). Images there are
// optimized at build time (resized + WebP). `cols` is 1–3 (default 2).
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface GridImage {
	src: string;
	alt: string;
	caption?: string;
}
interface Props {
	images: GridImage[];
	cols?: 1 | 2 | 3;
	/** Lay the images in one row matched to the same height (widths follow each
	 *  image's aspect ratio). Overrides `cols`. */
	row?: boolean;
	/** Break out wider than the text column (toward the viewport) so side-by-side
	 *  images get more room. Good for detailed screenshots. */
	wide?: boolean;
}

const { images, cols = 2, row = false, wide = false } = Astro.props;

// map every asset path -> its optimized metadata so authors can reference
// images by a plain string instead of importing each one
const assets = import.meta.glob<{ default: ImageMetadata }>(
	"../assets/**/*.{jpg,jpeg,png,webp,avif,gif,svg}",
	{ eager: true },
);
const resolve = (src: string): ImageMetadata => {
	const mod = assets[`../assets/${src.replace(/^\/+/, "")}`];
	if (!mod) {
		throw new Error(`<Grid>: no image at src/assets/${src}. Check the path and filename.`);
	}
	return mod.default;
};

const items = images.map((img) => {
	const meta = resolve(img.src);
	return { ...img, meta, ar: meta.width / meta.height };
});

// the reading column is 27.5rem ≈ 660px at the 150% root; `wide` breaks out to
// a larger centered container so side-by-side images aren't crushed
const CONTAINER_PX = wide ? 1100 : 660;
const GAP_PX = 10;

// per-image source sizing, so each image is generated at the width it actually
// displays (1×/2×/3× for retina). Differs between grid and row layouts.
const arSum = items.reduce((sum, it) => sum + it.ar, 0);
const rowAvail = CONTAINER_PX - GAP_PX * (items.length - 1);
const cell = Math.round((CONTAINER_PX - GAP_PX * (cols - 1)) / cols);
const mobileVw = cols === 1 ? 92 : 45;

const sizingFor = (ar: number) => {
	if (row) {
		const d = Math.max(1, Math.round((rowAvail * ar) / arSum));
		const vw = Math.round((90 * ar) / arSum);
		return { widths: [d, d * 2, d * 3], sizes: `(max-width: 768px) ${vw}vw, ${d}px` };
	}
	return { widths: [cell, cell * 2, cell * 3], sizes: `(max-width: 768px) ${mobileVw}vw, ${cell}px` };
};
---

<div
	class:list={[row ? "md-row" : "md-grid", { wide }]}
	style={row ? undefined : `--cols:${cols}; --cols-m:${Math.min(cols, 2)}`}
>
	{
		items.map((it) => {
			const { widths, sizes } = sizingFor(it.ar);
			return (
				<figure style={row ? `flex-grow:${it.ar}` : undefined}>
					<Image src={it.meta} alt={it.alt} widths={widths} sizes={sizes} quality={90} />
					{it.caption && <figcaption>{it.caption}</figcaption>}
				</figure>
			);
		})
	}
</div>

<style>
	.md-grid {
		display: grid;
		grid-template-columns: repeat(var(--cols, 2), 1fr);
		gap: 0.4rem;
		margin: var(--space-section) 0;
	}
	.md-grid figure {
		margin: 0;
	}
	/* row: every image the same height, widths proportional to aspect ratio */
	.md-row {
		display: flex;
		align-items: flex-start;
		gap: 0.4rem;
		margin: var(--space-section) 0;
	}
	/* break out wider than the text column, centered on the viewport */
	.wide {
		width: min(92vw, 1100px);
		margin-left: 50%;
		transform: translateX(-50%);
	}
	.md-row figure {
		margin: 0;
		flex-basis: 0;
		min-width: 0; /* allow the flex items to shrink below intrinsic width */
	}
	.md-grid :global(img),
	.md-row :global(img) {
		display: block;
		width: 100%;
		height: auto;
		/* override the .prose img border from the project page */
		border: 0;
	}
	.md-grid figcaption,
	.md-row figcaption {
		color: var(--label);
		font-size: 0.6rem;
		line-height: 1.4;
		margin-top: 0.3rem;
	}
	/* never more than 2 across on a phone (but keep single images full-width) */
	@media (max-width: 768px) {
		.md-grid {
			grid-template-columns: repeat(var(--cols-m, 2), 1fr);
		}
	}
</style>
