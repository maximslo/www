---
// A CodeWindow variant for commands that render two ways from one payload —
// --agent (JSON) and --human (table/prose), per the respond() function in
// the case study's "Two audiences, one code path" section. The toggle here
// is the visual proof of that claim: same command, same underlying data,
// two renders, swapped without a page reload.
interface Props {
  title?: string;
  default?: 'agent' | 'human';
  compact?: boolean;
}
const { title = 'zsh', default: defaultView = 'human', compact = false } = Astro.props;
---

<div class={`resp-window ${compact ? 'compact' : ''}`}>
  <div class="resp-bar">
    <div class="resp-dots" aria-hidden="true">
      <span class="resp-dot"></span>
      <span class="resp-dot"></span>
      <span class="resp-dot"></span>
    </div>
    <p class="resp-title">{title}</p>
    <div class="resp-toggle" role="tablist" aria-label="Response format">
      <button type="button" class="resp-tab" data-view="agent" role="tab" aria-selected={String(defaultView === 'agent')}>
        --agent
      </button>
      <button type="button" class="resp-tab" data-view="human" role="tab" aria-selected={String(defaultView === 'human')}>
        --human
      </button>
    </div>
  </div>
  <div class="resp-screen">
    <div class="resp-view" data-view="agent" hidden={defaultView !== 'agent'}>
      <slot name="agent" />
    </div>
    <div class="resp-view" data-view="human" hidden={defaultView !== 'human'}>
      <slot name="human" />
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.resp-window').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('.resp-tab');
    const views = root.querySelectorAll<HTMLElement>('.resp-view');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const view = tab.dataset.view;
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        views.forEach((v) => {
          v.hidden = v.dataset.view !== view;
        });
      });
    });
  });
</script>

<style>
  .resp-window {
    --prey-300: hsl(263 7% 76%);
    --prey-500: hsl(0 0% 36%);
    --prey-600: hsl(267 6% 29%);
    --prey-700: hsl(266 13% 21%);
    --prey-750: hsl(264 12% 16%);
    --prey-900: hsl(266 14% 10%);
    --wapo-blue: #6b8afd;

    margin-block: 24px;
    border-radius: 16px;
    overflow: hidden;
    background: var(--prey-750);
  }

  /* opt-in compact variant — scaled-down chrome and type for sitting inside
     a .media-row beside a caption, where the window shares the row instead
     of owning the prose column's full width. Width itself is set by the
     .media-row flex layout in [slug].astro, not here. */
  .resp-window.compact .resp-bar {
    height: 36px;
    padding: 4px 6px 4px 12px;
  }
  .resp-window.compact .resp-dot {
    width: 7px;
    height: 7px;
  }
  .resp-window.compact .resp-title {
    font-size: 12px;
  }
  .resp-window.compact .resp-tab {
    padding: 3px 8px;
    font-size: 10px;
  }
  .resp-window.compact .resp-screen {
    padding: 16px;
  }
  .resp-window.compact .resp-screen :global(pre.astro-code) {
    font-size: 11px;
  }

  .resp-bar {
    position: relative;
    display: flex;
    height: 44px;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--prey-700);
    padding: 4px 8px 4px 16px;
  }

  .resp-dots {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 8px;
  }
  .resp-dot {
    width: 8.8px;
    height: 8.8px;
    border-radius: 9999px;
    background: var(--prey-600);
  }

  /* absolute + centered on the border-box, same trick as CodeWindow.astro —
     stays dead center regardless of the toggle's width on the right */
  .resp-bar .resp-title {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    font-family: var(--font-mono);
    font-size: 14px;
    letter-spacing: -0.14px;
    color: var(--prey-300);
    white-space: nowrap;
  }

  .resp-toggle {
    display: flex;
    flex-shrink: 0;
    gap: 2px;
    padding: 3px;
    border-radius: 8px;
    background: var(--prey-900);
  }
  .resp-tab {
    appearance: none;
    cursor: pointer;
    border: none;
    border-radius: 6px;
    background: transparent;
    padding: 4px 10px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--prey-500);
    transition:
      color 0.15s ease,
      background 0.15s ease;
  }
  .resp-tab:hover {
    color: var(--prey-300);
  }
  .resp-tab[aria-selected='true'] {
    background: var(--prey-700);
    color: var(--wapo-blue);
  }

  .resp-screen {
    background: var(--prey-900);
    padding: 24px;
    overflow-x: auto;
  }
  .resp-view[hidden] {
    display: none;
  }

  /* strip the site's default light-card Shiki styling so it sits flush in
     the dark screen, same override CodeWindow.astro applies */
  .resp-screen :global(pre.astro-code) {
    background: transparent !important;
    border: none;
    border-radius: 0;
    margin: 0;
    padding: 0;
    overflow-x: visible;
    font-size: 13px;
    line-height: 1.3;
  }
  /* a view's command line and its JSON are two separate fences (JSON can't
     contain a "$ ..." prompt line and stay valid, so it can't be highlighted
     as JSON in one block) — this restores the blank-line gap between them
     that a single fence gets for free from a literal blank line. */
  .resp-screen :global(pre.astro-code + pre.astro-code) {
    margin-top: 1em;
  }
</style>
