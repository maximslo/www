---
// A compact scripted terminal session for the "wapo setup" onboarding flow —
// same reveal/sleep/loop pattern as Terminal.astro's hero session, but sized
// for one <pre class="term-plain"> inside a compact CodeWindow rather than
// the hero's full 80x24 character grid. Content + timing rebuilt frame-by-
// frame off a screen recording of Context7's own `ctx7 setup --cli` (the
// case study's ".claude/skills" install flow), rebranded to wapo's `brief`
// skill. Reuses CodeWindow.astro's t-green/t-red/t-dim classes so the
// palette matches every other transcript on the page.
---

<pre class="term-plain setup-term"><span class="setup-text"></span><span class="setup-cursor"></span></pre>

<script>
  const REDUCED = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
  // cli-spinners' "dots" frames, same as ProgressSpinner.astro
  const SPIN_FRAMES = ['⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏'];

  const PROMPT_PREFIX = '<span class="t-green">➜</span>  agent-app git:(<span class="t-red">main</span>) <span class="t-red">✗</span> ';
  const CMD = 'npx wapo setup --cli';
  const PROMPT = `${PROMPT_PREFIX}${CMD}`;
  const PROMPT_RESET = PROMPT_PREFIX;
  const AUTH = '<span class="t-green">✔</span> Authenticated';
  const PATH1 = '<span class="t-dim">/Users/dev/.claude/skills</span>';

  // state: 'waiting' (Y/n, nothing typed) | 'typed' (y entered) | 'done' (resolved)
  const installBlock = (state: 'waiting' | 'typed' | 'done') => {
    const glyph = state === 'done' ? '<span class="t-green">✔</span>' : '?';
    const tail = state === 'waiting' ? '(Y/n) ' : state === 'typed' ? '(Y/n) y' : 'Yes';
    return `${glyph} <b>Install to detected location?</b>\n${PATH1}  ${tail}`;
  };

  const skillLine = (path: string) =>
    `  <span class="t-green">+</span> <b>brief</b>  Grounds agents in fresh reporting\n    <span class="t-dim">${path}</span>`;

  const COMPLETE =
    '<span class="t-green">✔</span> Downloaded brief skill\n\n' +
    '<span class="t-green">✔</span> wapo CLI setup complete\n\n' +
    skillLine('/Users/dev/.claude/skills') +
    '\n\n' +
    '<b>Next steps</b>\n' +
    '  Ask your agent: "Use wapo CLI to brief me on the Fed rate decision"';

  document.querySelectorAll<HTMLElement>('.setup-term').forEach((pre) => {
    const text = pre.querySelector<HTMLElement>('.setup-text');
    const cursor = pre.querySelector<HTMLElement>('.setup-cursor');
    if (!text || !cursor) return;

    const render = (html: string, opts: { newline?: boolean; hideCursor?: boolean } = {}) => {
      text.innerHTML = html + (opts.newline ? '\n' : '');
      cursor.style.visibility = opts.hideCursor ? 'hidden' : '';
    };

    const renderFinal = () => {
      render(`${PROMPT}\n\n${AUTH}\n\n${installBlock('done')}\n\n${COMPLETE}`, { newline: true });
    };

    if (REDUCED) {
      renderFinal();
      return;
    }

    const run = async () => {
      for (;;) {
        // 1. the command types itself out character by character
        let typed = '';
        for (const ch of CMD) {
          typed += ch;
          render(`${PROMPT_PREFIX}${typed}`);
          await sleep(18 + Math.random() * 30);
        }
        await sleep(750);

        // 2. bare loading spinner — no headline — for 3s before auth resolves
        const spinUntil = Date.now() + 3000;
        for (let i = 0; Date.now() < spinUntil; i++) {
          render(`${PROMPT}\n\n<span class="setup-spin">${SPIN_FRAMES[i % SPIN_FRAMES.length]}</span>`, {
            hideCursor: true,
          });
          await sleep(80);
        }

        // 3. auth + install prompt land together, waits on (Y/n)
        render(`${PROMPT}\n\n${AUTH}\n\n${installBlock('waiting')}`);
        await sleep(1400);

        // 4. "y" answered
        render(`${PROMPT}\n\n${AUTH}\n\n${installBlock('typed')}`);
        await sleep(500);

        // 5. install resolves, skill download spins (no input cursor while it runs)
        const base = `${PROMPT}\n\n${AUTH}\n\n${installBlock('done')}`;
        for (let i = 0; i < 8; i++) {
          render(`${base}\n\n<span class="setup-spin">${SPIN_FRAMES[i % SPIN_FRAMES.length]}</span> Downloading brief skill...`, {
            hideCursor: true,
          });
          await sleep(80);
        }

        // 6. setup complete — hold so it's readable
        render(`${base}\n\n${COMPLETE}`, { newline: true });
        await sleep(2800);

        // 7. back to a fresh prompt, like a real session continuing
        render(`${base}\n\n${COMPLETE}\n\n${PROMPT_RESET}`);
        await sleep(1200);
      }
    };

    let started = false;
    const io = new IntersectionObserver((entries) => {
      if (started || !entries.some((e) => e.isIntersecting)) return;
      started = true;
      io.disconnect();
      run();
    });
    io.observe(pre);
  });
</script>

<style>
  /* Fixed width + reserved height so the CodeWindow (rendered with `fit`,
     which sizes to its content's natural width) doesn't grow/shrink as the
     session's line lengths change every render call — width pinned to the
     longest line ("Ask your agent: ..."), height to the 18-line complete
     state, same reasoning as ProgressSpinner.astro's min-height. */
  .setup-term {
    width: 492px;
    min-height: calc(18 * 1.3em);
  }

  .setup-cursor {
    display: inline-block;
    width: 1ch;
    height: 1.1em;
    vertical-align: text-bottom;
    background: var(--prey-300);
    animation: setup-blink 1.1s steps(1) infinite;
  }
  @keyframes setup-blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .setup-cursor {
      animation: none;
    }
  }

  /* Braille spinner glyphs need a font with full coverage, same fix as
     ProgressSpinner.astro/Terminal.astro's block-drawing characters. */
  .setup-term :global(.setup-spin) {
    color: #22d3ee;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
  }
</style>
