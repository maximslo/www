---
import { LINKS } from "../config/intro";

// Pulled from the same list the intro's Links column renders, so the footer
// can't end up pointing somewhere the rest of the page doesn't.
const findHref = (label: string) => LINKS.find((link) => link.label === label)?.href;
const xHref = findHref("X");
const emailHref = findHref("Email");

// Frontmatter runs at build time for static output, so this is the moment the
// deployed site was produced — which is what "last updated" means to a reader.
// Rendered into a <time datetime> so it's machine-readable and so the script
// below has the source instant without a second copy of it in the markup.
const lastUpdated = new Date().toISOString();
---

<footer class="site-footer">
	<div class="site-footer-inner">
		<div class="site-footer-content">
		<p class="footer-reach">
			Reach me on <a
				class="footer-link"
				href={xHref}
				target="_blank"
				rel="noopener noreferrer">X</a
			> or <a class="footer-link" href={emailHref}>email</a>
		</p>
		{/* The elapsed text is replaced by the script. The fallback is worded to
		    still read as a sentence without JS — "moments ago" — since a live
		    counter can't mean anything there anyway. */}
		<p class="footer-updated">
			Last updated <time class="footer-elapsed" datetime={lastUpdated}>moments</time> ago
		</p>
		</div>
	</div>
</footer>

<script>
	/**
	 * Counts up from the build time, ticking once a second — the "ago" is live
	 * rather than a date, so the page reads as maintained rather than stamped.
	 */
	const el = document.querySelector<HTMLTimeElement>(".footer-elapsed");

	if (el?.dateTime) {
		const since = new Date(el.dateTime).getTime();

		const format = (ms: number) => {
			const total = Math.max(0, Math.floor(ms / 1000));
			const units: [string, number][] = [
				["d", Math.floor(total / 86400)],
				["h", Math.floor(total / 3600) % 24],
				["m", Math.floor(total / 60) % 60],
				["s", total % 60],
			];
			// Zero units drop out wherever they fall — "2d 52m 49s" rather than
			// "2d 0h 52m 49s" — but seconds always stay so the line visibly moves.
			return units
				.filter(([unit, value]) => value > 0 || unit === "s")
				.map(([unit, value]) => `${value}${unit}`)
				.join(" ");
		};

		let timer = 0;

		const tick = () => {
			el.textContent = format(Date.now() - since);
		};

		// A backgrounded tab can't show the counter, so don't keep waking to
		// update it; re-render once on return so it never shows a stale value.
		const start = () => {
			tick();
			timer ||= window.setInterval(tick, 1000);
		};

		const stop = () => {
			window.clearInterval(timer);
			timer = 0;
		};

		document.addEventListener("visibilitychange", () =>
			document.hidden ? stop() : start(),
		);

		start();
	}
</script>

<style>
	.site-footer {
		padding-block: 0 106px;
		background-color: var(--color-bg-reveal);
	}

	/* Mirrors PageGrid's .site-main, and .site-footer-content below mirrors
	   .site-intro's column span, so the footer's left edge lands on the intro
	   copy's rather than on the wider thumbnail rail. Duplicated rather than
	   reusing PageGrid because that component renders a <main>, and a second one
	   on the page would be invalid. */
	.site-footer-inner {
		width: 100%;
		max-width: 564px;
		margin-inline: auto;
		padding: 0 49px;
	}

	.footer-reach {
		color: var(--color-text-on-reveal);
	}

	.footer-updated {
		margin-top: 6px;
		color: var(--color-text-on-reveal-dim);
	}

	/* The page's .link is built for dark text on white; on this surface it needs
	   the light equivalents, but keeps the same dotted rule and accent hover. */
	.footer-link {
		color: inherit;
		text-decoration: none;
		border-bottom: 1px dotted var(--color-link-line-on-reveal);
		padding: 1px 0;
	}

	.footer-link:hover,
	.footer-link:focus-visible {
		color: #fff;
		border-color: #fff;
	}

	.footer-link:focus-visible {
		outline: 1px solid #fff;
		outline-offset: 1px;
		border-radius: 3px;
	}

	/* The counter changes width every second; tabular figures stop the words
	   after it jittering as the digits change. */
	.footer-elapsed {
		font-variant-numeric: tabular-nums;
	}

	@media (width >= 768px) {
		.site-footer {
			padding-block: 0 122px;
		}

		.site-footer-inner {
			padding: 0 32px;
		}
	}

	@media (width >= 1024px) {
		.site-footer-inner {
			display: grid;
			grid-template-columns: repeat(16, 71px);
			gap: 0 var(--grid-gutter);
			justify-content: center;
			max-width: none;
			padding: 0;
		}

		/* Same span as .site-intro in SiteIntro.astro. */
		.site-footer-content {
			grid-column: 6 / 12;
		}
	}
</style>
