---
const isHome = Astro.url.pathname === "/";
---

<nav class="site-nav">
	<div class="wrap">
		<div class="nav-grid grid nav-aligned-grid">
			<a href="/" class="nav-name">Maxim Slobodchikov</a>
			<p class="nav-role">Design Engineer</p>
			<p class="nav-location">New York, NY</p>
			{
				!isHome && (
					<a href="/" class="nav-close" aria-label="Close">
						<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
							<path
								fill-rule="evenodd"
								d="M5.47 5.47a.75.75 0 0 1 1.06 0L12 10.94l5.47-5.47a.75.75 0 1 1 1.06 1.06L13.06 12l5.47 5.47a.75.75 0 1 1-1.06 1.06L12 13.06l-5.47 5.47a.75.75 0 0 1-1.06-1.06L10.94 12 5.47 6.53a.75.75 0 0 1 0-1.06Z"
								clip-rule="evenodd"
							/>
						</svg>
					</a>
				)
			}
		</div>
	</div>
</nav>

<script>
	document.querySelector<HTMLAnchorElement>(".nav-name")?.addEventListener("click", (e) => {
		if (window.location.pathname !== "/") return;
		e.preventDefault();
		window.scrollTo({ top: 0, behavior: "instant" });
	});
</script>

<style>
	.site-nav {
		position: sticky;
		top: 0;
		z-index: 100;
		background: var(--bg);
		/* No bottom padding: the sticky bar ends exactly at the underline, so
		   content scrolls up to the line with no background overhang below it. */
		padding: 1rem 0 0;
	}

	.nav-grid {
		position: relative;
		align-items: baseline;
		border-bottom: 1px solid var(--rule);
		padding-bottom: 1rem;
	}

	.nav-close {
		position: absolute;
		top: 0;
		bottom: 1rem;
		right: 0;
		display: flex;
		align-items: center;
		color: var(--fg);
		transition: color 0.2s ease;
	}

	.nav-close:hover {
		color: var(--accent);
	}

	.nav-close svg {
		width: 24px;
		height: 24px;
	}

	.nav-name {
		grid-column: 1 / 7;
		font-weight: 400;
	}

	.nav-name:hover {
		color: var(--accent);
	}

	.nav-role {
		grid-column: 7 / 13;
		text-align: left;
		font-weight: 400;
		color: var(--fg);
	}

	.nav-location {
		grid-column: 9 / 13;
		display: none;
		text-align: left;
		font-weight: 400;
		color: var(--fg);
	}

	/*
	 * Same breakpoint the hero's Teams/Links pair uses to go side-by-side
	 * (global.css / index.astro). "New York, NY" shares Teams/Links' column
	 * lines (7/9, 9/13), so it lands in that spot once it appears.
	 */
	@media (min-width: 630px) {
		.nav-name {
			grid-column: span 6;
		}

		.nav-role {
			grid-column: 7 / 9;
		}
	}

	/*
	 * Same breakpoint global.css bumps body font-size up at. Below it, drop
	 * "New York, NY" to save space (joseph.cv does the same at its font-size
	 * breakpoint) — only room for it once type (and thus everything else) has
	 * grown.
	 */
	@media (min-width: 1020px) {
		.nav-location {
			display: block;
		}
	}
</style>
