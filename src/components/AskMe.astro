---
import { CONTACT_EMAIL, GREETING } from "../chat/system-prompt";

const SUGGESTIONS = [
	"what are you building right now?",
	"what did you do at the times?",
	"how did the election map agents work?",
	"what's your design process like?",
];
---

<section class="ask-me" aria-labelledby="ask-me-label">
	<p class="ask-label" id="ask-me-label">Ask me anything</p>

	<ol class="ask-log" aria-live="polite" data-ask-log>
		{GREETING.map((line) => <li class="ask-msg" data-role="assistant">{line}</li>)}
	</ol>

	<ul class="ask-chips" data-ask-chips>
		{
			SUGGESTIONS.map((suggestion) => (
				<li>
					<button type="button" class="ask-chip" data-ask-chip>
						{suggestion}
					</button>
				</li>
			))
		}
	</ul>

	<form class="ask-form" data-ask-form>
		<label class="visually-hidden" for="ask-input">Your question</label>
		<input
			id="ask-input"
			class="ask-input"
			name="message"
			type="text"
			autocomplete="off"
			maxlength="500"
			placeholder="ask about my work…"
			required
			data-ask-input
		/>
		<button type="submit" class="ask-send" data-ask-send>Send</button>
	</form>

	<p class="ask-note">
		An AI version of me, so it can be wrong. Messages are stored for 90 days. Want the real me? <a class="link" href={`mailto:${CONTACT_EMAIL}`}>Email</a>.
	</p>
</section>

<style>
	.ask-me {
		margin-top: var(--section-gap);
	}

	.ask-label {
		color: var(--color-text-secondary);
		margin-bottom: var(--label-to-content-gap);
	}

	.ask-log {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 12px;
	}

	/* The greeting lines read as one burst, tighter than separate turns. */
	.ask-log :global(.ask-msg[data-role="assistant"] + .ask-msg[data-role="assistant"]) {
		margin-top: -8px;
	}

	.ask-log {
		margin-bottom: 20px;
	}

	.ask-log :global(.ask-msg) {
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.ask-log :global(.ask-msg[data-role="user"]) {
		color: var(--color-text-secondary);
	}

	.ask-log :global(.ask-msg[data-role="error"]) {
		color: var(--color-accent);
	}

	/* Instant "typing" state before the first token lands. */
	.ask-log :global(.ask-msg[data-pending]::after) {
		content: "…";
		color: var(--color-text-secondary);
		animation: ask-blink 1s steps(2, start) infinite;
	}

	@keyframes ask-blink {
		to {
			visibility: hidden;
		}
	}

	.ask-chips {
		list-style: none;
		margin: 0 0 16px;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}

	.ask-chips[hidden] {
		display: none;
	}

	.ask-chip {
		font: inherit;
		font-size: 15px;
		color: var(--color-text-primary);
		background: none;
		border: 1px dotted var(--color-link-line);
		border-radius: 999px;
		padding: 4px 12px;
		cursor: pointer;
	}

	.ask-chip:hover,
	.ask-chip:focus-visible {
		color: var(--color-accent);
		border-color: var(--color-accent);
		background-color: var(--color-link-hover-bg);
		outline: none;
	}

	.ask-form {
		display: flex;
		gap: 12px;
		align-items: baseline;
		border-bottom: 1px dotted var(--color-link-line);
		padding-bottom: 4px;
	}

	.ask-form:focus-within {
		border-color: var(--color-accent);
	}

	.ask-input {
		flex: 1;
		min-width: 0;
		font: inherit;
		color: var(--color-text-primary);
		background: none;
		border: 0;
		padding: 0;
		outline: none;
	}

	.ask-input::placeholder {
		color: var(--color-text-secondary);
	}

	.ask-send {
		font: inherit;
		color: var(--color-accent);
		background: none;
		border: 0;
		padding: 0;
		cursor: pointer;
	}

	.ask-send:disabled,
	.ask-input:disabled {
		opacity: 0.4;
		cursor: default;
	}

	.ask-note {
		margin-top: 12px;
		font-size: 14px;
		color: var(--color-text-secondary);
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>

<script>
	const SESSION_KEY = "ask-me-session";

	function getSessionId(): string {
		try {
			const existing = sessionStorage.getItem(SESSION_KEY);
			if (existing) return existing;
			const id = crypto.randomUUID();
			sessionStorage.setItem(SESSION_KEY, id);
			return id;
		} catch {
			// Storage blocked: a per-page-load session still works.
			return (window as unknown as { __askSession?: string }).__askSession ??= crypto.randomUUID();
		}
	}

	const log = document.querySelector<HTMLOListElement>("[data-ask-log]")!;
	const chips = document.querySelector<HTMLUListElement>("[data-ask-chips]")!;
	const form = document.querySelector<HTMLFormElement>("[data-ask-form]")!;
	const input = document.querySelector<HTMLInputElement>("[data-ask-input]")!;
	const send = document.querySelector<HTMLButtonElement>("[data-ask-send]")!;

	function addMessage(role: "user" | "assistant" | "error", text = ""): HTMLLIElement {
		const item = document.createElement("li");
		item.className = "ask-msg";
		item.dataset.role = role;
		item.textContent = text;
		log.append(item);
		return item;
	}

	function setBusy(busy: boolean) {
		input.disabled = busy;
		send.disabled = busy;
	}

	async function ask(message: string) {
		const text = message.trim();
		if (!text) return;

		chips.hidden = true;
		addMessage("user", text);
		const reply = addMessage("assistant");
		reply.dataset.pending = "";
		setBusy(true);

		(window as unknown as { plausible?: (event: string) => void }).plausible?.("chat_message");

		try {
			const res = await fetch("/api/chat", {
				method: "POST",
				headers: { "content-type": "application/json" },
				body: JSON.stringify({ sessionId: getSessionId(), message: text }),
			});

			if (!res.ok || !res.body) {
				reply.dataset.role = "error";
				reply.textContent = (await res.text()) || "Something went wrong. Try again in a bit.";
				return;
			}

			const reader = res.body.getReader();
			const decoder = new TextDecoder();
			for (;;) {
				const { done, value } = await reader.read();
				if (done) break;
				delete reply.dataset.pending;
				reply.textContent += decoder.decode(value, { stream: true });
			}
			reply.textContent += decoder.decode();
		} catch {
			reply.dataset.role = "error";
			reply.textContent = "Couldn't reach the server. Check your connection and try again.";
		} finally {
			delete reply.dataset.pending;
			setBusy(false);
			input.focus();
		}
	}

	form.addEventListener("submit", (event) => {
		event.preventDefault();
		const value = input.value;
		input.value = "";
		void ask(value);
	});

	chips.addEventListener("click", (event) => {
		const chip = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-ask-chip]");
		if (chip) void ask(chip.textContent ?? "");
	});
</script>
