---
import { GREETING } from "../chat/system-prompt";

// Questions the profile can actually answer, so the first tap lands well.
const SUGGESTIONS = [
	"what did you do at the times?",
	"why journalism?",
	"what's the tech stack here?",
	"tell me a fun fact",
];

// iMessage bubble tail, from beerwar.app's montage caption. Drawn for the
// "sent" (right) side; the "received" side mirrors it in CSS.
const TAIL_PATH = "M25.924 16.6489C24.6144 20 3.5 7 0 0H25.924C16.5 10.5 27.2336 13.2978 25.924 16.6489Z";
---

<section class="ask-me" aria-labelledby="ask-me-label">
	<!-- Clicking the label focuses the input, so the hover nudge points somewhere real. -->
	<label class="ask-label" id="ask-me-label" for="ask-input">
		Chat
		<svg class="ask-label-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="m9 18 6-6-6-6" />
		</svg>
	</label>

	<!-- .ask-msg carries the scroll-settle offset; .ask-body inside it carries
	     the send/reply animations, so the two transforms never fight. -->
	<div class="ask-thread">
		<ol class="ask-log" aria-live="polite" data-ask-log>
			{
				GREETING.map((line, index) => (
					<li
						class="ask-msg"
						data-role={line.role}
						data-intro={index > GREETING.findLastIndex((m) => m.role === "user") ? "" : undefined}
					>
						<div class="ask-body">
							<div class="ask-bubble">
								<span class="ask-text">{line.text}</span>
							</div>
							<svg class="ask-tail" viewBox="0 0 27 18" preserveAspectRatio="none" aria-hidden="true">
								<path d={TAIL_PATH} />
							</svg>
						</div>
					</li>
				))
			}
		</ol>

		<!-- Suggestions float over the bottom of the thread and slide down out of
		     this clipped strip, so they tuck under the compose field. -->
		<div class="ask-strip">
			<ul class="ask-chips" data-ask-chips>
				{
					SUGGESTIONS.map((suggestion) => (
						<li>
							<button type="button" class="ask-chip" data-ask-chip>
								{suggestion}
							</button>
						</li>
					))
				}
			</ul>
		</div>

		<!-- Frosted compose field floating over the bottom of the thread, so
		     messages scroll under the glass (after alexsafayan.com). -->
		<form class="ask-form" data-ask-form>
			<label class="visually-hidden" for="ask-input">Your question</label>
			<input
				id="ask-input"
				class="ask-input"
				name="message"
				type="text"
				autocomplete="off"
				maxlength="500"
				placeholder="Message"
				data-ask-input
			/>
			<button type="submit" class="ask-send" aria-label="Send" data-ask-send>
				<svg viewBox="0 0 20 24" aria-hidden="true">
					<path d="M10 22V2M2 10l8-8 8 8" />
				</svg>
			</button>
		</form>
	</div>

	<template data-ask-template>
		<li class="ask-msg">
			<div class="ask-body">
				<div class="ask-bubble">
					<span class="ask-text"></span>
				</div>
				<svg class="ask-tail" viewBox="0 0 27 18" preserveAspectRatio="none" aria-hidden="true">
					<path d={TAIL_PATH} />
				</svg>
			</div>
		</li>
	</template>


</section>

<style>
	.ask-me {
		margin-top: var(--section-gap);
		--imsg-blue: #0092ff;
		--imsg-gray: #e9e9eb;
	}

	.ask-label {
		display: flex;
		align-items: center;
		gap: 2px;
		width: fit-content;
		color: var(--color-text-secondary);
		/* Teams/Links get the same gap, but their first entry is text, whose ink
		   starts ~6px into its line box (half-leading plus the room above cap
		   height). A bubble's edge is solid from its first pixel, so it gets
		   that 6px as margin to sit the same visual distance below its label. */
		margin-bottom: calc(var(--label-to-content-gap) + 6px);
		cursor: pointer;
	}

	.ask-label-arrow {
		width: 1.1em;
		height: 1.1em;
		/* Sits low against the label's x-height rather than its full line box. */
		position: relative;
		top: 0.1em;
		transition: transform 200ms ease;
	}

	.ask-label:hover .ask-label-arrow {
		transform: translateX(0.2em);
	}

	@media (prefers-reduced-motion: reduce) {
		.ask-label-arrow {
			transition: none;
		}
	}

	/* Edge fades for the two scrollers (after alexsafayan.com's chat): content
	   dissolves into the page where there's more of it to scroll to, and the
	   edge is hard where there isn't. The script sets data-fade-start/-end from
	   the scroll position; registered so the fades ease in instead of popping. */
	@property --fade-start {
		syntax: "<length>";
		inherits: false;
		initial-value: 0px;
	}

	@property --fade-end {
		syntax: "<length>";
		inherits: false;
		initial-value: 0px;
	}

	.ask-chips {
		mask-image: linear-gradient(
			var(--fade-dir),
			transparent,
			#000 var(--fade-start),
			#000 calc(100% - var(--fade-end)),
			transparent
		);
		transition:
			--fade-start 160ms ease,
			--fade-end 160ms ease;
	}

	.ask-thread {
		position: relative;
		--form-height: 40px;
		--form-gap: 8px;
	}

	/* Chat history scrolls inside a fixed-height window, like a phone thread,
	   instead of pushing the page down with every message. */
	.ask-log {
		position: relative;
		list-style: none;
		max-height: 400px;
		overflow-y: auto;
		/* Bubbles fly in from the input or a chip and can poke past the side
		   mid-flight; without this a sideways scrollbar flashes and takes
		   height from the thread. */
		overflow-x: hidden;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: #c7c7cc transparent;
		/* Room for the last bubble's tail, which hangs 9.5px below it and
		   would otherwise be clipped by the scroller. */
		margin: 0;
		/* The last bubble's tail (hangs 9.5px), then room for the compose field
		   floating over the bottom of the scroller. */
		padding: 0 0 calc(10px + var(--form-height) + var(--form-gap));
		display: flex;
		flex-direction: column;
	}

	/* Room under the newest message for the suggestions floating over it.
	   Dropped once they're gone for good. */
	.ask-log::after {
		content: "";
		flex: none;
		height: 46px;
	}

	.ask-log[data-chips-off]::after {
		display: none;
	}

	/* A fixed fade along the thread's top edge, there whether or not it's
	   scrolled. Like alexsafayan.com's, it's a page-coloured overlay rather
	   than a mask, so it can stop short of the scrollbar and leave it crisp. */
	.ask-thread {
		--top-fade: 24px;
		/* Starts the fade a little under the label; the first bubble sits
		   just below the fade, about where it always has. */
		margin-top: -6px;
	}

	.ask-thread::before {
		content: "";
		position: absolute;
		z-index: 1;
		top: 0;
		left: 0;
		/* Stops at the scrollbar, measured by the script (0 where scrollbars
		   overlay the content, like macOS by default). */
		right: var(--scrollbar-width, 0px);
		height: var(--top-fade);
		background: linear-gradient(var(--color-bg-page), transparent);
		pointer-events: none;
	}

	.ask-log {
		padding-top: var(--top-fade);
	}

	/* No bottom fade on the thread: messages run on under the frosted compose
	   field, and the blur there already says there's more below. */

	/* iMessage spacing: consecutive messages from one side sit tight, a change
	   of speaker gets a real gap. */
	/* My opening lines after the visitor's "Hi there" stay hidden from the
	   first paint until the script either types them in (the intro) or, with
	   reduced motion, shows them as they are. Otherwise they flash for a
	   frame before the intro takes them out. */
	.ask-log:not([data-intro-ready]) .ask-msg[data-intro] {
		display: none;
	}

	.ask-log :global(.ask-msg) {
		width: fit-content;
		max-width: 80%;
		margin-top: 12px;
	}

	.ask-log :global(.ask-body) {
		position: relative;
		/* contains the tail's negative z-index instead of letting it escape */
		isolation: isolate;
	}

	.ask-log :global(.ask-msg:first-child) {
		margin-top: 0;
	}

	.ask-log :global(.ask-msg[data-role="user"] + .ask-msg[data-role="user"]),
	.ask-log :global(.ask-msg:not([data-role="user"]) + .ask-msg:not([data-role="user"])) {
		margin-top: 3px;
	}

	.ask-log :global(.ask-msg[data-role="user"]) {
		align-self: flex-end;
		--bubble-bg: var(--imsg-blue);
		--bubble-fg: #fff;
	}

	.ask-log :global(.ask-msg:not([data-role="user"])) {
		align-self: flex-start;
		--bubble-bg: var(--imsg-gray);
		--bubble-fg: #000;
	}

	.ask-log :global(.ask-msg[data-role="error"]) {
		--bubble-fg: var(--color-accent);
	}

	.ask-log :global(.ask-bubble) {
		padding: 8px 16px;
		background: var(--bubble-bg);
		color: var(--bubble-fg);
		font-size: 15px;
		font-weight: 500;
		line-height: 1.35;
		text-align: left;
		border-radius: 20px;
		overflow: hidden;
		overflow-wrap: break-word;
	}

	/* pre-wrap on the text only: on the bubble it would also render the markup's
	   own indentation around the span as visible space. */
	.ask-log :global(.ask-text) {
		white-space: pre-wrap;
	}

	/* The tail hangs below the bubble, tucked 8px in from its edge. It sits
	   behind the body (z-index -1) in the same fill, so its flat top disappears
	   under the bubble and the two read as one shape.
	   preserveAspectRatio="none" on the svg is load-bearing: the default scales
	   the 27x18 viewBox uniformly into this 15x13 box, leaving a notch. */
	.ask-log :global(.ask-tail) {
		position: absolute;
		right: 8px;
		bottom: -9.5px;
		z-index: -1;
		width: 15px;
		height: 13px;
		fill: var(--bubble-bg);
		pointer-events: none;
	}

	.ask-log :global(.ask-msg:not([data-role="user"]) .ask-tail) {
		right: auto;
		left: 8px;
		transform: scaleX(-1);
	}

	/* Like iMessage, only the last bubble in a run from one side gets a tail. */
	.ask-log :global(.ask-msg[data-role="user"]:has(+ .ask-msg[data-role="user"]) .ask-tail),
	.ask-log :global(.ask-msg:not([data-role="user"]):has(+ .ask-msg:not([data-role="user"])) .ask-tail) {
		display: none;
	}

	/* Typing state: a gray bubble of three breathing dots, with two small
	   "thought" circles at its corner in place of the tail. */
	.ask-log :global(.ask-msg[data-pending] .ask-tail) {
		display: none;
	}

	.ask-log :global(.ask-dots) {
		display: flex;
		align-items: center;
		gap: 4px;
		height: 20.25px;
	}

	.ask-log :global(.ask-dots i) {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #8e8e93;
		animation: ask-dot 0.75s ease-in-out infinite;
	}

	.ask-log :global(.ask-dots i:nth-child(2)) {
		animation-delay: 0.25s;
	}

	.ask-log :global(.ask-dots i:nth-child(3)) {
		animation-delay: 0.5s;
	}

	@keyframes ask-dot {
		0%,
		100% {
			opacity: 0.4;
		}
		50% {
			opacity: 0.8;
		}
	}

	.ask-log :global(.ask-think) {
		position: absolute;
		z-index: -1;
		border-radius: 50%;
		background: var(--bubble-bg);
		animation: ask-think 1.2s ease-in-out infinite;
	}

	.ask-log :global(.ask-think:first-of-type) {
		/* The reference hangs these a few px further out; the scroller here
		   clips at the bubble's left edge, so they sit just inside it. */
		width: 12px;
		height: 12px;
		left: 3px;
		bottom: -3px;
		animation-delay: 0.1s;
	}

	.ask-log :global(.ask-think:last-of-type) {
		width: 6px;
		height: 6px;
		left: 0px;
		bottom: -8px;
		animation-delay: 0.2s;
	}

	@keyframes ask-think {
		0%,
		100% {
			transform: scale(0.9);
		}
		50% {
			transform: scale(1);
		}
	}

	/* The strip spans the bottom of the thread down to the compose field and
	   clips the chips as they slide out of it. Only the chips take clicks. */
	.ask-strip {
		position: absolute;
		z-index: 1;
		left: 0;
		right: 0;
		bottom: 0;
		padding-bottom: calc(var(--form-height) + var(--form-gap));
		overflow: hidden;
		pointer-events: none;
	}

	/* Suggestions: dashed blue pills in one row that scrolls sideways
	   instead of wrapping. */
	.ask-chips {
		list-style: none;
		margin: 0;
		padding: 2px 0;
		display: flex;
		align-items: center;
		gap: 8px;
		overflow-x: auto;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
		pointer-events: auto;
	}

	.ask-chips[inert] {
		pointer-events: none;
	}

	.ask-chips::-webkit-scrollbar {
		display: none;
	}

	.ask-chips {
		--fade-dir: to right;
	}

	.ask-chips[data-fade-start] {
		--fade-start: 24px;
	}

	.ask-chips[data-fade-end] {
		--fade-end: 40px;
	}

	.ask-chips li {
		flex-shrink: 0;
	}

	.ask-chip {
		font: inherit;
		font-size: 15px;
		line-height: 1.35;
		white-space: nowrap;
		color: var(--imsg-blue);
		background: #fff;
		border: 2px dashed rgba(0, 146, 255, 0.55);
		border-radius: 999px;
		padding: 6px 14px;
		cursor: pointer;
	}

	.ask-chip:hover {
		background: rgba(0, 146, 255, 0.08);
	}

	.ask-chip:focus-visible {
		outline: 2px solid var(--imsg-blue);
		outline-offset: 2px;
	}

	/* Compose field as frosted glass, from alexsafayan.com: a faint white
	   tint over a blurred, saturated view of the thread behind it. */
	.ask-form {
		position: absolute;
		z-index: 2;
		/* Wider than the thread, so its rounded ends fully cover the edges of
		   bubbles scrolling under it (the reference insets its messages 16px
		   from the input the same way). */
		left: -14px;
		right: -14px;
		bottom: 0;
		height: var(--form-height);
		box-sizing: border-box;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 4px 4px 4px 16px;
		background: rgba(255, 255, 255, 0.3);
		-webkit-backdrop-filter: blur(8px) saturate(300%);
		backdrop-filter: blur(8px) saturate(300%);
		border-radius: 20px;
		box-shadow:
			0 0 32px rgba(0, 0, 0, 0.12),
			inset 0 0 3px 1px #fff;
	}

	.ask-input {
		flex: 1;
		min-width: 0;
		font: inherit;
		/* 16px minimum: anything smaller makes iOS Safari zoom the page on focus. */
		font-size: 16px;
		font-weight: 500;
		/* Same height as the send button, so the pill hugs it. */
		height: 32px;
		line-height: 32px;
		color: #000;
		caret-color: var(--imsg-blue);
		background: none;
		border: 0;
		padding: 0;
		outline: none;
	}

	.ask-input::placeholder {
		color: #8e8e93;
	}

	/* Always live, never dimmed: with nothing typed it sends a hello. */
	.ask-send {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 40px;
		height: 32px;
		padding: 0;
		background: var(--imsg-blue);
		border: 0;
		border-radius: 16px;
		cursor: pointer;
		transition: transform 200ms ease-out;
	}

	.ask-send:active {
		transform: scale(0.9);
	}

	.ask-send svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: #fff;
		stroke-width: 4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.ask-send:focus-visible {
		outline: 2px solid var(--imsg-blue);
		outline-offset: 2px;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>

<script>
	import { createSpring, prefersReducedMotion, springEasing } from "../scripts/spring";

	// Motion values from alexsafayan.com's chat (Framer Motion springs).
	const MAIN = springEasing({ duration: 1, bounce: 0.2 });
	const QUICK = springEasing({ duration: 0.3, bounce: 0 });
	// Sent bubbles land without overshooting: past their spot they'd poke out
	// of the thread's right edge and get clipped.
	const FLIGHT = springEasing({ duration: 0.8, bounce: 0 });
	const LAYOUT = springEasing({ stiffness: 300, damping: 30 });
	const PULSE = { duration: 500, easing: "cubic-bezier(0.2, 0, 0.2, 1)" };
	const CHIPS_OFFSET = 104;
	// A beat after the page loads before the intro may start, so its first
	// typing dots are seen rather than lost in the load.
	const INTRO_LEAD_MS = 400;
	const HELLOS = ["hi", "sup", "yo"];

	const SESSION_KEY = "ask-me-session";

	function getSessionId(): string {
		try {
			const existing = sessionStorage.getItem(SESSION_KEY);
			if (existing) return existing;
			const id = crypto.randomUUID();
			sessionStorage.setItem(SESSION_KEY, id);
			return id;
		} catch {
			// Storage blocked: a per-page-load session still works.
			return ((window as unknown as { __askSession?: string }).__askSession ??= crypto.randomUUID());
		}
	}

	const log = document.querySelector<HTMLOListElement>("[data-ask-log]")!;
	const template = document.querySelector<HTMLTemplateElement>("[data-ask-template]")!;
	const chips = document.querySelector<HTMLUListElement>("[data-ask-chips]")!;
	const form = document.querySelector<HTMLFormElement>("[data-ask-form]")!;
	const input = document.querySelector<HTMLInputElement>("[data-ask-input]")!;

	/**
	 * Shrink a bubble to its widest rendered line (from beerwar.app's fitBubble).
	 * A box whose text wraps keeps the full constraining width in CSS, so a
	 * two-line message would otherwise leave a band of empty bubble beside it.
	 */
	function fitBubble(msg: HTMLElement) {
		const text = msg.querySelector<HTMLElement>(".ask-text");
		const body = msg.querySelector<HTMLElement>(".ask-bubble");
		if (!text || !body) return;
		msg.style.width = "";
		const range = document.createRange();
		range.selectNodeContents(text);
		let widest = 0;
		for (const rect of range.getClientRects()) widest = Math.max(widest, rect.width);
		if (widest === 0) return;
		// Measured on screen, so a bubble mid-animation (the typing bubble
		// still scaling in when its line arrives) reads small. Undo that scale,
		// or the bubble is fitted too narrow and the text wraps ("hell / o!").
		const scale = body.getBoundingClientRect().width / body.offsetWidth;
		if (scale > 0 && Number.isFinite(scale)) widest /= scale;
		const cs = getComputedStyle(body);
		const pad = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
		// +1 so sub-pixel rounding can't make the widest line re-wrap.
		msg.style.width = `${Math.ceil(widest + pad) + 1}px`;
	}

	/**
	 * Keep data-fade-start/-end on a scroller in step with whether there's more
	 * content before or after what's showing (the CSS turns them into fades).
	 */
	function trackEdges(el: HTMLElement, axis: "x" | "y") {
		const update = () => {
			const pos = axis === "y" ? el.scrollTop : el.scrollLeft;
			const span = axis === "y" ? el.scrollHeight - el.clientHeight : el.scrollWidth - el.clientWidth;
			el.toggleAttribute("data-fade-start", pos > 1);
			el.toggleAttribute("data-fade-end", pos < span - 1);
		};
		el.addEventListener("scroll", update, { passive: true });
		new ResizeObserver(update).observe(el);
		update();
		return update;
	}

	trackEdges(chips, "x");
	const updateLogEdges = trackEdges(log, "y");

	// How wide the thread's scrollbar is, so the top fade can stop short of it.
	new ResizeObserver(() => {
		log.parentElement!.style.setProperty("--scrollbar-width", `${log.offsetWidth - log.clientWidth}px`);
	}).observe(log);

	const isAtBottom = () => log.scrollTop >= log.scrollHeight - log.clientHeight - 4;

	/* ---------- Scroll settle ----------
	   While the thread scrolls, each bubble lags behind by an amount that grows
	   with scroll speed and with how far along it sits in the scroll direction,
	   so the thread stretches, then springs back together as it slows. */

	const scrollSpeed = createSpring({ stiffness: 2000, damping: 200, mass: 1 });
	let lastScrollTop = log.scrollTop;
	let lastFrame = 0;
	let settleFrame = 0;

	function settleOffset(msg: HTMLElement, v: number) {
		const rel = (msg.offsetTop - log.scrollTop) / log.clientHeight;
		const d = Math.max(0, Math.sign(v) * (rel - 0.5) * 2) ** 2;
		return 50 * Math.tanh((v * (0.03 + d * 0.07)) / 100);
	}

	function settleStep(now: number) {
		const dt = Math.min((now - lastFrame) / 1000, 0.05) || 1 / 60;
		lastFrame = now;
		const top = log.scrollTop;
		scrollSpeed.target = (top - lastScrollTop) / dt;
		lastScrollTop = top;
		scrollSpeed.step(dt);

		const v = scrollSpeed.value;
		// Under 5px/s the offsets are a twentieth of a pixel: call it still.
		const resting = scrollSpeed.target === 0 && Math.abs(v) < 5 && Math.abs(scrollSpeed.velocity) < 50;
		for (const msg of log.querySelectorAll<HTMLElement>(".ask-msg")) {
			msg.style.transform = resting ? "" : `translateY(${settleOffset(msg, v).toFixed(2)}px)`;
		}
		if (resting) {
			scrollSpeed.value = 0;
			scrollSpeed.velocity = 0;
			settleFrame = 0;
			return;
		}
		settleFrame = requestAnimationFrame(settleStep);
	}

	function startSettle() {
		if (settleFrame || prefersReducedMotion()) return;
		lastFrame = performance.now();
		settleFrame = requestAnimationFrame(settleStep);
	}

	log.addEventListener("scroll", startSettle, { passive: true });

	/* ---------- Following the conversation ----------
	   New bubbles and replies glide the thread to the bottom on a soft spring
	   (use-stick-to-bottom's constants, as the reference uses), unless the
	   visitor has scrolled up to reread something. */

	let pinnedToEnd = true;
	let followFrame = 0;
	let followVelocity = 0;
	// Keep gliding until at least this time, even if already at the bottom:
	// a reply bubble grows for a moment after it lands, and nothing else
	// changes in the DOM to say the thread got taller.
	let followHoldUntil = 0;
	let following = false;

	log.addEventListener(
		"scroll",
		() => {
			if (!following) pinnedToEnd = isAtBottom();
			updateChips();
		},
		{ passive: true },
	);
	// A wheel or touch from the visitor always wins over the glide.
	for (const type of ["wheel", "touchstart"]) {
		log.addEventListener(type, () => stopFollow(), { passive: true });
	}

	function stopFollow() {
		cancelAnimationFrame(followFrame);
		followFrame = 0;
		following = false;
		followVelocity = 0;
	}

	function followToEnd() {
		if (prefersReducedMotion()) {
			log.scrollTop = log.scrollHeight;
			return;
		}
		if (followFrame) return;
		following = true;
		let last = performance.now();
		let expected = log.scrollTop;
		const tick = (now: number) => {
			// Anything that moved the thread besides this glide (scrollbar drag,
			// keyboard, a script) means the visitor wants control back.
			if (Math.abs(log.scrollTop - expected) > 2) {
				stopFollow();
				pinnedToEnd = isAtBottom();
				updateChips();
				return;
			}
			const frames = Math.min((now - last) / (1000 / 60), 3);
			last = now;
			const target = log.scrollHeight - log.clientHeight;
			const diff = target - log.scrollTop;
			followVelocity = ((0.7 * followVelocity + 0.05 * diff) / 1.25) * Math.max(frames, 1);
			if (Math.abs(diff) < 0.5 && Math.abs(followVelocity) < 0.5 && now >= followHoldUntil) {
				log.scrollTop = target;
				stopFollow();
				pinnedToEnd = true;
				updateChips();
				return;
			}
			log.scrollTop += followVelocity;
			expected = log.scrollTop;
			followFrame = requestAnimationFrame(tick);
		};
		followFrame = requestAnimationFrame(tick);
	}

	new MutationObserver(() => {
		if (pinnedToEnd) followToEnd();
		updateLogEdges();
	}).observe(log, { childList: true, subtree: true, characterData: true });

	/* ---------- Intro ----------
	   Like alexsafayan.com: the thread starts with my first line and the
	   visitor's canned "Hi there"; my lines after it are "typed" one by one
	   once the chat is about half on screen. The HTML has every line, so
	   without JS or with reduced motion they're all simply there. */
	const introLines: string[] = [];
	if (!prefersReducedMotion()) {
		const opener = [...log.querySelectorAll<HTMLElement>(".ask-msg")];
		const lastUser = opener.findLastIndex((msg) => msg.dataset.role === "user");
		for (const msg of opener.slice(Math.max(lastUser + 1, 1))) {
			introLines.push(msg.textContent?.trim() ?? "");
			msg.remove();
		}
	}
	log.toggleAttribute("data-intro-ready", true);
	let introRunning = introLines.length > 0;
	let introCancel: (() => void) | null = null;

	const fitAll = () => log.querySelectorAll<HTMLElement>(".ask-msg").forEach(fitBubble);
	fitAll();
	let resizeFrame = 0;
	window.addEventListener("resize", () => {
		cancelAnimationFrame(resizeFrame);
		resizeFrame = requestAnimationFrame(fitAll);
	});

	/* ---------- Suggestions ----------
	   Shown only when there's nothing else going on: thread at the bottom,
	   empty input, no reply on its way, and the assistant spoke last. */

	let busy = false;
	let chipsDisabled = false;
	let typedInARow = 0;
	let chipsShown = true;
	let chipsAnimation: Animation | null = null;

	const remainingChips = () => chips.querySelectorAll("[data-ask-chip]").length;

	function chipsWanted() {
		const last = log.lastElementChild as HTMLElement | null;
		return (
			!chipsDisabled &&
			!busy &&
			!introRunning &&
			input.value === "" &&
			isAtBottom() &&
			last?.dataset.role !== "user" &&
			remainingChips() > 0
		);
	}

	function setChips(show: boolean, how: "slide" | "fade" = "slide") {
		if (show === chipsShown) return;
		chipsShown = show;
		chips.inert = !show;

		// Start from wherever an interrupted slide left them.
		const from = getComputedStyle(chips).transform;
		const fromOpacity = getComputedStyle(chips).opacity;
		chipsAnimation?.cancel();
		const hidden = `translateY(${CHIPS_OFFSET}px)`;
		const end = show ? "none" : hidden;

		if (prefersReducedMotion()) {
			chips.style.transform = end;
			chips.style.opacity = "";
			return;
		}
		if (how === "fade") {
			// Tapped suggestion: the row fades in place, then parks below unseen.
			chipsAnimation = chips.animate([{ opacity: fromOpacity }, { opacity: 0 }], { duration: 200, easing: "ease" });
			chipsAnimation.onfinish = () => {
				chips.style.transform = hidden;
				chipsAnimation = null;
			};
			chips.style.opacity = "0";
			chipsAnimation.addEventListener("finish", () => (chips.style.opacity = ""));
			return;
		}
		chips.style.opacity = "";
		chips.style.transform = end;
		chipsAnimation = chips.animate([{ transform: from === "none" ? "translateY(0)" : from }, { transform: end === "none" ? "translateY(0)" : end }], {
			duration: MAIN.duration,
			easing: MAIN.easing,
		});
	}

	function updateChips() {
		if (!chipsDisabled && remainingChips() === 0) {
			disableChips();
			return;
		}
		setChips(chipsWanted());
	}

	function disableChips() {
		chipsDisabled = true;
		setChips(false);
		log.toggleAttribute("data-chips-off", true);
	}

	input.addEventListener("input", updateChips);

	/* ---------- Messages ---------- */

	function addMessage(role: "user" | "assistant" | "error", text = "") {
		const msg = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
		msg.dataset.role = role;
		const textEl = msg.querySelector<HTMLElement>(".ask-text")!;
		textEl.textContent = text;
		log.append(msg);
		if (text) fitBubble(msg);
		return { msg, textEl };
	}

	const part = (msg: HTMLElement, selector: string) => msg.querySelector<HTMLElement>(selector)!;

	/** Width of `text` in the input's font, for where the typed words sit. */
	function textWidth(text: string) {
		const ctx = document.createElement("canvas").getContext("2d");
		if (!ctx) return 0;
		ctx.font = getComputedStyle(input).font;
		return ctx.measureText(text).width;
	}

	/**
	 * Fly a new bubble in from where its words were (the input or a chip):
	 * the body moves from there to its place in the thread while the bubble's
	 * clip opens from that box to its full shape. Then a small squeeze, and
	 * the tail slides in under it.
	 */
	function animateSend(msg: HTMLElement, from: DOMRect, textInset: number, spring: typeof MAIN) {
		const body = part(msg, ".ask-body");
		const bubble = part(msg, ".ask-bubble");
		const tail = part(msg, ".ask-tail");
		const end = bubble.getBoundingClientRect();
		const pad = parseFloat(getComputedStyle(bubble).paddingLeft);

		// Line the bubble's text up with the source text, centred vertically.
		const dx = from.left + textInset - (end.left + pad);
		const dy = from.top + from.height / 2 - (end.top + end.height / 2);
		const startWidth = Math.min(from.width, end.width);
		const startHeight = Math.min(from.height, end.height);
		const clipTop = (end.height - startHeight) / 2;
		const startRadius = startHeight / 2;
		const startClip = `inset(${clipTop}px ${end.width - startWidth}px ${clipTop}px 0px round ${startRadius}px)`;

		body.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: "translate(0, 0)" }], {
			duration: spring.duration,
			easing: spring.easing,
		});
		bubble.animate([{ clipPath: startClip }, { clipPath: "inset(0px 0px 0px 0px round 20px)" }], {
			duration: spring.duration,
			easing: spring.easing,
		});
		// The squeeze adds on top of the move instead of replacing it.
		body.style.transformOrigin = "100% 100%";
		body.animate([{ transform: "scale(1)" }, { transform: "scale(0.9)" }, { transform: "scale(1)" }], {
			...PULSE,
			composite: "add",
		});
		// `translate`, not `transform`: the tail's own transform is its mirror.
		tail.animate([{ translate: "-20px -13px" }, { translate: "0 0" }], {
			duration: FLIGHT.duration,
			easing: FLIGHT.easing,
		});
	}

	function addTyping() {
		const { msg, textEl } = addMessage("assistant");
		msg.dataset.pending = "";
		textEl.innerHTML = '<span class="ask-dots" aria-label="typing"><i></i><i></i><i></i></span>';
		const body = part(msg, ".ask-body");
		for (let i = 0; i < 2; i++) {
			const dot = document.createElement("span");
			dot.className = "ask-think";
			body.append(dot);
		}
		if (!prefersReducedMotion()) {
			body.style.transformOrigin = "0% 100%";
			body.animate(
				[
					{ transform: "scale(0.5)", opacity: 0 },
					{ transform: "scale(1)", opacity: 1 },
				],
				PULSE,
			);
		}
		return { msg, textEl };
	}

	/**
	 * Turn the typing bubble into the reply: the bubble itself stretches from
	 * the dots' size out to the message's (alexsafayan.com's layout spring),
	 * with the text already in place and uncovered as it grows.
	 */
	function revealReply(msg: HTMLElement, textEl: HTMLElement, text: string, role: "assistant" | "error") {
		const bubble = part(msg, ".ask-bubble");
		// Layout sizes, not on-screen ones: the dots may still be scaling in.
		const from = { width: bubble.offsetWidth, height: bubble.offsetHeight };
		msg.querySelectorAll(".ask-think").forEach((el) => el.remove());
		delete msg.dataset.pending;
		msg.dataset.role = role;
		textEl.textContent = text;
		fitBubble(msg);
		if (prefersReducedMotion()) return;

		const to = { width: bubble.offsetWidth, height: bubble.offsetHeight };
		// Hold the text at its final line breaks while the bubble is still
		// narrower, so it's revealed rather than reflowed as the bubble grows.
		const pad = parseFloat(getComputedStyle(bubble).paddingLeft) + parseFloat(getComputedStyle(bubble).paddingRight);
		textEl.style.display = "block";
		textEl.style.width = `${to.width - pad}px`;
		const grow = bubble.animate(
			[
				{ width: `${from.width}px`, height: `${from.height}px` },
				{ width: `${to.width}px`, height: `${to.height}px` },
			],
			{ duration: LAYOUT.duration, easing: LAYOUT.easing },
		);
		// Follow the bubble down while it grows, so a tall reply (a list) isn't
		// left hanging under the compose field and suggestions.
		followHoldUntil = performance.now() + LAYOUT.duration + 50;
		if (pinnedToEnd) followToEnd();
		grow.onfinish = grow.oncancel = () => {
			textEl.style.display = "";
			textEl.style.width = "";
		};
	}

	function setBusy(next: boolean) {
		busy = next;
		updateChips();
	}

	type Source = { rect: DOMRect; inset: number; spring: typeof MAIN };

	async function ask(message: string, source: Source) {
		const text = message.trim();
		if (!text) return;
		// Sending mid-intro: the rest of the greeting lands at once, first.
		introCancel?.();

		// Sending always brings the thread back to its newest message.
		pinnedToEnd = true;
		const { msg } = addMessage("user", text);
		if (!prefersReducedMotion()) animateSend(msg, source.rect, source.inset, source.spring);
		const { msg: reply, textEl } = addTyping();
		setBusy(true);

		(window as unknown as { plausible?: (event: string) => void }).plausible?.("chat_message");

		// The whole reply is collected behind the typing dots, then shown at once.
		let answer = "";
		let role: "assistant" | "error" = "assistant";
		try {
			const res = await fetch("/api/chat", {
				method: "POST",
				headers: { "content-type": "application/json" },
				body: JSON.stringify({ sessionId: getSessionId(), message: text }),
			});

			if (!res.ok || !res.body) {
				role = "error";
				answer = (await res.text()) || "Something went wrong. Try again in a bit.";
			} else {
				const reader = res.body.getReader();
				const decoder = new TextDecoder();
				for (;;) {
					const { done, value } = await reader.read();
					if (done) break;
					answer += decoder.decode(value, { stream: true });
				}
				answer += decoder.decode();
			}
		} catch {
			role = "error";
			answer = "Couldn't reach the server. Check your connection and try again.";
		}

		// Texts are separated by blank lines; a single line break stays inside
		// one bubble (a list, like the tech stack). The first text opens out of
		// the typing bubble, the rest follow one by one at the intro's pace.
		const texts =
			role === "error"
				? [answer.trim()]
				: answer
						.split(/\n\s*\n/)
						.map((t) => t.split("\n").map((line) => line.trim()).join("\n").trim())
						.filter(Boolean);
		if (!texts.length) {
			role = "error";
			texts.push("Something went wrong. Try again in a bit.");
		}
		revealReply(reply, textEl, texts[0], role);
		for (const text of texts.slice(1)) {
			const next = addTyping();
			await pause(lineDelay(text));
			revealReply(next.msg, next.textEl, text, role);
		}
		setBusy(false);
		input.focus();
		updateChips();
	}

	form.addEventListener("submit", (event) => {
		event.preventDefault();
		// One reply at a time; whatever's typed stays put until it lands.
		if (busy) return;
		// Nothing typed: the button still works, as a quick hello.
		const value = input.value.trim() || HELLOS[Math.floor(Math.random() * HELLOS.length)];
		// Where the typed words sit: the input's left edge, as wide as the text.
		const box = input.getBoundingClientRect();
		const rect = new DOMRect(box.left, box.top, textWidth(value.trim()) + 32, box.height);
		input.value = "";
		typedInARow += 1;
		if (typedInARow >= 2) disableChips();
		void ask(value, { rect, inset: 0, spring: QUICK });
	});

	chips.addEventListener("click", (event) => {
		const chip = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-ask-chip]");
		if (!chip || busy) return;
		const rect = chip.getBoundingClientRect();
		const inset = parseFloat(getComputedStyle(chip).paddingLeft) + parseFloat(getComputedStyle(chip).borderLeftWidth);
		typedInARow = 0;
		setChips(false, "fade");
		// Used suggestions don't come back.
		chip.closest("li")!.remove();
		void ask(chip.textContent ?? "", { rect, inset, spring: FLIGHT });
	});

	/** The reference's pacing per line: half a second, plus more for longer lines. */
	const lineDelay = (line: string) => 500 + 2500 * Math.min(line.length / 200, 1);
	const pause = (ms: number) => new Promise((resolve) => setTimeout(resolve, Math.max(0, ms)));

	/** Typing dots, a pause scaled to the line's length, then the line. */
	async function playIntro() {
		let cancelled = false;
		let typing = addTyping();
		introCancel = () => {
			cancelled = true;
			introCancel = null;
			typing.msg.remove();
			for (const line of introLines.splice(0)) addMessage("assistant", line);
			introRunning = false;
		};
		let last = performance.now();
		while (introLines.length) {
			const line = introLines[0];
			await pause(lineDelay(line) - (performance.now() - last));
			if (cancelled) return;
			introLines.shift();
			revealReply(typing.msg, typing.textEl, line, "assistant");
			last = performance.now();
			if (introLines.length) typing = addTyping();
		}
		introCancel = null;
		introRunning = false;
		updateChips();
	}

	if (introRunning) {
		// Suggestions wait under the compose field until the greeting is done.
		chipsShown = false;
		chips.inert = true;
		chips.style.transform = `translateY(${CHIPS_OFFSET}px)`;
		// Start once the spot where the typing dots will appear is actually on
		// screen: the last opening message fully in view, with ~80px of room
		// under it. Keying off the section as a whole started it while that
		// spot was still below the fold, so "hello!"'s dots were never seen.
		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries[0].isIntersecting) return;
				observer.disconnect();
				void playIntro();
			},
			{ threshold: 1, rootMargin: "0px 0px -80px 0px" },
		);
		// Wait for the page to finish loading and be on screen first: reloading
		// while scrolled to the chat restores that position, and starting at
		// once played the first dots and "hello!" before anything was painted.
		const ready = document.readyState === "complete" ? Promise.resolve() : new Promise((resolve) => addEventListener("load", resolve, { once: true }));
		void ready
			.then(() => pause(INTRO_LEAD_MS))
			.then(() => observer.observe(log.lastElementChild!));
	} else {
		chips.style.transform = "none";
		chips.inert = false;
	}
</script>
