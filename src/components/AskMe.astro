---
import { GREETING } from "../chat/system-prompt";

interface Props {
	// "phone": fills its container (PhoneFrame) instead of a fixed 400px window.
	layout?: "inline" | "phone";
	// "dark": iMessage's dark look, for a black phone screen.
	theme?: "light" | "dark";
}

const { layout = "inline", theme = "light" } = Astro.props;

// Questions the profile can actually answer, so the first tap lands well.
const SUGGESTIONS = [
	"what did you do at the times?",
	"why journalism?",
	"what's the tech stack here?",
	"tell me a fun fact",
];

// iMessage bubble tail, from beerwar.app's montage caption. Drawn for the
// "sent" (right) side; the "received" side mirrors it in CSS.
const TAIL_PATH = "M25.924 16.6489C24.6144 20 3.5 7 0 0H25.924C16.5 10.5 27.2336 13.2978 25.924 16.6489Z";
---

<section class="ask-me" data-layout={layout} data-theme={theme} aria-labelledby="ask-me-label">
	<!-- Clicking the label focuses the input, so the hover nudge points somewhere real. -->
	<label class="ask-label" id="ask-me-label" for="ask-input">
		Chat
		<svg class="ask-label-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="m9 18 6-6-6-6" />
		</svg>
	</label>

	<!-- .ask-msg carries the scroll-settle offset; .ask-body inside it carries
	     the send/reply animations, so the two transforms never fight. -->
	<div class="ask-thread">
		<ol class="ask-log" aria-live="polite" data-ask-log>
			{
				GREETING.map((line, index) => (
					<li
						class="ask-msg"
						data-role={line.role}
						data-intro={index > GREETING.findLastIndex((m) => m.role === "user") ? "" : undefined}
					>
						<div class="ask-body">
							<div class="ask-bubble">
								<span class="ask-text">{line.text}</span>
							</div>
							<svg class="ask-tail" viewBox="0 0 27 18" preserveAspectRatio="none" aria-hidden="true">
								<path d={TAIL_PATH} />
							</svg>
						</div>
					</li>
				))
			}
		</ol>

		<!-- Suggestions float over the bottom of the thread and slide down out of
		     this clipped strip, so they tuck under the compose field. -->
		<div class="ask-strip">
			<ul class="ask-chips" data-ask-chips>
				{
					SUGGESTIONS.map((suggestion) => (
						<li>
							<button type="button" class="ask-chip" data-ask-chip>
								{suggestion}
							</button>
						</li>
					))
				}
			</ul>
		</div>

		<!-- Frosted compose field floating over the bottom of the thread, so
		     messages scroll under the glass (after alexsafayan.com). -->
		<form class="ask-form" data-ask-form>
			<label class="visually-hidden" for="ask-input">Your question</label>
			<input
				id="ask-input"
				class="ask-input"
				name="message"
				type="text"
				autocomplete="off"
				maxlength="500"
				placeholder="Message"
				data-ask-input
			/>
			<button type="submit" class="ask-send" aria-label="Send" data-ask-send>
				<svg viewBox="0 0 20 24" aria-hidden="true">
					<path d="M10 22V2M2 10l8-8 8 8" />
				</svg>
			</button>
		</form>

		<!-- Touch screens in the phone layout: a drawn scroll indicator, kept
		     off the phone's curved corners like the desktop scrollbar. -->
		<div class="ask-scroll-track" aria-hidden="true" data-ask-scroll-track>
			<div class="ask-scroll-thumb" data-ask-scroll-thumb></div>
		</div>
	</div>

	<template data-ask-template>
		<li class="ask-msg">
			<div class="ask-body">
				<div class="ask-bubble">
					<span class="ask-text"></span>
				</div>
				<svg class="ask-tail" viewBox="0 0 27 18" preserveAspectRatio="none" aria-hidden="true">
					<path d={TAIL_PATH} />
				</svg>
			</div>
		</li>
	</template>


</section>

<style>
	.ask-me {
		margin-top: var(--section-gap);
		--imsg-blue: #0092ff;
		--imsg-gray: #e9e9eb;
	}

	/* Phone layout: the chat fills the PhoneFrame top to bottom and the thread
	   takes all the height the label leaves, instead of a 400px window. */
	.ask-me[data-layout="phone"] {
		/* The chat's own scale inside the phone: type, bubbles, field and
		   suggestions 10% up from their base sizes (they read best at what
		   was 110% browser zoom), while the phone frame keeps its size. The
		   chat fills the frame by percentages, which zoom leaves alone. */
		--ask-zoom: 1.1;
		zoom: var(--ask-zoom);
		/* The phone's corner radius comes from the frame, outside the zoom:
		   brought back to this scale so the scrollbar limits stay put. */
		--corner: calc(var(--phone-radius, 0px) / var(--ask-zoom));
		--ask-bg: #f5f5f5;
		margin-top: 0;
		height: 100%;
		display: flex;
		flex-direction: column;
	}

	/* No "Chat" heading in the phone; it still names the section for screen
	   readers through aria-labelledby. */
	.ask-me[data-layout="phone"] .ask-label {
		display: none;
	}

	.ask-me[data-layout="phone"] .ask-thread {
		flex: 1;
		min-height: 0;
	}

	/* The thread fills the phone edge to edge, so its scrollbar lands on the
	   phone's right edge; the 20px screen margin moves inside it as padding. */
	.ask-me[data-layout="phone"] .ask-thread {
		--top-fade: 48px;
		--screen-pad: 20px;
		margin-top: 0;
	}

	.ask-me[data-layout="phone"] .ask-log {
		height: 100%;
		max-height: none;
		/* The scrollbar's width comes out of the right margin, measured by the
		   script: it's 0 until the thread overflows, and 0 always where
		   scrollbars overlay the content. A fixed amount left sent bubbles
		   6px from the edge whenever there was no bar. */
		/* Bottom: room between the newest message and the compose field
		   (--last-gap, past the 9.5px tail), then the field itself. */
		--last-gap: 28px;
		/* The phone is narrow: let a bubble take a bit more of it, so longer
		   lines (and links) fit on one line. */
		--bubble-max: 85%;
		padding: var(--top-fade) calc(var(--screen-pad) - var(--scrollbar-width, 0px))
			calc(var(--last-gap) + var(--form-height) + var(--form-gap) + var(--screen-pad)) var(--screen-pad);
	}

	/* Lined up with the suggestions and bubbles, and inset the same 20px from
	   the sides as from the bottom, so its rounded ends sit concentric with
	   the phone's corners like iOS's own compose field. */
	.ask-me[data-layout="phone"] .ask-form {
		left: var(--screen-pad);
		right: var(--screen-pad);
		bottom: var(--screen-pad);
	}

	/* Ends at the compose field's bottom, so chips sliding away are clipped
	   under the glass rather than showing in the margin below it. */
	.ask-me[data-layout="phone"] .ask-strip {
		left: var(--screen-pad);
		right: var(--screen-pad);
		bottom: var(--screen-pad);
	}

	/* The drawn indicator: off everywhere except touch screens in the phone
	   layout (below). */
	.ask-scroll-track {
		display: none;
	}

	/* Touch screens: mobile browsers draw their own overlay scroll indicator,
	   run it the full height of the thread and ignore the track styling below,
	   so it ran over the curved corners. It's hidden and replaced by a drawn
	   one between the same limits as the desktop scrollbar: from where the
	   top corners stop curving to where the bottom ones start. The thread
	   fills the phone, so the track follows the phone as it shrinks. */
	@media (pointer: coarse) {
		/* .ask-thread in these selectors outranks the desktop scrollbar rules
		   further down, which would otherwise switch the native bar back on. */
		.ask-me[data-layout="phone"] .ask-thread .ask-log {
			scrollbar-width: none;
		}

		.ask-me[data-layout="phone"] .ask-thread .ask-log::-webkit-scrollbar {
			display: none;
			width: 0;
		}

		.ask-me[data-layout="phone"] .ask-scroll-track {
			display: block;
			position: absolute;
			z-index: 3;
			top: var(--corner, 0px);
			bottom: var(--corner, 0px);
			right: 4px;
			width: 3px;
			pointer-events: none;
		}

		.ask-me[data-layout="phone"] .ask-scroll-thumb {
			width: 100%;
			height: var(--thumb-h, 0px);
			transform: translateY(var(--thumb-y, 0px));
			border-radius: 2px;
			background: rgba(0, 0, 0, 0.35);
			opacity: 0;
			transition: opacity 300ms ease;
		}

		/* Shown while the thread moves, faded out a beat after it stops. */
		.ask-me[data-layout="phone"] .ask-scroll-track[data-active] .ask-scroll-thumb {
			opacity: 1;
			transition-duration: 100ms;
		}
	}

	/* Chrome and Safari: a thin scrollbar whose track stops where the phone's
	   corners start to curve. Chrome only honours ::-webkit-scrollbar when the
	   standard scrollbar-width/-color are left at auto. Firefox can't inset the
	   track and keeps its thin full-height bar. */
	@supports selector(::-webkit-scrollbar) {
		.ask-me[data-layout="phone"] .ask-log {
			scrollbar-width: auto;
			scrollbar-color: auto;
		}

		/* A 14px gutter with a 6px thumb in the middle: the transparent
		   border insets the thumb 4px from the phone's edge. */
		.ask-me[data-layout="phone"] .ask-log::-webkit-scrollbar {
			width: 14px;
		}

		.ask-me[data-layout="phone"] .ask-log::-webkit-scrollbar-track {
			background: transparent;
			margin-block: var(--corner, 0px);
		}

		.ask-me[data-layout="phone"] .ask-log::-webkit-scrollbar-thumb {
			background: #c7c7cc;
			background-clip: padding-box;
			border: 4px solid transparent;
			border-radius: 7px;
		}
	}

	/* Dark theme: iMessage in dark mode on a black screen. Sent bubbles stay
	   blue; received ones go dark gray with white text, and the field,
	   suggestions and scroll bars are retuned to read on black. The extra
	   .ask-me.ask-me[data-theme] doubles the class so these outrank the light
	   rules, some of which come later at the same specificity. */
	.ask-me.ask-me[data-theme="dark"] {
		--imsg-gray: #262628;
		--ask-bg: #000;
	}

	.ask-me.ask-me[data-theme="dark"] .ask-log :global(.ask-msg:not([data-role="user"])) {
		--bubble-fg: #fff;
	}

	.ask-me.ask-me[data-theme="dark"] .ask-log :global(.ask-dots i) {
		background: #98989f;
	}

	.ask-me.ask-me[data-theme="dark"] .ask-chip {
		background: #000;
	}

	.ask-me.ask-me[data-theme="dark"] .ask-chip:hover {
		background: rgba(0, 146, 255, 0.16);
	}

	/* Frosted glass, dark (alexsafayan.com's dark variant): the blurred
	   thread behind is dimmed rather than washed white. */
	.ask-me.ask-me[data-theme="dark"] .ask-form {
		background: rgba(255, 255, 255, 0.05);
		-webkit-backdrop-filter: blur(8px) saturate(300%) brightness(0.3);
		backdrop-filter: blur(8px) saturate(300%) brightness(0.3);
		box-shadow:
			0 0 32px rgba(0, 0, 0, 0.12),
			inset 0 0 3px 1px rgba(255, 255, 255, 0.2);
	}

	.ask-me.ask-me[data-theme="dark"] .ask-input {
		color: #fff;
	}

	.ask-me.ask-me[data-theme="dark"] .ask-input::placeholder {
		color: #8d8d93;
	}

	.ask-me.ask-me[data-theme="dark"] .ask-log {
		scrollbar-color: #48484a transparent;
	}

	.ask-me.ask-me[data-theme="dark"] .ask-log::-webkit-scrollbar-thumb {
		background: #48484a;
		background-clip: padding-box;
	}

	.ask-me.ask-me[data-theme="dark"] .ask-scroll-thumb {
		background: rgba(255, 255, 255, 0.4);
	}

	.ask-label {
		display: flex;
		align-items: center;
		gap: 2px;
		width: fit-content;
		color: var(--color-text-secondary);
		/* Teams/Links get the same gap, but their first entry is text, whose ink
		   starts ~6px into its line box (half-leading plus the room above cap
		   height). A bubble's edge is solid from its first pixel, so it gets
		   that 6px as margin to sit the same visual distance below its label. */
		margin-bottom: calc(var(--label-to-content-gap) + 6px);
		cursor: pointer;
	}

	.ask-label-arrow {
		width: 1.1em;
		height: 1.1em;
		/* Sits low against the label's x-height rather than its full line box. */
		position: relative;
		top: 0.1em;
		transition: transform 200ms ease;
	}

	.ask-label:hover .ask-label-arrow {
		transform: translateX(0.2em);
	}

	@media (prefers-reduced-motion: reduce) {
		.ask-label-arrow {
			transition: none;
		}
	}

	/* Edge fades for the two scrollers (after alexsafayan.com's chat): content
	   dissolves into the page where there's more of it to scroll to, and the
	   edge is hard where there isn't. The script sets data-fade-start/-end from
	   the scroll position; registered so the fades ease in instead of popping. */
	@property --fade-start {
		syntax: "<length>";
		inherits: false;
		initial-value: 0px;
	}

	@property --fade-end {
		syntax: "<length>";
		inherits: false;
		initial-value: 0px;
	}

	.ask-chips {
		mask-image: linear-gradient(
			var(--fade-dir),
			transparent,
			#000 var(--fade-start),
			#000 calc(100% - var(--fade-end)),
			transparent
		);
		transition:
			--fade-start 160ms ease,
			--fade-end 160ms ease;
	}

	.ask-thread {
		position: relative;
		--form-height: 40px;
		--form-gap: 8px;
	}

	/* Chat history scrolls inside a fixed-height window, like a phone thread,
	   instead of pushing the page down with every message. */
	.ask-log {
		position: relative;
		list-style: none;
		max-height: 400px;
		overflow-y: auto;
		/* Bubbles fly in from the input or a chip and can poke past the side
		   mid-flight; without this a sideways scrollbar flashes and takes
		   height from the thread. */
		overflow-x: hidden;
		overscroll-behavior: contain;
		scrollbar-width: thin;
		scrollbar-color: #c7c7cc transparent;
		/* Room for the last bubble's tail, which hangs 9.5px below it and
		   would otherwise be clipped by the scroller. */
		margin: 0;
		/* The last bubble's tail (hangs 9.5px), then room for the compose field
		   floating over the bottom of the scroller. */
		padding: 0 0 calc(10px + var(--form-height) + var(--form-gap));
		display: flex;
		flex-direction: column;
	}

	/* Room under the newest message for the suggestions floating over it.
	   Dropped once they're gone for good. */
	.ask-log::after {
		content: "";
		flex: none;
		height: 46px;
	}

	.ask-log[data-chips-off]::after {
		display: none;
	}

	/* A fixed fade along the thread's top edge, there whether or not it's
	   scrolled. Like alexsafayan.com's, it's a page-coloured overlay rather
	   than a mask, so it can stop short of the scrollbar and leave it crisp. */
	.ask-thread {
		--top-fade: 24px;
		/* Starts the fade a little under the label; the first bubble sits
		   just below the fade, about where it always has. */
		margin-top: -6px;
	}

	.ask-thread::before {
		content: "";
		position: absolute;
		z-index: 1;
		top: 0;
		left: 0;
		/* Stops at the scrollbar, measured by the script (0 where scrollbars
		   overlay the content, like macOS by default). */
		right: var(--scrollbar-width, 0px);
		height: var(--top-fade);
		background: linear-gradient(var(--ask-bg, var(--color-bg-page)), transparent);
		pointer-events: none;
	}

	.ask-log {
		padding-top: var(--top-fade);
	}

	/* No bottom fade on the thread: messages run on under the frosted compose
	   field, and the blur there already says there's more below. */

	/* iMessage spacing: consecutive messages from one side sit tight, a change
	   of speaker gets a real gap. */
	/* My opening lines after the visitor's "Hi there" stay hidden from the
	   first paint until the script either types them in (the intro) or, with
	   reduced motion, shows them as they are. Otherwise they flash for a
	   frame before the intro takes them out. */
	.ask-log:not([data-intro-ready]) .ask-msg[data-intro] {
		display: none;
	}

	.ask-log :global(.ask-msg) {
		width: fit-content;
		max-width: var(--bubble-max, 80%);
		margin-top: 12px;
	}

	.ask-log :global(.ask-body) {
		position: relative;
		/* contains the tail's negative z-index instead of letting it escape */
		isolation: isolate;
	}

	.ask-log :global(.ask-msg:first-child) {
		margin-top: 0;
	}

	.ask-log :global(.ask-msg[data-role="user"] + .ask-msg[data-role="user"]),
	.ask-log :global(.ask-msg:not([data-role="user"]) + .ask-msg:not([data-role="user"])) {
		margin-top: 3px;
	}

	.ask-log :global(.ask-msg[data-role="user"]) {
		align-self: flex-end;
		--bubble-bg: var(--imsg-blue);
		--bubble-fg: #fff;
	}

	/* iMessage's shaded blue (after alexsafayan.com): sent bubbles are a
	   deeper blue low in the thread and lighten as they scroll up. Each
	   bubble tracks its own trip through the thread (a view timeline) and
	   fades a lighter blue in over itself; the tail, drawn separately, shifts
	   its fill on the same timeline so the two always match. Browsers without
	   scroll-driven animations keep the flat blue. */
	@supports (animation-timeline: view()) {
		.ask-log :global(.ask-msg[data-role="user"]) {
			--bubble-bg: rgb(0, 140, 255);
		}

		.ask-log :global(.ask-msg[data-role="user"] .ask-body) {
			view-timeline-name: --ask-bubble;
			view-timeline-axis: y;
		}

		.ask-log :global(.ask-msg[data-role="user"] .ask-bubble) {
			position: relative;
			isolation: isolate;
		}

		.ask-log :global(.ask-msg[data-role="user"] .ask-bubble::after) {
			content: "";
			position: absolute;
			inset: 0;
			z-index: -1;
			border-radius: inherit;
			background: rgb(0, 190, 255);
			pointer-events: none;
			animation: ask-bubble-lighten linear both;
			animation-timeline: --ask-bubble;
			animation-range: cover 30%;
		}

		.ask-log :global(.ask-msg[data-role="user"] .ask-tail) {
			animation: ask-tail-lighten linear both;
			animation-timeline: --ask-bubble;
			animation-range: cover 30%;
		}
	}

	@keyframes ask-bubble-lighten {
		from {
			opacity: 0;
		}
		to {
			opacity: 1;
		}
	}

	@keyframes ask-tail-lighten {
		from {
			fill: rgb(0, 140, 255);
		}
		to {
			fill: rgb(0, 190, 255);
		}
	}

	.ask-log :global(.ask-msg:not([data-role="user"])) {
		align-self: flex-start;
		--bubble-bg: var(--imsg-gray);
		--bubble-fg: #000;
	}

	.ask-log :global(.ask-bubble) {
		padding: 8px 16px;
		background: var(--bubble-bg);
		color: var(--bubble-fg);
		font-size: 15px;
		font-weight: 500;
		line-height: 1.35;
		text-align: left;
		border-radius: 20px;
		overflow: hidden;
		overflow-wrap: break-word;
		/* Plain greedy wrapping, not the page's inherited `pretty` (set on the
		   bubble: line breaking belongs to the block, not the inline text). A
		   bubble is fitted to its widest line; `pretty` then re-balances the
		   lines and breaks earlier than that width needs, squeezing the text
		   into more lines ("Hi / ther / e" in Safari 26, which supports it). */
		text-wrap: wrap;
	}

	/* pre-line keeps a reply's line breaks (a list, like the tech stack) on
	   the text only: on the bubble it would also render the markup's own
	   indentation around the span. Not pre-wrap: Safari counts the space left
	   at the end of a wrapped pre-wrap line, so a bubble fitted to its widest
	   line wrapped once more ("this is" / "maxim (in" / "a way)"). */
	.ask-log :global(.ask-text) {
		white-space: pre-line;
	}

	/* Links in replies: the bubble's own colour, underlined, so they read as
	   tappable without a new colour in the thread. */
	/* Links in replies, iMessage style: blue and underlined, no hover change. */
	.ask-log :global(.ask-link) {
		color: var(--imsg-blue);
		text-decoration: underline;
		text-decoration-thickness: 1px;
		text-underline-offset: 2px;
	}

	/* The tail hangs below the bubble, tucked 8px in from its edge. It sits
	   behind the body (z-index -1) in the same fill, so its flat top disappears
	   under the bubble and the two read as one shape.
	   preserveAspectRatio="none" on the svg is load-bearing: the default scales
	   the 27x18 viewBox uniformly into this 15x13 box, leaving a notch. */
	.ask-log :global(.ask-tail) {
		position: absolute;
		right: 8px;
		bottom: -9.5px;
		z-index: -1;
		width: 15px;
		height: 13px;
		fill: var(--bubble-bg);
		pointer-events: none;
	}

	.ask-log :global(.ask-msg:not([data-role="user"]) .ask-tail) {
		right: auto;
		left: 8px;
		transform: scaleX(-1);
	}

	/* Like iMessage, only the last bubble in a run from one side gets a tail.
	   The script marks the others (data-run-continues); a `:has(+ …)` rule did
	   this before, but Safari didn't always re-check it when a bubble was
	   added, leaving a tail on every line of a run. */
	.ask-log :global(.ask-msg[data-run-continues] .ask-tail) {
		display: none;
	}

	/* Typing state: a gray bubble of three breathing dots, with two small
	   "thought" circles at its corner in place of the tail. */
	.ask-log :global(.ask-msg[data-pending] .ask-tail) {
		display: none;
	}

	.ask-log :global(.ask-dots) {
		display: flex;
		align-items: center;
		gap: 4px;
		height: 20.25px;
	}

	.ask-log :global(.ask-dots i) {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: #8e8e93;
		animation: ask-dot 0.75s ease-in-out infinite;
	}

	.ask-log :global(.ask-dots i:nth-child(2)) {
		animation-delay: 0.25s;
	}

	.ask-log :global(.ask-dots i:nth-child(3)) {
		animation-delay: 0.5s;
	}

	@keyframes ask-dot {
		0%,
		100% {
			opacity: 0.4;
		}
		50% {
			opacity: 0.8;
		}
	}

	.ask-log :global(.ask-think) {
		position: absolute;
		z-index: -1;
		border-radius: 50%;
		background: var(--bubble-bg);
		animation: ask-think 1.2s ease-in-out infinite;
	}

	.ask-log :global(.ask-think:first-of-type) {
		/* The reference hangs these a few px further out; the scroller here
		   clips at the bubble's left edge, so they sit just inside it. */
		width: 12px;
		height: 12px;
		left: 3px;
		bottom: -3px;
		animation-delay: 0.1s;
	}

	.ask-log :global(.ask-think:last-of-type) {
		width: 6px;
		height: 6px;
		left: 0px;
		bottom: -8px;
		animation-delay: 0.2s;
	}

	@keyframes ask-think {
		0%,
		100% {
			transform: scale(0.9);
		}
		50% {
			transform: scale(1);
		}
	}

	/* The strip spans the bottom of the thread down to the compose field and
	   clips the chips as they slide out of it. Only the chips take clicks. */
	.ask-strip {
		position: absolute;
		z-index: 1;
		left: 0;
		right: 0;
		bottom: 0;
		padding-bottom: calc(var(--form-height) + var(--form-gap));
		overflow: hidden;
		pointer-events: none;
	}

	/* Suggestions: dashed blue pills in one row that scrolls sideways
	   instead of wrapping. */
	.ask-chips {
		list-style: none;
		margin: 0;
		padding: 2px 0;
		display: flex;
		align-items: center;
		gap: 8px;
		overflow-x: auto;
		scrollbar-width: none;
		-webkit-overflow-scrolling: touch;
		pointer-events: auto;
	}

	/* Mid-drag: a grabbing hand, and no text selection as the row slides. */
	.ask-chips[data-dragging],
	.ask-chips[data-dragging] .ask-chip {
		cursor: grabbing;
		user-select: none;
	}

	.ask-chips[inert] {
		pointer-events: none;
	}

	.ask-chips::-webkit-scrollbar {
		display: none;
	}

	.ask-chips {
		--fade-dir: to right;
	}

	.ask-chips[data-fade-start] {
		--fade-start: 24px;
	}

	.ask-chips[data-fade-end] {
		--fade-end: 40px;
	}

	.ask-chips li {
		flex-shrink: 0;
	}

	.ask-chip {
		font: inherit;
		font-size: 15px;
		line-height: 1.35;
		white-space: nowrap;
		color: var(--imsg-blue);
		background: #fff;
		border: 2px dashed rgba(0, 146, 255, 0.55);
		border-radius: 999px;
		padding: 6px 14px;
		cursor: pointer;
	}

	.ask-chip:hover {
		background: rgba(0, 146, 255, 0.08);
	}

	.ask-chip:focus-visible {
		outline: 2px solid var(--imsg-blue);
		outline-offset: 2px;
	}

	/* Compose field as frosted glass, from alexsafayan.com: a faint white
	   tint over a blurred, saturated view of the thread behind it. */
	.ask-form {
		position: absolute;
		z-index: 2;
		/* Wider than the thread, so its rounded ends fully cover the edges of
		   bubbles scrolling under it (the reference insets its messages 16px
		   from the input the same way). */
		left: -14px;
		right: -14px;
		bottom: 0;
		height: var(--form-height);
		box-sizing: border-box;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 4px 4px 4px 16px;
		background: rgba(255, 255, 255, 0.3);
		-webkit-backdrop-filter: blur(8px) saturate(300%);
		backdrop-filter: blur(8px) saturate(300%);
		border-radius: 20px;
		box-shadow:
			0 0 32px rgba(0, 0, 0, 0.12),
			inset 0 0 3px 1px #fff;
	}

	.ask-input {
		flex: 1;
		min-width: 0;
		font: inherit;
		/* 16px minimum: anything smaller makes iOS Safari zoom the page on focus. */
		font-size: 16px;
		font-weight: 500;
		/* Same height as the send button, so the pill hugs it. */
		height: 32px;
		line-height: 32px;
		color: #000;
		caret-color: var(--imsg-blue);
		background: none;
		border: 0;
		padding: 0;
		outline: none;
	}

	.ask-input::placeholder {
		color: #8e8e93;
	}

	/* Always live, never dimmed: with nothing typed it sends a hello. */
	.ask-send {
		flex-shrink: 0;
		display: grid;
		place-items: center;
		width: 40px;
		height: 32px;
		padding: 0;
		background: var(--imsg-blue);
		border: 0;
		border-radius: 16px;
		cursor: pointer;
		transition: transform 200ms ease-out;
	}

	.ask-send:active {
		transform: scale(0.9);
	}

	.ask-send svg {
		width: 16px;
		height: 16px;
		fill: none;
		stroke: #fff;
		stroke-width: 4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.ask-send:focus-visible {
		outline: 2px solid var(--imsg-blue);
		outline-offset: 2px;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
</style>

<script>
	import { createSpring, prefersReducedMotion, springEasing } from "../scripts/spring";

	// Motion values from alexsafayan.com's chat (Framer Motion springs).
	const MAIN = springEasing({ duration: 1, bounce: 0.2 });
	const QUICK = springEasing({ duration: 0.3, bounce: 0 });
	// Sent bubbles land without overshooting: past their spot they'd poke out
	// of the thread's right edge and get clipped.
	const FLIGHT = springEasing({ duration: 0.8, bounce: 0 });
	const LAYOUT = springEasing({ stiffness: 300, damping: 30 });
	const PULSE = { duration: 500, easing: "cubic-bezier(0.2, 0, 0.2, 1)" };
	const CHIPS_OFFSET = 104;
	// A beat after the page loads before the intro may start, so its first
	// typing dots are seen rather than lost in the load.
	const INTRO_LEAD_MS = 400;
	// After a message is sent, how long before the typing dots appear.
	const TYPING_DELAY_MS = 700;
	const HELLOS = ["hi", "sup", "yo"];
	// Phones and tablets, where focusing the field brings up a keyboard.
	const touchScreen = window.matchMedia("(pointer: coarse)");

	const SESSION_KEY = "ask-me-session";

	function getSessionId(): string {
		try {
			const existing = sessionStorage.getItem(SESSION_KEY);
			if (existing) return existing;
			const id = crypto.randomUUID();
			sessionStorage.setItem(SESSION_KEY, id);
			return id;
		} catch {
			// Storage blocked: a per-page-load session still works.
			return ((window as unknown as { __askSession?: string }).__askSession ??= crypto.randomUUID());
		}
	}

	const log = document.querySelector<HTMLOListElement>("[data-ask-log]")!;
	/** The chat's own zoom (the phone layout scales it up; 1 elsewhere). */
	const chatZoom = () => parseFloat(getComputedStyle(log.closest(".ask-me") ?? log).zoom) || 1;
	const template = document.querySelector<HTMLTemplateElement>("[data-ask-template]")!;
	const chips = document.querySelector<HTMLUListElement>("[data-ask-chips]")!;
	const form = document.querySelector<HTMLFormElement>("[data-ask-form]")!;
	const input = document.querySelector<HTMLInputElement>("[data-ask-input]")!;

	/**
	 * Shrink a bubble to its widest rendered line (from beerwar.app's fitBubble).
	 * A box whose text wraps keeps the full constraining width in CSS, so a
	 * two-line message would otherwise leave a band of empty bubble beside it.
	 */
	function fitBubble(msg: HTMLElement) {
		const text = msg.querySelector<HTMLElement>(".ask-text");
		const body = msg.querySelector<HTMLElement>(".ask-bubble");
		if (!text || !body) return;
		msg.style.width = "";
		const range = document.createRange();
		range.selectNodeContents(text);
		// A line can come back as several rects: one per text node or link on
		// it, and one per piece of a link split at its break points. So each
		// line is measured edge to edge (its rects grouped by vertical
		// position), not by its widest single rect, which fitted a bubble to
		// "github.com/" alone and wrapped "maximslo" onto a second line.
		const lines = new Map<number, { left: number; right: number }>();
		for (const rect of range.getClientRects()) {
			if (!rect.width) continue;
			const key = Math.round(rect.top + rect.height / 2);
			const line = [...lines.entries()].find(([mid]) => Math.abs(mid - key) <= rect.height / 2)?.[1];
			if (line) {
				line.left = Math.min(line.left, rect.left);
				line.right = Math.max(line.right, rect.right);
			} else {
				lines.set(key, { left: rect.left, right: rect.right });
			}
		}
		let widest = 0;
		for (const line of lines.values()) widest = Math.max(widest, line.right - line.left);
		if (widest === 0) return;
		// Measured on screen, so a bubble mid-animation (the typing bubble
		// still scaling in when its line arrives) reads small. Undo that scale,
		// or the bubble is fitted too narrow and the text wraps ("hell / o!").
		const scale = body.getBoundingClientRect().width / body.offsetWidth;
		if (scale > 0 && Number.isFinite(scale)) widest /= scale;
		const cs = getComputedStyle(body);
		const pad = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
		// +1 so sub-pixel rounding can't make the widest line re-wrap.
		msg.style.width = `${Math.ceil(widest + pad) + 1}px`;
	}

	/**
	 * Keep data-fade-start/-end on a scroller in step with whether there's more
	 * content before or after what's showing (the CSS turns them into fades).
	 */
	function trackEdges(el: HTMLElement, axis: "x" | "y") {
		const update = () => {
			const pos = axis === "y" ? el.scrollTop : el.scrollLeft;
			const span = axis === "y" ? el.scrollHeight - el.clientHeight : el.scrollWidth - el.clientWidth;
			el.toggleAttribute("data-fade-start", pos > 1);
			el.toggleAttribute("data-fade-end", pos < span - 1);
		};
		el.addEventListener("scroll", update, { passive: true });
		new ResizeObserver(update).observe(el);
		update();
		return update;
	}

	trackEdges(chips, "x");

	/* ---------- Moving the suggestions with a mouse ----------
	   Trackpads and touch already scroll the row sideways. A mouse wheel only
	   scrolls up and down, so it's turned sideways here, and the row can be
	   grabbed and dragged. A drag past a few px doesn't count as a tap on the
	   chip it started on. */
	chips.addEventListener(
		"wheel",
		(event) => {
			if (chips.scrollWidth <= chips.clientWidth) return;
			if (Math.abs(event.deltaY) <= Math.abs(event.deltaX)) return;
			event.preventDefault();
			stopGlide();
			chips.scrollLeft += event.deltaY;
		},
		{ passive: false },
	);

	let drag: { x: number; left: number; moved: boolean } | null = null;
	let suppressClick = false;

	/* Momentum: recent pointer positions give the speed at release, then the
	   row glides on and eases to a stop. Low friction, so it floats a while
	   (about a second from a quick flick) rather than stopping short. */
	const GLIDE_FRICTION = 0.955; // speed kept per 60fps frame
	const GLIDE_MIN_SPEED = 0.02; // px/ms; below this it's stopped
	let samples: { x: number; t: number }[] = [];
	let glideFrame = 0;

	function stopGlide() {
		cancelAnimationFrame(glideFrame);
		glideFrame = 0;
	}

	function glide(velocity: number) {
		stopGlide();
		let last = performance.now();
		const tick = (now: number) => {
			const dt = Math.min(now - last, 50);
			last = now;
			const before = chips.scrollLeft;
			chips.scrollLeft -= (velocity * dt) / chatZoom();
			velocity *= GLIDE_FRICTION ** (dt / (1000 / 60));
			// Ran into an end, or slowed to nothing.
			if (chips.scrollLeft === before || Math.abs(velocity) < GLIDE_MIN_SPEED) {
				glideFrame = 0;
				return;
			}
			glideFrame = requestAnimationFrame(tick);
		};
		glideFrame = requestAnimationFrame(tick);
	}

	/** Pointer speed over the last ~80ms of the drag, in px/ms. */
	function releaseVelocity() {
		const now = performance.now();
		const recent = samples.filter((s) => now - s.t < 80);
		if (recent.length < 2) return 0;
		const first = recent[0];
		const last = recent[recent.length - 1];
		const dt = last.t - first.t;
		return dt > 0 ? (last.x - first.x) / dt : 0;
	}

	chips.addEventListener("pointerdown", (event) => {
		if (event.pointerType !== "mouse" || event.button !== 0) return;
		// Grabbing the row mid-glide catches it.
		stopGlide();
		drag = { x: event.clientX, left: chips.scrollLeft, moved: false };
		samples = [{ x: event.clientX, t: performance.now() }];
	});

	window.addEventListener("pointermove", (event) => {
		if (!drag) return;
		const dx = event.clientX - drag.x;
		if (!drag.moved && Math.abs(dx) < 4) return;
		if (!drag.moved) {
			drag.moved = true;
			chips.setPointerCapture(event.pointerId);
			chips.dataset.dragging = "";
		}
		// Scroll positions count in the zoomed chat's pixels, the pointer in
		// screen pixels: divided, the row stays under the cursor.
		chips.scrollLeft = drag.left - dx / chatZoom();
		samples.push({ x: event.clientX, t: performance.now() });
		if (samples.length > 20) samples.shift();
	});

	const endDrag = () => {
		if (!drag) return;
		// The click a drag produces fires right after pointerup; clear the flag
		// straight after, so a drag ending off the row can't eat the next tap.
		if (drag.moved) {
			suppressClick = true;
			setTimeout(() => (suppressClick = false), 0);
			const velocity = releaseVelocity();
			if (!prefersReducedMotion() && Math.abs(velocity) > GLIDE_MIN_SPEED) glide(velocity);
		}
		drag = null;
		delete chips.dataset.dragging;
	};
	window.addEventListener("pointerup", endDrag);
	window.addEventListener("pointercancel", endDrag);
	const updateLogEdges = trackEdges(log, "y");

	/* ---------- Drawn scroll indicator (touch, phone layout) ----------
	   Sized and placed like a native one, inside the track's limits; shown
	   while the thread scrolls and faded out shortly after. The CSS keeps
	   it hidden everywhere else, so this is harmless there. */
	const scrollTrack = document.querySelector<HTMLElement>("[data-ask-scroll-track]");
	if (scrollTrack) {
		let hideTimer = 0;
		let trackFrame = 0;
		const place = () => {
			trackFrame = 0;
			const trackH = scrollTrack.clientHeight;
			const span = log.scrollHeight - log.clientHeight;
			if (!trackH || span <= 0) {
				scrollTrack.style.setProperty("--thumb-h", "0px");
				return;
			}
			const thumbH = Math.max(32, (trackH * log.clientHeight) / log.scrollHeight);
			const progress = Math.min(1, Math.max(0, log.scrollTop / span));
			scrollTrack.style.setProperty("--thumb-h", `${thumbH}px`);
			scrollTrack.style.setProperty("--thumb-y", `${(trackH - thumbH) * progress}px`);
		};
		const schedulePlace = () => {
			if (!trackFrame) trackFrame = requestAnimationFrame(place);
		};
		log.addEventListener(
			"scroll",
			() => {
				schedulePlace();
				scrollTrack.toggleAttribute("data-active", true);
				clearTimeout(hideTimer);
				hideTimer = window.setTimeout(() => scrollTrack.removeAttribute("data-active"), 700);
			},
			{ passive: true },
		);
		// The phone shrinking (keyboard) and new messages change the sizes.
		new ResizeObserver(schedulePlace).observe(log);
		new ResizeObserver(schedulePlace).observe(scrollTrack);
		new MutationObserver(schedulePlace).observe(log, { childList: true, subtree: true });
		place();
	}

	// How wide the thread's scrollbar is, so the top fade can stop short of it.
	new ResizeObserver(() => {
		log.parentElement!.style.setProperty("--scrollbar-width", `${log.offsetWidth - log.clientWidth}px`);
	}).observe(log);

	const isAtBottom = () => log.scrollTop >= log.scrollHeight - log.clientHeight - 4;

	/* ---------- Scroll settle ----------
	   While the thread scrolls, each bubble lags behind by an amount that grows
	   with scroll speed and with how far along it sits in the scroll direction,
	   so the thread stretches, then springs back together as it slows. */

	const scrollSpeed = createSpring({ stiffness: 2000, damping: 200, mass: 1 });
	let lastScrollTop = log.scrollTop;
	let lastFrame = 0;
	let settleFrame = 0;

	function settleOffset(msg: HTMLElement, v: number) {
		const rel = (msg.offsetTop - log.scrollTop) / log.clientHeight;
		const d = Math.max(0, Math.sign(v) * (rel - 0.5) * 2) ** 2;
		return 50 * Math.tanh((v * (0.03 + d * 0.07)) / 100);
	}

	function settleStep(now: number) {
		const dt = Math.min((now - lastFrame) / 1000, 0.05) || 1 / 60;
		lastFrame = now;
		const top = log.scrollTop;
		scrollSpeed.target = (top - lastScrollTop) / dt;
		lastScrollTop = top;
		scrollSpeed.step(dt);

		const v = scrollSpeed.value;
		// Under 5px/s the offsets are a twentieth of a pixel: call it still.
		const resting = scrollSpeed.target === 0 && Math.abs(v) < 5 && Math.abs(scrollSpeed.velocity) < 50;
		for (const msg of log.querySelectorAll<HTMLElement>(".ask-msg")) {
			msg.style.transform = resting ? "" : `translateY(${settleOffset(msg, v).toFixed(2)}px)`;
		}
		if (resting) {
			scrollSpeed.value = 0;
			scrollSpeed.velocity = 0;
			settleFrame = 0;
			return;
		}
		settleFrame = requestAnimationFrame(settleStep);
	}

	function startSettle() {
		if (settleFrame || prefersReducedMotion()) return;
		lastFrame = performance.now();
		settleFrame = requestAnimationFrame(settleStep);
	}

	log.addEventListener("scroll", startSettle, { passive: true });

	/* ---------- Following the conversation ----------
	   New bubbles and replies glide the thread to the bottom on a soft spring
	   (use-stick-to-bottom's constants, as the reference uses), unless the
	   visitor has scrolled up to reread something. */

	let pinnedToEnd = true;
	let followFrame = 0;
	let followVelocity = 0;
	// Keep gliding until at least this time, even if already at the bottom:
	// a reply bubble grows for a moment after it lands, and nothing else
	// changes in the DOM to say the thread got taller.
	let followHoldUntil = 0;
	let following = false;

	log.addEventListener(
		"scroll",
		() => {
			if (!following) pinnedToEnd = isAtBottom();
			updateChips();
		},
		{ passive: true },
	);
	// A wheel or touch from the visitor always wins over the glide.
	for (const type of ["wheel", "touchstart"]) {
		log.addEventListener(type, () => stopFollow(), { passive: true });
	}

	function stopFollow() {
		cancelAnimationFrame(followFrame);
		followFrame = 0;
		following = false;
		followVelocity = 0;
	}

	function followToEnd() {
		if (prefersReducedMotion()) {
			log.scrollTop = log.scrollHeight;
			return;
		}
		if (followFrame) return;
		following = true;
		let last = performance.now();
		let expected = log.scrollTop;
		const tick = (now: number) => {
			// Anything that moved the thread besides this glide (scrollbar drag,
			// keyboard, a script) means the visitor wants control back.
			if (Math.abs(log.scrollTop - expected) > 2) {
				stopFollow();
				pinnedToEnd = isAtBottom();
				updateChips();
				return;
			}
			const frames = Math.min((now - last) / (1000 / 60), 3);
			last = now;
			const target = log.scrollHeight - log.clientHeight;
			const diff = target - log.scrollTop;
			followVelocity = ((0.7 * followVelocity + 0.05 * diff) / 1.25) * Math.max(frames, 1);
			if (Math.abs(diff) < 0.5 && Math.abs(followVelocity) < 0.5 && now >= followHoldUntil) {
				log.scrollTop = target;
				stopFollow();
				pinnedToEnd = true;
				updateChips();
				return;
			}
			log.scrollTop += followVelocity;
			expected = log.scrollTop;
			followFrame = requestAnimationFrame(tick);
		};
		followFrame = requestAnimationFrame(tick);
	}

	new MutationObserver(() => {
		if (pinnedToEnd) followToEnd();
		updateLogEdges();
	}).observe(log, { childList: true, subtree: true, characterData: true });

	/* Anchor the thread to its bottom when it gets shorter. On phones the
	   keyboard shrinks the phone from the bottom; left alone, the scroll
	   position holds from the top and the newest messages slide under the
	   compose field. Scrolling by however much height was lost keeps the
	   same gap above the field the whole way up, like iMessage. */
	let lastLogHeight = log.clientHeight;
	new ResizeObserver(() => {
		const height = log.clientHeight;
		const lost = lastLogHeight - height;
		lastLogHeight = height;
		// A glide to the end is already headed there; nudging it would read
		// as the visitor taking over and stop it.
		if (lost > 0 && !following) log.scrollTop += lost;
	}).observe(log);

	/** Mark every bubble that's followed by another from the same side, so only the last in a run keeps its tail. */
	const isUser = (msg: Element | null) => (msg as HTMLElement | null)?.dataset.role === "user";
	function updateTails() {
		for (const msg of log.querySelectorAll<HTMLElement>(".ask-msg")) {
			const next = msg.nextElementSibling;
			msg.toggleAttribute("data-run-continues", !!next && isUser(next) === isUser(msg));
		}
	}
	// New bubbles, and a typing bubble turning into an error, change the runs.
	new MutationObserver(updateTails).observe(log, { childList: true, subtree: true, attributeFilter: ["data-role"] });
	updateTails();

	/* ---------- Intro ----------
	   Like alexsafayan.com: the thread starts with my first line and the
	   visitor's canned "Hi there"; my lines after it are "typed" one by one
	   once the chat is about half on screen. The HTML has every line, so
	   without JS or with reduced motion they're all simply there. */
	const introLines: string[] = [];
	if (!prefersReducedMotion()) {
		const opener = [...log.querySelectorAll<HTMLElement>(".ask-msg")];
		const lastUser = opener.findLastIndex((msg) => msg.dataset.role === "user");
		for (const msg of opener.slice(Math.max(lastUser + 1, 1))) {
			introLines.push(msg.textContent?.trim() ?? "");
			msg.remove();
		}
	}
	log.toggleAttribute("data-intro-ready", true);
	let introRunning = introLines.length > 0;
	let introCancel: (() => void) | null = null;

	const fitAll = () => log.querySelectorAll<HTMLElement>(".ask-msg").forEach(fitBubble);
	fitAll();
	let resizeFrame = 0;
	window.addEventListener("resize", () => {
		cancelAnimationFrame(resizeFrame);
		resizeFrame = requestAnimationFrame(fitAll);
	});

	/* Bubbles are fitted to their text once, when they appear. If the text
	   later renders wider than it measured (seen on phones: "Hi there"
	   wrapping to three lines inside its fitted width), the bubble would keep
	   the stale width. So every settled bubble is watched, and refitted when
	   its size changes (fitBubble first clears the width, so wrapped text is
	   measured unwrapped). A refit that lands on the same width changes
	   nothing, so this settles at once. */
	const refitOnResize = new ResizeObserver((entries) => {
		for (const entry of entries) {
			const msg = (entry.target as HTMLElement).closest<HTMLElement>(".ask-msg");
			if (!msg || msg.dataset.pending !== undefined) continue;
			// Mid-animation sizes aren't the real ones; revealReply fits on its own.
			if ((entry.target as HTMLElement).getAnimations().length) continue;
			fitBubble(msg);
		}
	});
	const watchBubbles = () => log.querySelectorAll(".ask-bubble").forEach((bubble) => refitOnResize.observe(bubble));
	watchBubbles();
	new MutationObserver(watchBubbles).observe(log, { childList: true });
	// The thread itself changing width means every bubble's room changed:
	// refit them all. On a phone refresh the opening bubbles were fitted
	// while the frame was still settling to its width (viewport and bar sizes
	// land a beat after the script runs) and kept the cramped widths ("Hi /
	// there"). A fitted bubble has a fixed width, so it doesn't resize on its
	// own and the watcher above never saw it.
	let lastLogWidth = log.clientWidth;
	new ResizeObserver(() => {
		const width = log.clientWidth;
		if (width === lastLogWidth) return;
		lastLogWidth = width;
		fitAll();
	}).observe(log);
	// Fonts arriving or the page finishing its load can change text widths too.
	document.fonts?.ready.then(fitAll);
	addEventListener("load", fitAll, { once: true });

	/* ---------- Suggestions ----------
	   Shown only when there's nothing else going on: thread at the bottom,
	   empty input, no reply on its way, and the assistant spoke last. */

	let busy = false;
	let chipsDisabled = false;
	let typedInARow = 0;
	// Touch screens only: the field was tapped and nothing's been sent since.
	let fieldTapped = false;
	let chipsShown = true;
	let chipsAnimation: Animation | null = null;

	const remainingChips = () => chips.querySelectorAll("[data-ask-chip]").length;

	function chipsWanted() {
		const last = log.lastElementChild as HTMLElement | null;
		return (
			!chipsDisabled &&
			!busy &&
			!introRunning &&
			input.value === "" &&
			// On touch screens, tapping the field opens the keyboard: the
			// suggestions step aside until something is sent.
			!fieldTapped &&
			isAtBottom() &&
			last?.dataset.role !== "user" &&
			remainingChips() > 0
		);
	}

	function setChips(show: boolean, how: "slide" | "fade" | "instant" = "slide") {
		if (show === chipsShown) return;
		chipsShown = show;
		chips.inert = !show;

		// Start from wherever an interrupted slide left them.
		const from = getComputedStyle(chips).transform;
		const fromOpacity = getComputedStyle(chips).opacity;
		chipsAnimation?.cancel();
		const hidden = `translateY(${CHIPS_OFFSET}px)`;
		const end = show ? "none" : hidden;

		if (prefersReducedMotion() || how === "instant") {
			chips.style.transform = end;
			chips.style.opacity = "";
			return;
		}
		if (how === "fade") {
			// Tapped suggestion: the row fades in place, then parks below unseen.
			chipsAnimation = chips.animate([{ opacity: fromOpacity }, { opacity: 0 }], { duration: 200, easing: "ease" });
			chipsAnimation.onfinish = () => {
				chips.style.transform = hidden;
				chipsAnimation = null;
			};
			chips.style.opacity = "0";
			chipsAnimation.addEventListener("finish", () => (chips.style.opacity = ""));
			return;
		}
		chips.style.opacity = "";
		chips.style.transform = end;
		chipsAnimation = chips.animate([{ transform: from === "none" ? "translateY(0)" : from }, { transform: end === "none" ? "translateY(0)" : end }], {
			duration: MAIN.duration,
			easing: MAIN.easing,
		});
	}

	function updateChips() {
		if (!chipsDisabled && remainingChips() === 0) {
			disableChips();
			return;
		}
		setChips(chipsWanted());
	}

	function disableChips() {
		chipsDisabled = true;
		setChips(false);
		log.toggleAttribute("data-chips-off", true);
	}

	input.addEventListener("input", updateChips);
	// Touch screens: the suggestions hide when the field is tapped (the
	// keyboard comes up), and come back once a reply has landed, keyboard
	// still up or not, or once the keyboard has gone and the phone is back to
	// full height. Safari and Chrome close the keyboard at different speeds,
	// so that's watched for rather than timed: the thread's height when the
	// field was tapped, reached again and holding still.
	let heightBeforeKeyboard = 0;
	let expandTimer = 0;
	let expandGiveUp = 0;
	let expandWatch: ResizeObserver | null = null;

	function stopWaitingForExpand() {
		expandWatch?.disconnect();
		expandWatch = null;
		clearTimeout(expandTimer);
		clearTimeout(expandGiveUp);
	}

	function showChipsWhenExpanded() {
		stopWaitingForExpand();
		const settle = () => {
			clearTimeout(expandTimer);
			// Back to full height: wait a beat to be sure it's done moving.
			if (log.clientHeight >= heightBeforeKeyboard - 1) {
				expandTimer = window.setTimeout(done, 120);
			}
		};
		const done = () => {
			stopWaitingForExpand();
			fieldTapped = false;
			updateChips();
		};
		expandWatch = new ResizeObserver(settle);
		expandWatch.observe(log);
		// If the height never quite comes back (a browser bar changed size
		// meanwhile), don't keep them away for good.
		expandGiveUp = window.setTimeout(done, 1500);
		settle();
	}

	input.addEventListener("focus", () => {
		stopWaitingForExpand();
		fieldTapped = touchScreen.matches;
		if (fieldTapped) heightBeforeKeyboard = log.clientHeight;
		// They vanish at once rather than sliding down, so they're not seen
		// riding along with the keyboard as it comes up. Coming back is still
		// the usual slide.
		if (fieldTapped) setChips(false, "instant");
		else updateChips();
	});
	input.addEventListener("blur", () => {
		if (fieldTapped) {
			// The keyboard is on its way down: wait for the phone to be back.
			showChipsWhenExpanded();
			return;
		}
		updateChips();
	});

	// On phones the keyboard opens on focus and the chat shrinks to fit above
	// it; once it has, bring the newest message back into view over the input,
	// with the full gap under it. Like iMessage, tapping the field always
	// jumps to the latest, even when scrolled back up through the thread.
	input.addEventListener("focus", () => {
		if (!touchScreen.matches && !pinnedToEnd) return;
		pinnedToEnd = true;
		const vv = window.visualViewport;
		let done = false;
		const settle = () => {
			if (done) return;
			done = true;
			vv?.removeEventListener("resize", settle);
			if (pinnedToEnd) followToEnd();
		};
		vv?.addEventListener("resize", settle, { once: true });
		// No keyboard (desktop), or no resize event: settle anyway.
		setTimeout(settle, 350);
	});

	/* ---------- Messages ---------- */

	/* Links in my replies. The bot writes them bare, the way you'd text them
	   (github.com/maximslo, an email address), so they're found in the plain
	   text: full URLs, www. addresses, bare domains on common endings, and
	   emails. Trailing punctuation stays outside the link. Built as DOM
	   nodes, never HTML, so a reply can't inject markup. */
	const LINK_PATTERN =
		/\b([a-z0-9._%+-]+@[a-z0-9.-]+\.[a-z]{2,})\b|\b((?:https?:\/\/|www\.)[^\s<]+|(?:[a-z0-9-]+\.)+(?:com|org|net|io|co|dev|app|me|ai|xyz|so|gg|edu|us|uk|ca|tv|fm|sh|page|site|design|studio|news)(?![a-z0-9-])(?:\/[^\s<]*)?)/gi;

	function setReplyText(textEl: HTMLElement, text: string) {
		textEl.textContent = "";
		let at = 0;
		for (const match of text.matchAll(LINK_PATTERN)) {
			let label = match[0];
			const start = match.index ?? 0;
			// "github.com/maximslo." → link "github.com/maximslo", then "."
			const trailing = label.match(/[.,!?;:)\]'"]+$/)?.[0] ?? "";
			if (trailing && !(trailing.startsWith(")") && label.includes("("))) label = label.slice(0, -trailing.length);
			if (!label) continue;
			if (start > at) textEl.append(text.slice(at, start));
			const link = document.createElement("a");
			link.className = "ask-link";
			// A link too long for the bubble breaks after a slash
			// ("linkedin.com/in/" / "maximslo"), not mid-word.
			label.split(/(?<=\/)/).forEach((piece, i) => {
				if (i) link.append(document.createElement("wbr"));
				link.append(piece);
			});
			if (match[1]) {
				link.href = `mailto:${label}`;
			} else {
				link.href = /^https?:\/\//i.test(label) ? label : `https://${label}`;
				link.target = "_blank";
				link.rel = "noopener noreferrer";
			}
			textEl.append(link);
			at = start + label.length;
		}
		if (at < text.length) textEl.append(text.slice(at));
	}

	function addMessage(role: "user" | "assistant" | "error", text = "") {
		const msg = template.content.firstElementChild!.cloneNode(true) as HTMLLIElement;
		msg.dataset.role = role;
		const textEl = msg.querySelector<HTMLElement>(".ask-text")!;
		if (role === "user") textEl.textContent = text;
		else setReplyText(textEl, text);
		log.append(msg);
		if (text) fitBubble(msg);
		return { msg, textEl };
	}

	const part = (msg: HTMLElement, selector: string) => msg.querySelector<HTMLElement>(selector)!;

	/** Width of `text` in the input's font, for where the typed words sit. */
	function textWidth(text: string) {
		const ctx = document.createElement("canvas").getContext("2d");
		if (!ctx) return 0;
		ctx.font = getComputedStyle(input).font;
		return ctx.measureText(text).width;
	}

	/**
	 * Fly a new bubble in from where its words were (the input or a chip):
	 * the body moves from there to its place in the thread while the bubble's
	 * clip opens from that box to its full shape. Then a small squeeze, and
	 * the tail slides in under it.
	 */
	function animateSend(msg: HTMLElement, from: DOMRect, textInset: number, spring: typeof MAIN) {
		const body = part(msg, ".ask-body");
		const bubble = part(msg, ".ask-bubble");
		const tail = part(msg, ".ask-tail");
		const end = bubble.getBoundingClientRect();
		const pad = parseFloat(getComputedStyle(bubble).paddingLeft);
		// Rects are screen pixels; the transform and clip apply inside the
		// chat's zoom (the phone layout's --ask-zoom), so they're converted
		// back, or the bubble would fly in from 10% too far away.
		const z = chatZoom();

		// Line the bubble's text up with the source text, centred vertically.
		const dx = (from.left - end.left) / z + textInset - pad;
		const dy = (from.top + from.height / 2 - (end.top + end.height / 2)) / z;
		const endWidth = end.width / z;
		const endHeight = end.height / z;
		const startWidth = Math.min(from.width / z, endWidth);
		const startHeight = Math.min(from.height / z, endHeight);
		const clipTop = (endHeight - startHeight) / 2;
		const startRadius = startHeight / 2;
		const startClip = `inset(${clipTop}px ${endWidth - startWidth}px ${clipTop}px 0px round ${startRadius}px)`;

		body.animate([{ transform: `translate(${dx}px, ${dy}px)` }, { transform: "translate(0, 0)" }], {
			duration: spring.duration,
			easing: spring.easing,
		});
		bubble.animate([{ clipPath: startClip }, { clipPath: "inset(0px 0px 0px 0px round 20px)" }], {
			duration: spring.duration,
			easing: spring.easing,
		});
		// The squeeze adds on top of the move instead of replacing it.
		body.style.transformOrigin = "100% 100%";
		body.animate([{ transform: "scale(1)" }, { transform: "scale(0.9)" }, { transform: "scale(1)" }], {
			...PULSE,
			composite: "add",
		});
		// `translate`, not `transform`: the tail's own transform is its mirror.
		tail.animate([{ translate: "-20px -13px" }, { translate: "0 0" }], {
			duration: FLIGHT.duration,
			easing: FLIGHT.easing,
		});
	}

	function addTyping() {
		const { msg, textEl } = addMessage("assistant");
		msg.dataset.pending = "";
		textEl.innerHTML = '<span class="ask-dots" aria-label="typing"><i></i><i></i><i></i></span>';
		const body = part(msg, ".ask-body");
		for (let i = 0; i < 2; i++) {
			const dot = document.createElement("span");
			dot.className = "ask-think";
			body.append(dot);
		}
		if (!prefersReducedMotion()) {
			body.style.transformOrigin = "0% 100%";
			body.animate(
				[
					{ transform: "scale(0.5)", opacity: 0 },
					{ transform: "scale(1)", opacity: 1 },
				],
				PULSE,
			);
		}
		return { msg, textEl };
	}

	/**
	 * Turn the typing bubble into the reply: the bubble itself stretches from
	 * the dots' size out to the message's (alexsafayan.com's layout spring),
	 * with the text already in place and uncovered as it grows.
	 */
	function revealReply(msg: HTMLElement, textEl: HTMLElement, text: string, role: "assistant" | "error") {
		const bubble = part(msg, ".ask-bubble");
		// Layout sizes, not on-screen ones: the dots may still be scaling in.
		const from = { width: bubble.offsetWidth, height: bubble.offsetHeight };
		msg.querySelectorAll(".ask-think").forEach((el) => el.remove());
		delete msg.dataset.pending;
		msg.dataset.role = role;
		setReplyText(textEl, text);
		fitBubble(msg);
		if (prefersReducedMotion()) return;

		const to = { width: bubble.offsetWidth, height: bubble.offsetHeight };
		// Hold the text at its final line breaks while the bubble is still
		// narrower, so it's revealed rather than reflowed as the bubble grows.
		const pad = parseFloat(getComputedStyle(bubble).paddingLeft) + parseFloat(getComputedStyle(bubble).paddingRight);
		textEl.style.display = "block";
		textEl.style.width = `${to.width - pad}px`;
		const grow = bubble.animate(
			[
				{ width: `${from.width}px`, height: `${from.height}px` },
				{ width: `${to.width}px`, height: `${to.height}px` },
			],
			{ duration: LAYOUT.duration, easing: LAYOUT.easing },
		);
		// Follow the bubble down while it grows, so a tall reply (a list) isn't
		// left hanging under the compose field and suggestions.
		followHoldUntil = performance.now() + LAYOUT.duration + 50;
		if (pinnedToEnd) followToEnd();
		grow.onfinish = grow.oncancel = () => {
			textEl.style.display = "";
			textEl.style.width = "";
		};
	}

	function setBusy(next: boolean) {
		busy = next;
		updateChips();
	}

	type Source = { rect: DOMRect; inset: number; spring: typeof MAIN };

	async function ask(message: string, source: Source) {
		const text = message.trim();
		if (!text) return;
		// Sending mid-intro: the rest of the greeting lands at once, first.
		introCancel?.();

		// Sending always brings the thread back to its newest message.
		pinnedToEnd = true;
		const { msg } = addMessage("user", text);
		if (!prefersReducedMotion()) animateSend(msg, source.rect, source.inset, source.spring);
		setBusy(true);

		(window as unknown as { plausible?: (event: string) => void }).plausible?.("chat_message");

		// The whole reply is collected behind the typing dots, then shown at
		// once. The request goes out straight away; only the dots wait.
		const replyPromise = (async (): Promise<{ answer: string; role: "assistant" | "error" }> => {
			try {
				const res = await fetch("/api/chat", {
					method: "POST",
					headers: { "content-type": "application/json" },
					body: JSON.stringify({ sessionId: getSessionId(), message: text }),
				});

				if (!res.ok || !res.body) {
					return { role: "error", answer: (await res.text()) || "Something went wrong. Try again in a bit." };
				}
				const reader = res.body.getReader();
				const decoder = new TextDecoder();
				let answer = "";
				for (;;) {
					const { done, value } = await reader.read();
					if (done) break;
					answer += decoder.decode(value, { stream: true });
				}
				return { role: "assistant", answer: answer + decoder.decode() };
			} catch {
				return { role: "error", answer: "Couldn't reach the server. Check your connection and try again." };
			}
		})();

		// A beat before the typing dots, like someone reading the text before
		// they start typing back, rather than dots popping up the instant it's
		// sent.
		if (!prefersReducedMotion()) await pause(TYPING_DELAY_MS);
		const { msg: reply, textEl } = addTyping();

		let { answer, role } = await replyPromise;

		// Texts are separated by blank lines; a single line break stays inside
		// one bubble (a list, like the tech stack). The first text opens out of
		// the typing bubble, the rest follow one by one at the intro's pace.
		// The server's own messages (like the end-of-chat one) split the same
		// way, so they can arrive as several texts too.
		const texts = answer
			.split(/\n\s*\n/)
			.map((t) => t.split("\n").map((line) => line.trim()).join("\n").trim())
			.filter(Boolean);
		if (!texts.length) {
			role = "error";
			texts.push("Something went wrong. Try again in a bit.");
		}
		revealReply(reply, textEl, texts[0], role);
		for (const text of texts.slice(1)) {
			const next = addTyping();
			await pause(lineDelay(text));
			revealReply(next.msg, next.textEl, text, role);
		}
		setBusy(false);
		// Back to the field for the next question. Not on touch screens: there
		// a scripted focus doesn't open the keyboard, so it would only hide
		// the suggestions with nothing to type on.
		if (!touchScreen.matches) input.focus();
		// Something was sent and answered: the suggestions may come back,
		// even with the keyboard still up.
		fieldTapped = false;
		updateChips();
	}

	form.addEventListener("submit", (event) => {
		event.preventDefault();
		// One reply at a time; whatever's typed stays put until it lands.
		if (busy) return;
		// Nothing typed: the button still works, as a quick hello.
		const value = input.value.trim() || HELLOS[Math.floor(Math.random() * HELLOS.length)];
		// Where the typed words sit: the input's left edge, as wide as the text.
		const box = input.getBoundingClientRect();
		const rect = new DOMRect(box.left, box.top, textWidth(value.trim()) + 32, box.height);
		input.value = "";
		typedInARow += 1;
		if (typedInARow >= 3) disableChips();
		void ask(value, { rect, inset: 0, spring: QUICK });
	});

	chips.addEventListener("click", (event) => {
		// The click that ends a drag isn't a tap on a suggestion.
		if (suppressClick) {
			suppressClick = false;
			return;
		}
		const chip = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-ask-chip]");
		if (!chip || busy) return;
		const rect = chip.getBoundingClientRect();
		const inset = parseFloat(getComputedStyle(chip).paddingLeft) + parseFloat(getComputedStyle(chip).borderLeftWidth);
		typedInARow = 0;
		setChips(false, "fade");
		// Used suggestions don't come back.
		chip.closest("li")!.remove();
		void ask(chip.textContent ?? "", { rect, inset, spring: FLIGHT });
	});

	/** The reference's pacing per line: half a second, plus more for longer lines. */
	const lineDelay = (line: string) => 500 + 2500 * Math.min(line.length / 200, 1);
	const pause = (ms: number) => new Promise((resolve) => setTimeout(resolve, Math.max(0, ms)));

	/** Typing dots, a pause scaled to the line's length, then the line. */
	async function playIntro() {
		let cancelled = false;
		let typing = addTyping();
		introCancel = () => {
			cancelled = true;
			introCancel = null;
			typing.msg.remove();
			for (const line of introLines.splice(0)) addMessage("assistant", line);
			introRunning = false;
		};
		let last = performance.now();
		while (introLines.length) {
			const line = introLines[0];
			await pause(lineDelay(line) - (performance.now() - last));
			if (cancelled) return;
			introLines.shift();
			revealReply(typing.msg, typing.textEl, line, "assistant");
			last = performance.now();
			if (introLines.length) typing = addTyping();
		}
		introCancel = null;
		introRunning = false;
		updateChips();
	}

	if (introRunning) {
		// Suggestions wait under the compose field until the greeting is done.
		chipsShown = false;
		chips.inert = true;
		chips.style.transform = `translateY(${CHIPS_OFFSET}px)`;
		// Start once the spot where the typing dots will appear is actually on
		// screen: the last opening message fully in view, with ~80px of room
		// under it. Keying off the section as a whole started it while that
		// spot was still below the fold, so "hello!"'s dots were never seen.
		const observer = new IntersectionObserver(
			(entries) => {
				if (!entries[0].isIntersecting) return;
				observer.disconnect();
				void playIntro();
			},
			{ threshold: 1, rootMargin: "0px 0px -80px 0px" },
		);
		// Wait for the page to finish loading and be on screen first: reloading
		// while scrolled to the chat restores that position, and starting at
		// once played the first dots and "hello!" before anything was painted.
		const ready = document.readyState === "complete" ? Promise.resolve() : new Promise((resolve) => addEventListener("load", resolve, { once: true }));
		void ready
			.then(() => pause(INTRO_LEAD_MS))
			.then(() => observer.observe(log.lastElementChild!));
	} else {
		chips.style.transform = "none";
		chips.inert = false;
	}
</script>
