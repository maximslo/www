---
// Collapsible chapter for the portfolio write-ups, built on the native
// <details>/<summary> element (no library, no client JS). Drop into an .mdx body:
//
//   import Chapter from "../../components/Chapter.astro";
//
//   <Chapter title="Chapter 1 - iMessage (Data Source)" open>
//
//   ...markdown body (keep blank lines around it so MDX parses it)...
//
//   </Chapter>
//
// `open` renders the chapter expanded on load; omit it to start collapsed.
// The <summary> is styled to match the `## heading` look on the project page.
interface Props {
	title: string;
	/** Start expanded. Leave off to start collapsed. */
	open?: boolean;
}

const { title, open = false } = Astro.props;
---

<details class="chapter" open={open}>
	<summary>
		<svg
			class="chevron"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2.2"
			stroke-linecap="round"
			stroke-linejoin="round"
			aria-hidden="true"
		>
			<path d="M9 18l6-6-6-6"></path>
		</svg>
		<span>{title}</span>
	</summary>
	<div class="body">
		<slot />
	</div>
</details>

<style>
	.chapter {
		border-top: 1px dashed var(--rule);
		margin: var(--space-section) 0 0;
	}
	/* the summary takes the place of a `## ` heading — match its type */
	.chapter summary {
		display: flex;
		align-items: center;
		gap: 0.4rem;
		list-style: none; /* drop the default disclosure triangle */
		cursor: pointer;
		font-size: 0.8rem;
		font-weight: 500;
		line-height: 1.3;
		color: var(--ink);
		padding: 0.7rem 0 0.1rem;
		user-select: none;
	}
	.chapter summary::-webkit-details-marker {
		display: none; /* Safari's triangle */
	}
	.chapter summary:hover {
		color: var(--label);
	}
	.chevron {
		width: 0.7rem;
		height: 0.7rem;
		flex-shrink: 0;
		color: var(--label);
		transition: transform 0.2s ease;
	}
	.chapter[open] .chevron {
		transform: rotate(90deg);
	}
	/* the rendered Markdown body — nudge the first child flush to the summary */
	.body {
		padding-top: 0.25rem;
	}
	.body :global(> :first-child) {
		margin-top: 0;
	}
</style>
