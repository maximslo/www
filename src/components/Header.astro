---
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);

const links = [
  { label: 'Work', href: '/' },
  { label: 'Fun', href: '/fun' },
  { label: 'About', href: '/about' },
];
---

<header class="site-header" data-menu-open="false">
  <div class="container bar">
    <a href="/" class="brand" aria-label="Home">
      <span class="brand-name">MAXIM SLOBODCHIKOV</span>
      <span class="brand-role">Design Engineer</span>
    </a>

    <div class="bar-right">
      <nav class="nav" aria-label="Primary">
        {
          links.map((l) => (
            <a
              href={l.href}
              class:list={['nav-link', { active: isActive(l.href) }]}
              aria-current={isActive(l.href) ? 'page' : undefined}
            >
              {l.label}
            </a>
          ))
        }
        <a href="/resume.pdf" class="nav-link" target="_blank" rel="noopener">
          Resume
        </a>
      </nav>

      <button class="menu-toggle" type="button" aria-label="Toggle menu" aria-expanded="false">
        <span class="menu-icon">
          <span></span>
          <span></span>
        </span>
      </button>
    </div>
  </div>

  <div class="container">
    <nav class="mobile-nav" aria-label="Primary mobile">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['mobile-nav-link', { active: isActive(l.href) }]}
            aria-current={isActive(l.href) ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
      <a href="/resume.pdf" class="mobile-nav-link" target="_blank" rel="noopener">
        Resume
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector('.menu-toggle');

  toggle?.addEventListener('click', () => {
    const isOpen = header?.getAttribute('data-menu-open') === 'true';
    header?.setAttribute('data-menu-open', String(!isOpen));
    toggle.setAttribute('aria-expanded', String(!isOpen));
  });
</script>

<style>
  .site-header {
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: saturate(1.2) blur(8px);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    /* same 1fr 1fr + 24px gap as the hero/work grids, so the right column
       (nav) starts at the exact x where the dates / 2nd project column start */
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    column-gap: 24px;
    height: 64px;
  }

  /* right column: nav pinned to its left edge, wordmark to the far right */
  .bar-right {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* Left: name + role */
  .brand {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--muted);
    justify-self: start;
  }
  .brand-name {
    font-weight: 500;
    color: var(--fg);
  }
  .brand-role {
    color: var(--muted);
  }

  /* Center: nav */
  .nav {
    display: flex;
    align-items: center;
    gap: 32px;
  }
  .nav-link {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .nav-link:hover {
    color: var(--fg);
  }
  .nav-link.active {
    color: #0ea5e9;
  }

  /* Hamburger toggle (mobile only) */
  .menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border: none;
    background: none;
    padding: 0;
    color: var(--fg);
    cursor: pointer;
  }
  .menu-icon {
    position: relative;
    width: 18px;
    height: 12px;
  }
  .menu-icon span {
    position: absolute;
    left: 0;
    width: 100%;
    height: 2px;
    background: currentColor;
    transition: transform 0.2s ease, top 0.2s ease;
  }
  .menu-icon span:first-child {
    top: 0;
  }
  .menu-icon span:last-child {
    top: 100%;
    transform: translateY(-100%);
  }
  .site-header[data-menu-open='true'] .menu-icon span:first-child {
    top: 50%;
    transform: translateY(-50%) rotate(45deg);
  }
  .site-header[data-menu-open='true'] .menu-icon span:last-child {
    top: 50%;
    transform: translateY(-50%) rotate(-45deg);
  }

  /* Mobile nav panel (revealed below the bar when the toggle is open) */
  .mobile-nav {
    display: none;
    flex-direction: column;
    gap: 20px;
    padding-block: 24px 28px;
  }
  .site-header[data-menu-open='true'] .mobile-nav {
    display: flex;
    border-top: 1px solid var(--line);
  }
  .mobile-nav-link {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0;
    text-transform: uppercase;
    color: var(--muted);
  }
  .mobile-nav-link.active {
    color: #0ea5e9;
  }

  @media (max-width: 830px) {
    .bar {
      grid-template-columns: auto 1fr;
      column-gap: 16px;
    }
    .bar-right {
      justify-content: flex-end;
    }
    .nav {
      display: none;
    }
    .menu-toggle {
      display: flex;
    }
  }
</style>
