---
// A phone-shaped rounded screen, centred in the visible viewport. No bezel or
// status bar: just the #f5f5f5 screen with whatever is slotted filling it.
---

<div class="phone-stage" data-phone-stage>
	<div class="phone">
		<slot />
	</div>
</div>

<style>
	/* The page itself never scrolls: everything lives in the fixed stage. With
	   nothing to scroll, iOS can't shove the page around when the keyboard
	   opens, and the 100lvh sheet can't run under a bottom address bar. */
	:global(html:has(.phone-stage)),
	:global(body:has(.phone-stage)) {
		height: 100%;
		overflow: hidden;
		overscroll-behavior: none;
	}

	/* The white sheet keeps its full height (it's what paints the page white)
	   but drops its clip-path: a clip-path clips even fixed descendants, so
	   the phone vanished wherever the sheet didn't reach. */
	:global(.site-canvas:has(.phone-stage)) {
		clip-path: none;
	}

	/* Covers the *visible* part of the screen. Mobile browsers shrink only the
	   visual viewport for the keyboard (Safari, and Chrome by default), so a
	   plain `inset: 0` left the phone, and its input, under the keys. The
	   script below feeds in the visual viewport's height and offset; without
	   it (or before it runs) this is the dynamic viewport. */
	.phone-stage {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: var(--vv-h, 100dvh);
		transform: translateY(var(--vv-top, 0px));
		container-type: size;
		display: flex;
		justify-content: center;
		align-items: flex-start;
		/* Only a small gap under the phone: that's all there is between it and
		   an open keyboard. With no keyboard the phone is centred by its own
		   top margin, which already keeps it clear of the bottom bars. */
		padding: 0 16px 16px;
	}

	/* Sized like posh.vip's phone: 330×697 at most, with a 47px radius, and
	   shrinking as a whole to fit the screen (proportions and corner kept).
	   Only the frame scales; the chat inside keeps its own type and bubble
	   sizes.

	   Everything but the height comes from `svh`, the screen's height with the
	   browser's bars showing, which a keyboard never changes. So with the
	   keyboard up the phone keeps its width, corners and top edge, and only
	   its bottom edge moves up to sit above the keys. */
	.phone {
		/* Room under the phone with no keyboard: clears the home indicator and
		   floating bottom bars (viewport-fit=cover is set in BaseLayout). */
		--phone-gap-bottom: max(32px, env(safe-area-inset-bottom) + 16px);
		/* The -lock values are measured by the script while no field is
		   focused and held while one is. Chrome on iOS shrinks its whole web
		   view for the keyboard, svh and vw included, so the units alone
		   still narrowed the phone there. */
		--phone-w: var(
			--phone-w-lock,
			min(330px, 100vw - 32px, (100svh - 32px - var(--phone-gap-bottom)) * 330 / 697)
		);
		--phone-full-h: calc(var(--phone-w) * 697 / 330);
		/* Centred on the keyboard-less screen, at least 32px down. */
		--phone-top: var(--phone-top-lock, max(32px, (100svh - var(--phone-full-h)) / 2));
		width: var(--phone-w);
		margin-top: var(--phone-top);
		/* cqh: the visible area (above any keyboard) inside the stage's padding. */
		height: min(var(--phone-full-h), 100cqh - var(--phone-top));
		/* Read by the chat too, to keep its scrollbar off the curved corners. */
		--phone-radius: calc(var(--phone-w) * 47 / 330);
		border-radius: var(--phone-radius);
		/* No padding: the chat runs edge to edge (so its scrollbar sits on the
		   phone's edge) and insets its own content. */
		background: #f5f5f5;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.04);
		overflow: hidden;
	}
</style>

<script>
	// Keep the stage on the visual viewport: the part of the page actually on
	// screen, above the keyboard and between the browser's bars.
	const stage = document.querySelector<HTMLElement>("[data-phone-stage]");
	const vv = window.visualViewport;

	if (stage && vv) {
		let frame = 0;
		const sync = () => {
			frame = 0;
			stage.style.setProperty("--vv-h", `${vv.height}px`);
			stage.style.setProperty("--vv-top", `${vv.offsetTop}px`);
			// Keyboard closed again: undo any scroll iOS made to reveal the
			// input, so the page is back where it started.
			if (vv.height >= window.innerHeight - 1 && (window.scrollY || document.documentElement.scrollTop)) {
				window.scrollTo(0, 0);
			}
		};
		const schedule = () => {
			if (!frame) frame = requestAnimationFrame(sync);
		};
		vv.addEventListener("resize", schedule);
		// Straight away, not on the next frame: any pan Safari still makes is
		// matched in the same frame it shows, instead of one frame late.
		vv.addEventListener("scroll", () => {
			cancelAnimationFrame(frame);
			sync();
		});
		sync();
	}

	/* Hold the page still when a text field is tapped. iOS Safari scrolls the
	   page to "reveal" a focused field, even with scrolling locked, and the
	   phone was seen to jump up and then slide back as the stage caught up.
	   That reveal isn't needed here (the phone already shortens to keep the
	   field above the keyboard), so on touch screens the tap is taken over
	   and the field focused with preventScroll. The keyboard still opens:
	   it's a focus from the tap's own touchend. */
	if (stage && window.matchMedia("(pointer: coarse)").matches) {
		let start: { x: number; y: number } | null = null;
		stage.addEventListener(
			"touchstart",
			(event) => {
				const t = event.touches[0];
				start = t ? { x: t.clientX, y: t.clientY } : null;
			},
			{ passive: true },
		);
		stage.addEventListener("touchend", (event) => {
			const field = (event.target as Element | null)?.closest<HTMLInputElement | HTMLTextAreaElement>("input, textarea");
			if (!field || document.activeElement === field || !start) return;
			// A drag that began on the field isn't a tap.
			const t = event.changedTouches[0];
			if (t && Math.hypot(t.clientX - start.x, t.clientY - start.y) > 10) return;
			event.preventDefault();
			field.focus({ preventScroll: true });
		});
		// Backstop: should the page still get scrolled while a field is
		// focused, put it straight back.
		window.addEventListener(
			"scroll",
			() => {
				if (window.scrollY || document.documentElement.scrollTop) window.scrollTo(0, 0);
			},
			{ passive: true },
		);
	}

	// Hold the phone's width and top edge steady while typing. They're
	// measured from the CSS whenever no text field is focused (load, resize,
	// rotation, the keyboard closing) and frozen while one is, since some
	// browsers (Chrome on iOS) shrink the whole viewport for the keyboard.
	const phone = stage?.querySelector<HTMLElement>(".phone");
	if (phone) {
		const typing = () => {
			const el = document.activeElement;
			return el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || (el as HTMLElement | null)?.isContentEditable === true;
		};
		let lockFrame = 0;
		const lock = () => {
			lockFrame = 0;
			if (typing()) return;
			phone.style.removeProperty("--phone-w-lock");
			phone.style.removeProperty("--phone-top-lock");
			const cs = getComputedStyle(phone);
			phone.style.setProperty("--phone-w-lock", cs.width);
			phone.style.setProperty("--phone-top-lock", cs.marginTop);
		};
		const scheduleLock = () => {
			if (!lockFrame) lockFrame = requestAnimationFrame(lock);
		};
		window.addEventListener("resize", scheduleLock);
		window.visualViewport?.addEventListener("resize", scheduleLock);
		// Keyboard closing: re-measure once it has had time to go.
		document.addEventListener("focusout", () => setTimeout(scheduleLock, 400));
		lock();
	}
</script>
