---
// A phone-shaped rounded screen, centred in the visible viewport. No bezel or
// status bar: just the #f5f5f5 screen with whatever is slotted filling it.
---

<div class="phone-stage" data-phone-stage>
	<div class="phone">
		<slot />
	</div>
</div>

<style>
	/* The page itself never scrolls: everything lives in the fixed stage. With
	   nothing to scroll, iOS can't shove the page around when the keyboard
	   opens, and the 100lvh sheet can't run under a bottom address bar. */
	:global(html:has(.phone-stage)),
	:global(body:has(.phone-stage)) {
		height: 100%;
		overflow: hidden;
		overscroll-behavior: none;
	}

	/* The white sheet keeps its full height (it's what paints the page white)
	   but drops its clip-path: a clip-path clips even fixed descendants, so
	   the phone vanished wherever the sheet didn't reach. */
	:global(.site-canvas:has(.phone-stage)) {
		clip-path: none;
	}

	/* Pinned to the top of the visible screen. iOS can scroll the page to
	   "reveal" a focused field even with scrolling locked; the script moves
	   the stage by that much (--vv-top) so the phone doesn't budge. */
	.phone-stage {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		height: 100svh;
		transform: translateY(var(--vv-top, 0px));
		display: flex;
		justify-content: center;
		align-items: flex-start;
		padding: 0 16px;
	}

	/* Sized like posh.vip's phone: 330×697 at most, with a 47px radius, and
	   shrinking as a whole to fit the screen (proportions and corner kept).
	   Only the frame scales; the chat inside keeps its own type and bubble
	   sizes.

	   The keyboard never moves or resizes the grey phone: its width, height
	   and top are measured by the script while no field is focused and held
	   (the -lock values) while one is. Chrome on iOS shrinks its whole web
	   view for the keyboard, svh and vw included, so CSS units alone can't
	   hold it there. What the keyboard does change is --kb-inset: how far it
	   covers the phone. That becomes bottom padding, so the chat inside ends
	   above the keys and the compose field rides up with it. */
	.phone {
		/* Room under the phone: clears the home indicator and floating bottom
		   bars (viewport-fit=cover is set in BaseLayout). */
		--phone-gap-bottom: max(32px, env(safe-area-inset-bottom) + 16px);
		--phone-w: var(
			--phone-w-lock,
			min(330px, 100vw - 32px, (100svh - 32px - var(--phone-gap-bottom)) * 330 / 697)
		);
		--phone-full-h: calc(var(--phone-w) * 697 / 330);
		/* Centred on the screen, at least 32px down. */
		--phone-top: var(--phone-top-lock, max(32px, (100svh - var(--phone-full-h)) / 2));
		width: var(--phone-w);
		height: var(--phone-h-lock, var(--phone-full-h));
		margin-top: var(--phone-top);
		padding-bottom: var(--kb-inset, 0px);
		/* Read by the chat too, to keep its scrollbar off the curved corners. */
		--phone-radius: calc(var(--phone-w) * 47 / 330);
		border-radius: var(--phone-radius);
		/* No side or top padding: the chat runs edge to edge (so its scrollbar
		   sits on the phone's edge) and insets its own content. */
		background: #f5f5f5;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.04);
		overflow: hidden;
	}
</style>

<script>
	const stage = document.querySelector<HTMLElement>("[data-phone-stage]");
	const phone = stage?.querySelector<HTMLElement>(".phone");
	const vv = window.visualViewport;

	// Gap kept between the compose field and the top of the keyboard. The chat
	// already sits its field FORM_INSET up from its own bottom (AskMe's
	// --screen-pad), so the chat's bottom may tuck that much behind the keys.
	const INPUT_GAP = 12;
	const FORM_INSET = 20;

	if (stage && phone) {
		const typing = () => {
			const el = document.activeElement;
			return el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || (el as HTMLElement | null)?.isContentEditable === true;
		};

		/** Measure the phone from the CSS and hold it, unless a field is focused. */
		const lock = () => {
			if (typing()) return;
			for (const prop of ["--phone-w-lock", "--phone-h-lock", "--phone-top-lock"]) phone.style.removeProperty(prop);
			const cs = getComputedStyle(phone);
			phone.style.setProperty("--phone-w-lock", cs.width);
			phone.style.setProperty("--phone-h-lock", cs.height);
			phone.style.setProperty("--phone-top-lock", cs.marginTop);
		};

		/** Follow the visible area: keep the stage still and lift the chat over the keyboard. */
		const follow = () => {
			const visibleH = vv ? vv.height : window.innerHeight;
			stage.style.setProperty("--vv-top", `${vv ? vv.offsetTop : 0}px`);
			// The stage starts at the top of the visible area, so this is where
			// the phone's bottom edge sits in it.
			const phoneBottom = phone.offsetTop + phone.offsetHeight;
			const overlap = typing() ? Math.max(0, phoneBottom - visibleH - FORM_INSET + INPUT_GAP) : 0;
			phone.style.setProperty("--kb-inset", `${overlap}px`);
			// Keyboard closed again: undo any scroll iOS made to reveal the
			// input, so the page is back where it started.
			if (!typing() && (window.scrollY || document.documentElement.scrollTop)) window.scrollTo(0, 0);
		};

		let frame = 0;
		const update = () => {
			if (frame) return;
			frame = requestAnimationFrame(() => {
				frame = 0;
				lock();
				follow();
			});
		};

		window.addEventListener("resize", update);
		vv?.addEventListener("resize", update);
		vv?.addEventListener("scroll", update);
		document.addEventListener("focusin", update);
		// Keyboard closing: settle once it has had time to go.
		document.addEventListener("focusout", () => {
			update();
			setTimeout(update, 400);
		});
		lock();
		follow();
	}
</script>
