---
// A phone-shaped rounded screen, centred in the visible viewport. No bezel or
// status bar: just the #f5f5f5 screen with whatever is slotted filling it.
---

<div class="phone-stage">
	<div class="phone">
		<slot />
	</div>
</div>

<style>
	/* Pinned to the visible viewport rather than laid out in the page's white
	   sheet (100lvh tall), so the phone stays dead centre as the window resizes
	   and as mobile browser bars show and hide. */
	.phone-stage {
		position: fixed;
		inset: 0;
		display: grid;
		place-items: center;
		padding: 32px 16px;
	}

	/* Sized like posh.vip's phone: 330×697 at most, with a 47px radius, and
	   shrinking as a whole to fit the window (proportions and corner kept).
	   Only the frame scales; the chat inside keeps its own type and bubble
	   sizes. */
	.phone {
		--phone-h: min(697px, 100dvh - 64px, (100vw - 32px) * 697 / 330);
		height: var(--phone-h);
		width: calc(var(--phone-h) * 330 / 697);
		/* Read by the chat too, to keep its scrollbar off the curved corners. */
		--phone-radius: calc(var(--phone-h) * 47 / 697);
		border-radius: var(--phone-radius);
		/* No padding: the chat runs edge to edge (so its scrollbar sits on the
		   phone's edge) and insets its own content. */
		background: #f5f5f5;
		box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.04);
		overflow: hidden;
	}
</style>
