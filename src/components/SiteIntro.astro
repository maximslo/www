---
import {
	EXTERNAL_LINK_ARROW,
	INTRO_LINKS,
	INTRO_NAME,
	INTRO_PARAGRAPHS,
	INTRO_ROLE_LINES,
} from "../config/intro";
import { toLinkSegments } from "../lib/link-segments";
import IntroDirectory from "./IntroDirectory.astro";

const paragraphs = INTRO_PARAGRAPHS.map((paragraph) => toLinkSegments(paragraph, INTRO_LINKS));

// A literal "\n" in intro copy is a deliberate hard break — e.g. inside the
// "first agents" link — rather than a natural wrap, which shifts with width.
// It's suppressed below 768px (see .intro-break in <style>): the narrow column
// already wraps there on its own, and forcing the break too strands "first"
// alone on its line instead of matching the wider layout's intent.
const splitLines = (text: string) => text.split("\n");
---

<div class="site-intro">
	<header class="intro-header">
		<p>{INTRO_NAME}</p>
		<p class="intro-role">{INTRO_ROLE_LINES.join(" ")}</p>
	</header>

	<section class="intro-about">
		{
			paragraphs.map((segments) => (
				<p>
					{/* Anchor, marker and the following punctuation are kept on one line:
					    a newline between them becomes a rendered space, which would
					    underline a gap and push the arrow and the sentence's period away
					    from the link text. */}
					{segments.map((segment) =>
						// prettier-ignore
						segment.href ? <><a class="link" href={segment.href} target="_blank" rel="noopener noreferrer">{splitLines(segment.text).map((line, index) => (index === 0 ? line : <><br class="intro-break" />{line}</>))}</a><sup class="marker-arrow">{EXTERNAL_LINK_ARROW}</sup></> : splitLines(segment.text).map((line, index) => (index === 0 ? line : <><br class="intro-break" />{line}</>))
					)}
				</p>
			))
		}
	</section>

	<IntroDirectory />
</div>

<style>
	.site-intro {
		display: flex;
		flex-direction: column;
		/* Shared by .intro-about and .intro-directory (in IntroDirectory.astro)
		   so the two gaps between the three sections always match. */
		--section-gap: 32px;
	}

	.intro-role {
		color: var(--color-text-secondary);
	}

	.intro-about {
		margin-top: var(--section-gap);
	}

	.intro-about p + p {
		margin-top: 20px;
	}

	.intro-break {
		display: none;
	}

	@media (width >= 768px) {
		.site-intro {
			--section-gap: 40px;
		}

		.intro-about p + p {
			margin-top: 24px;
		}

		.intro-break {
			display: inline;
		}
	}

	@media (width >= 1024px) {
		.site-intro {
			grid-column: 6 / 12;
			grid-row-start: 1;
			--section-gap: 56px;
		}
	}
</style>
