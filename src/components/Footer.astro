---
// Footer modeled on joseph.cv: a sticky "reveal" footer (pinned behind the page,
// uncovered as you scroll to the bottom) with a version pill + last-updated on the
// left, a link list in the middle, and a contact CTA on the right, over a dot grid.
const footerLinks = [
	{ label: "GitHub", href: "https://github.com/maximslo" },
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/maximslo/" },
	{ label: "Resume", href: "/resume.pdf" },
];

const version = "v3.0.0";
const updated = "August 2026";
---

<footer class="site-footer">
	<div class="wrap">
		<div class="footer-grid grid">
			<div class="meta-col">
				<div class="meta-row">
					<span class="version">{version}</span>
					<span class="updated">Last updated {updated}</span>
				</div>
				<div class="theme-toggle" role="group" aria-label="Color theme">
					<button type="button" data-theme-set="light">Light</button>
					<span class="toggle-sep">/</span>
					<button type="button" data-theme-set="dark">Dark</button>
				</div>
			</div>

			<div class="footer-links">
				{
					footerLinks.map((l) => (
						<p>
							<a class="link" target="_blank" rel="noreferrer" href={l.href}>
								{l.label}
							</a>
							<sup class="arrow">↗</sup>
						</p>
					))
				}
			</div>

			<div class="cta-col">
				<p class="cta">Let's build something together.</p>
				<p>
					<a class="link" href="mailto:maximsloe@gmail.com">maximsloe@gmail.com</a>
					<sup class="arrow">↗</sup>
				</p>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		position: sticky;
		bottom: 0;
		z-index: 0;
		/* Footer has its own shade, distinct from the page background. */
		background-color: var(--footer-bg);
		color: var(--footer-fg);
	}

	.footer-grid {
		padding: 1.5rem 0 3.5rem;
		row-gap: 2rem;
		align-items: start;
	}

	.meta-col {
		grid-column: span 12;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.meta-row {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 0.6rem;
	}

	.theme-toggle {
		font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.theme-toggle button {
		font: inherit;
		background: none;
		border: none;
		padding: 0;
		cursor: pointer;
		color: var(--footer-muted);
		transition: color 0.2s ease;
	}

	.theme-toggle button:hover {
		color: var(--footer-fg);
	}

	.theme-toggle button[aria-pressed="true"] {
		color: var(--accent);
	}

	.toggle-sep {
		color: var(--footer-muted);
		opacity: 0.5;
	}

	.footer-links {
		grid-column: span 12;
	}

	.cta-col {
		grid-column: span 12;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.footer-links p,
	.cta-col p {
		margin: 0;
	}

	.version {
		font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 12px;
		font-weight: 300;
		text-transform: lowercase;
		color: var(--accent);
		border: 1px solid var(--accent);
		border-radius: 999px;
		padding: 3px 9px 2px;
		line-height: 1;
		width: max-content;
	}

	.updated {
		font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 12px;
		font-weight: 300;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--footer-muted);
	}

	.cta {
		color: var(--footer-fg);
	}

	@media (min-width: 768px) {
		.meta-col {
			grid-column: 1 / 6;
		}

		.footer-links {
			grid-column: 7 / 9;
		}

		.cta-col {
			grid-column: 9 / 13;
		}
	}
</style>

<script>
	// Light/dark toggle. The initial theme is applied in <head> before paint;
	// this just wires the buttons, persists the choice, and reflects the state.
	const root = document.documentElement;
	const buttons = document.querySelectorAll<HTMLButtonElement>(
		".theme-toggle button[data-theme-set]",
	);

	function sync() {
		const current = root.getAttribute("data-theme") || "dark";
		buttons.forEach((b) =>
			b.setAttribute("aria-pressed", String(b.dataset.themeSet === current)),
		);
	}

	buttons.forEach((b) =>
		b.addEventListener("click", () => {
			const theme = b.dataset.themeSet;
			if (!theme) return;
			root.setAttribute("data-theme", theme);
			try {
				localStorage.setItem("theme", theme);
			} catch (e) {}
			sync();
		}),
	);

	sync();
</script>
