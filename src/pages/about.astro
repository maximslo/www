---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About — Your Name">
  <section class="container about">
    <p class="lead">
      I'm a <em>designer, builder, & dancer</em>—optimizing for fun.
    </p>
    <p class="body">
      Placeholder bio paragraph. Lorem ipsum dolor sit amet, consectetur
      adipiscing elit. Add a couple of sentences on what you're exploring right
      now and how to reach you.
    </p>

    <div class="section">
      <h2 class="mono">Designer</h2>
      <p>Placeholder. Replace with a short note + a few photos.</p>
    </div>
  </section>
</BaseLayout>

<style>
  .about {
    max-width: 820px;
    margin-inline: auto;
    padding-block: 96px 20px;
  }
  .lead {
    font-size: var(--fs-xl);
    line-height: 1.35;
    max-width: 30ch;
    margin-bottom: 24px;
  }
  .lead em {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 1.12em;
  }
  .body {
    color: var(--muted);
    max-width: 60ch;
  }
  .section {
    margin-top: 56px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .section h2 {
    color: var(--faint);
    margin-bottom: 8px;
    font-weight: 500;
  }
  .section p {
    color: var(--muted);
  }
</style>
