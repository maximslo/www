---
import { getCollection, render } from "astro:content";
import ProjectLayout from "../../layouts/ProjectLayout.astro";

export async function getStaticPaths() {
	const entries = await getCollection("work", ({ data }) => !data.draft && !data.external);
	return entries.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, date, lede, media, url } = entry.data;
const urlText = url?.replace(/^https?:\/\//, "").replace(/\/$/, "");

const ogImage = media.type === "video" ? media.poster : media.src;
const formattedDate = date.toLocaleDateString("en-US", {
	timeZone: "UTC",
	year: "numeric",
	month: "long",
	day: "numeric",
});
---

<ProjectLayout title={title} description={lede} ogImage={ogImage}>
	<article>
		<header class="head">
			<div class="titlerow">
				<h1>{title}</h1>
				<span class="date">{formattedDate}</span>
			</div>
			<div class="role">
				<span>{lede}</span>
				{url && <a class="live" href={url}>{urlText}</a>}
			</div>
		</header>

		<div class="prose">
			<Content />
		</div>
	</article>

	<style>
		.titlerow {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 0.75rem;
		}
		.head h1 {
			font-size: 0.95rem;
			font-weight: 500;
			line-height: 1.2;
			margin: 0;
		}
		.date {
			color: var(--label);
			font-size: 0.7rem;
			flex-shrink: 0;
			text-align: right;
		}
		.live {
			color: var(--link);
			font-size: 0.7rem;
			flex-shrink: 0;
			white-space: nowrap;
			text-decoration: none;
		}
		.live:hover {
			opacity: 0.7;
		}
		.role {
			display: flex;
			align-items: baseline;
			justify-content: space-between;
			gap: 0.75rem;
			color: var(--label);
			font-size: 0.7rem;
			line-height: 1.5;
			margin: 0.25rem 0 0;
			padding-bottom: var(--space-item);
			border-bottom: 1px dashed var(--rule);
		}
		.prose {
			margin-top: var(--space-section);
			font-size: 0.7rem;
			line-height: 1.7;
		}
		/* rendered Markdown isn't scoped, so target it with :global() */
		.prose :global(p) {
			margin: 0 0 0.85rem;
		}
		.prose :global(:last-child) {
			margin-bottom: 0;
		}
		.prose :global(h2),
		.prose :global(h3) {
			font-size: 0.8rem;
			font-weight: 500;
			line-height: 1.3;
			margin: var(--space-section) 0 0.5rem;
		}
		.prose :global(a) {
			color: var(--ink);
			text-decoration: underline;
			text-underline-offset: 3px;
		}
		.prose :global(a:hover) {
			opacity: 0.6;
		}
		.prose :global(ul),
		.prose :global(ol) {
			margin: 0 0 0.85rem;
			padding-left: 1.1rem;
		}
		.prose :global(li) {
			margin: 0 0 0.25rem;
		}
		.prose :global(blockquote) {
			margin: 0 0 0.85rem;
			padding-left: 0.8rem;
			border-left: 2px solid var(--rule);
			color: var(--label);
		}
		.prose :global(code) {
			font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
			font-size: 0.92em;
		}
		.prose :global(pre) {
			padding: 0.8rem;
			border: 1px dashed var(--rule);
			overflow-x: auto;
			margin: 0 0 0.85rem;
		}
		.prose :global(img) {
			display: block;
			width: 100%;
			height: auto;
			margin: var(--space-item) 0;
			border: 1px solid var(--thumb-border);
		}
		.prose :global(hr) {
			border: 0;
			border-top: 1px dashed var(--rule);
			margin: var(--space-section) 0;
		}
	</style>
</ProjectLayout>
