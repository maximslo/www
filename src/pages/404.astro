---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
---

<BaseLayout
	title="404 — Maxim Slobodchikov"
	description="That page doesn't exist. Head back to the library."
>
	<div class="page-shell">
		<Nav />
		<main class="main-shell">
			<div class="wrap">
				{/*
					Same shell as the home page — Nav, then a .hero on the shared
					.nav-aligned-grid — so the caption and copy land on the exact column
					lines the nav sits on. Only the About column is kept; there's no
					Teams/Links pair or work grid to align against here.
				*/}
				<section class="hero grid nav-aligned-grid">
					<div class="about-col">
						<p class="caption">404</p>
						<p class="about-text">
							Page not found.
						</p>
					</div>
				</section>
			</div>
			<p class="notfound-number" aria-hidden="true">404</p>
		</main>
	</div>
</BaseLayout>

<style>
	/* Mirrors index.astro's hero so the 404 sits at the same height as home. */
	.hero {
		padding: 2rem 0 0.75rem;
		row-gap: 1.75rem;
	}

	/* Nav's height isn't a known constant (it varies with the responsive
	   font-size bump and whether "New York, NY" is showing), so getting the
	   page to fill the window exactly — not 100vh of main PLUS Nav on top,
	   which overshoots and forces a scroll — means letting flex measure Nav
	   itself rather than guessing its height in a calc(). */
	.page-shell {
		display: flex;
		flex-direction: column;
		min-height: 100vh;
	}

	/* <main> itself (not a .wrap div) is the flex item here, specifically so
	   it has no margin:auto centering of its own — cross-axis auto margins
	   take priority over flex stretch, so a flex item WITH them shrinks to
	   fit its content instead of filling the row, which clipped
	   .notfound-number's sides against that narrower box. The hero content's
	   usual max-width/centering now lives on a plain .wrap div nested
	   inside, which — as an ordinary block, not a flex item — centers the
	   same way it always has.
	   flex:1 1 auto (not another min-height:100vh) is what makes main fill
	   exactly the space Nav leaves behind, so the page fits the window with
	   no extra scroll. Position/overflow here give .notfound-number a
	   clipped box that ends where main ends — i.e. above the footer —
	   rather than filling the whole viewport the way position:fixed did.
	   That old approach stayed glued to the screen on scroll, so once the
	   sticky footer scrolled into view the number (in .page's stacking
	   context, above the footer's) painted right over it. */
	.main-shell {
		flex: 1 1 auto;
		min-height: 0;
		position: relative;
		overflow: hidden;
	}

	.about-col {
		grid-column: span 12;
	}

	/* Same 630px breakpoint and column span the home page's About column uses. */
	@media (min-width: 630px) {
		.about-col {
			grid-column: 1 / 7;
			padding-right: clamp(6rem, 10vw, 10rem);
		}
	}

	/* Huge decorative "404" parked on the bottom edge of main, sized past
	   its box on purpose — bottom is a negative offset (not 0) specifically
	   so part of the glyphs get cropped by main's overflow:hidden. */
	.notfound-number {
		position: absolute;
		left: 0;
		right: 0;
		bottom: -0.22em;
		margin: 0;
		text-align: center;
		font-family: var(--font-mono);
		font-size: clamp(10rem, 45vw, 34rem);
		line-height: 1;
		font-weight: 400;
		color: var(--muted);
		pointer-events: none;
		z-index: -1;
	}
</style>
