---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Your Name">
	<header class="intro">
		<h1>Your Name</h1>
		<p class="muted">
			One line about you — what you build and what you're into.
		</p>
		<p class="links">
			<a href="https://linkedin.com/in/maximslo">linkedin</a>
			<a href="https://github.com/maximslo">github</a>
			<a href="https://strava.app.link/iaJoaMXRwOb">strava</a>
		</p>
	</header>

	<style>
		.intro h1 {
			margin-bottom: 0.75rem;
		}
		.intro .muted {
			margin: 0 0 1.75rem;
		}
		.links {
			font-size: 0.9rem;
		}
		.links a {
			margin-right: 1rem;
			color: var(--muted);
			text-decoration: none;
		}
		.links a::before {
			content: "↗";
			margin-right: 0.3rem;
			font-size: 1.15em;
			font-weight: 400;
			vertical-align: -0.11em;
		}
		.links a:hover {
			color: var(--fg);
		}
	</style>
</BaseLayout>
