---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const meta = [
  { label: 'Role', value: data.role },
  { label: 'Timeline', value: data.timeline },
  { label: 'Team', value: data.team },
  { label: 'Skills', value: data.skills.join(', ') },
];
---

<BaseLayout title={`${data.title} — Your Name`} description={data.title}>
  <article class="container project">
    <a href="/" class="back mono">← Back</a>

    <header class="project-head">
      <p class="eyebrow mono">
        {data.company} • {data.status} {data.year}
      </p>
      <h1 class="project-title">{data.title}</h1>

      <dl class="meta">
        {
          meta.map((m) => (
            <div class="meta-item">
              <dt class="mono">{m.label}</dt>
              <dd>{m.value}</dd>
            </div>
          ))
        }
      </dl>
    </header>

    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .project {
    max-width: 820px;
    margin-inline: auto;
    padding-block: 48px;
  }

  .back {
    display: inline-block;
    color: var(--muted);
    margin-bottom: 40px;
    transition: color 0.15s ease;
  }
  .back:hover {
    color: var(--fg);
  }

  .eyebrow {
    color: var(--muted);
    margin-bottom: 12px;
  }

  .project-title {
    font-family: var(--font-serif);
    font-size: 2.75rem;
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px 24px;
    padding-block: 24px;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .meta-item dt {
    color: var(--faint);
    margin-bottom: 4px;
  }

  .meta-item dd {
    font-size: var(--fs-sm);
  }

  /* Body content rendered from MDX */
  .prose {
    margin-top: 48px;
  }

  .prose :global(h2) {
    font-size: var(--fs-xl);
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-top: 56px;
    margin-bottom: 12px;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    color: var(--muted);
    margin-bottom: 20px;
    max-width: 62ch;
  }

  .prose :global(img) {
    border: 1px solid var(--line);
    border-radius: 8px;
    margin-block: 28px;
    width: 100%;
  }

  @media (max-width: 480px) {
    .meta {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .project-title {
      font-size: 1.6rem;
    }
  }
</style>
