---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);

const sections = headings.filter((h) => h.depth === 2);
const hasMedia = Boolean(data.video || data.image);
const ratio = data.ratio ?? '16 / 9';

const meta = [
  { label: 'Role', values: [data.role] },
  { label: 'Timeline', values: [data.timeline] },
  { label: 'Team', values: [data.team] },
  { label: 'Skills', values: data.skills },
];
---

<BaseLayout title={`${data.title} — Your Name`} description={data.title}>
  <div class="container">
    <div class="project-grid">
      <aside class="side">
        <a href="/" class="back mono">
          <svg class="back-arrow" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20z" />
          </svg>
          Back
        </a>

        {
          sections.length > 0 && (
            <nav class="toc" aria-label="Sections">
              {sections.map((h) => (
                <a href={`#${h.slug}`} class="toc-link">
                  {h.text}
                </a>
              ))}
            </nav>
          )
        }
      </aside>

      <article class="project">
        <header class="project-head">
          <p class="eyebrow mono">
            {data.company} • {data.status} {data.year}
          </p>
          <h1 class="project-title">{data.title}</h1>
        </header>

        {
          hasMedia && (
            <div class="hero-media" style={`aspect-ratio:${ratio}`}>
              {data.video ? (
                <video
                  class="hero-media-el"
                  src={data.video}
                  autoplay
                  loop
                  muted
                  playsinline
                  preload="metadata"
                />
              ) : (
                <img class="hero-media-el" src={data.image} alt={data.title} />
              )}
            </div>
          )
        }

        <dl class="meta">
          {
            meta.map((m) => (
              <div class="meta-item">
                <dt class="mono">{m.label}</dt>
                <dd>
                  {m.values.map((v) => (
                    <p>{v}</p>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="prose">
          <Content />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<script>
  // Highlight whichever section heading is currently in view
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
  const sections = Array.from(links)
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((el): el is HTMLElement => Boolean(el));

  if (sections.length && links.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = entry.target.id;
          links.forEach((link) => link.classList.toggle('active', link.hash === `#${id}`));
        }
      },
      { rootMargin: '-10% 0px -75% 0px' }
    );
    sections.forEach((section) => observer.observe(section));
  }
</script>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding-block: 48px 96px;
  }

  /* ---- Sidebar: back link + section TOC ---- */
  .side {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-lg);
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .back:hover {
    color: var(--fg);
  }
  .back-arrow {
    flex-shrink: 0;
  }

  .toc {
    display: none;
    flex-direction: column;
    gap: 4px;
  }
  .toc-link {
    font-size: var(--fs-lg);
    color: var(--faint);
    transition: color 0.15s ease;
  }
  .toc-link:hover {
    color: var(--fg);
  }
  .toc-link.active {
    color: var(--fg);
  }

  /* ---- Main column ---- */
  .project {
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-width: 0;
  }

  .project-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .eyebrow {
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .project-title {
    font-family: var(--font-serif);
    font-size: 3.25rem;
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .hero-media {
    position: relative;
    width: 100%;
    border: 1px solid var(--line);
    overflow: hidden;
    box-sizing: border-box;
  }
  .hero-media-el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: -16px;
    padding-block: 24px;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .meta-item dt {
    font-size: var(--fs-sm);
    text-transform: uppercase;
    color: var(--faint);
  }

  .meta-item dd p {
    font-size: var(--fs-m);
    color: var(--faint);
  }

  /* Body content rendered from MDX (flat h2/p/img siblings).
     h2 is the anchored section name (TOC label) — reference styles this as a
     small mono/uppercase eyebrow, not a big heading. h3/h4 are for an optional
     bigger serif statement + smaller grouped sub-point within that section. */
  .prose :global(h2) {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--faint);
    margin-top: 40px;
    margin-bottom: 20px;
    scroll-margin-top: 32px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-top: 4px;
    margin-bottom: 4px;
  }

  .prose :global(h4) {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-top: 32px;
    margin-bottom: 4px;
  }

  /* Optional multi-column grid — wrap items in
     <div class="cols"><div>...</div>...</div> inside mdx content to use it.
     Works for h4/p sub-points, images, or a mix; columns split evenly
     across however many direct children are given. */
  .prose :global(.cols) {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    column-gap: 12px;
    margin-top: 24px;
  }
  .prose :global(.cols h4) {
    margin-top: 0;
  }
  .prose :global(.cols p) {
    margin-bottom: 0;
  }
  .prose :global(.cols img) {
    margin-block: 0;
  }

  @media (max-width: 600px) {
    .prose :global(.cols) {
      grid-auto-flow: row;
      grid-auto-columns: unset;
      grid-template-columns: 1fr;
      row-gap: 24px;
    }
  }

  .prose :global(p) {
    font-size: var(--fs-base);
    color: var(--muted);
    margin-bottom: 20px;
    max-width: 62ch;
  }

  .prose :global(img) {
    margin-block: 28px;
    width: 100%;
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: 220px minmax(0, 1fr);
      column-gap: 64px;
    }
    .side {
      grid-column: 1;
      position: sticky;
      top: 32px;
      height: fit-content;
    }
    .project {
      grid-column: 2;
      max-width: 676px;
    }
    .toc {
      display: flex;
    }
    .meta {
      flex-direction: row;
      gap: 48px;
    }
    .meta-item {
      flex: 1 1 0;
    }
  }

  /* Only once the container is comfortably wider than sidebar + content + gaps
     do we switch to the symmetric 1fr/content/1fr centering used at desktop widths */
  @media (min-width: 1280px) {
    .project-grid {
      grid-template-columns: minmax(220px, 1fr) minmax(0, 896px) 1fr;
      column-gap: 160px;
    }
    .project {
      max-width: 788px;
    }
  }

  @media (max-width: 480px) {
    .project-title {
      font-size: 1.9rem;
    }
  }
</style>
