---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);

const sections = headings.filter((h) => h.depth === 2);
const hasMedia = Boolean(data.video || data.image);
const ratio = data.ratio ?? '16 / 9';

const meta = [
  { label: 'Role', values: [data.role] },
  { label: 'Timeline', values: [data.timeline] },
  { label: 'Team', values: [data.team] },
  { label: 'Skills', values: data.skills },
];
---

<BaseLayout title={`${data.title} — Your Name`} description={data.title}>
  <div class="container">
    <div class="project-grid">
      <aside class="side">
        <a href="/" class="back mono">
          <svg class="back-arrow" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20z" />
          </svg>
          Back
        </a>

        {
          sections.length > 0 && (
            <nav class="toc" aria-label="Sections">
              {sections.map((h) => (
                <a href={`#${h.slug}`} class="toc-link">
                  {h.text}
                </a>
              ))}
            </nav>
          )
        }
      </aside>

      <article class="project">
        <header class="project-head">
          <p class="eyebrow mono">
            {data.company} • {data.status} {data.year}
          </p>
          <h1 class="project-title">{data.title}</h1>
        </header>

        {
          hasMedia && (
            <div class="hero-media" style={`aspect-ratio:${ratio}`}>
              {data.video ? (
                <video
                  class="hero-media-el"
                  src={data.video}
                  loop
                  muted
                  playsinline
                  preload="metadata"
                />
              ) : (
                <img class="hero-media-el" src={data.image} alt={data.title} />
              )}
            </div>
          )
        }

        <dl class="meta">
          {
            meta.map((m) => (
              <div class="meta-item">
                <dt class="mono">{m.label}</dt>
                <dd>
                  {m.values.map((v) => (
                    <p>{v}</p>
                  ))}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="prose">
          <Content />
        </div>
      </article>
    </div>
  </div>
</BaseLayout>

<script>
  // Highlight whichever section heading is currently in view
  const links = document.querySelectorAll<HTMLAnchorElement>('.toc-link');
  const sections = Array.from(links)
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((el): el is HTMLElement => Boolean(el));

  if (sections.length && links.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = entry.target.id;
          links.forEach((link) => link.classList.toggle('active', link.hash === `#${id}`));
        }
      },
      { rootMargin: '-10% 0px -75% 0px' }
    );
    sections.forEach((section) => observer.observe(section));
  }

  // Videos (hero + any embedded in the case study body) only play while
  // scrolled into view, so we don't burn bandwidth/battery off-screen.
  //
  // The Ask The Post AI hero hangs on its first frame for a beat before it
  // starts looping, so the opening state actually registers instead of
  // getting lost in the loop.
  const HANG_MS = 900;
  const pendingPlays = new WeakMap<HTMLVideoElement, number>();

  const videoObserver = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        const video = entry.target as HTMLVideoElement;
        const pending = pendingPlays.get(video);
        if (pending) {
          window.clearTimeout(pending);
          pendingPlays.delete(video);
        }

        if (entry.isIntersecting) {
          if (video.src.includes('ask-the-post')) {
            video.pause();
            video.currentTime = 0;
            const id = window.setTimeout(() => video.play().catch(() => {}), HANG_MS);
            pendingPlays.set(video, id);
          } else {
            video.play().catch(() => {});
          }
        } else {
          video.pause();
          if (video.src.includes('ask-the-post')) video.currentTime = 0;
        }
      }
    },
    { rootMargin: '200px' }
  );

  // Videos with manual play/pause controls (.video-frame) opt out of the
  // scroll-driven autoplay above — they should sit paused on their first
  // frame until the viewer presses play.
  document.querySelectorAll<HTMLVideoElement>('.project video').forEach((video) => {
    if (video.closest('.video-frame')) return;
    videoObserver.observe(video);
  });

  // Manual play/pause + restart overlay controls — the buttons just call the
  // same play()/pause() the observer above uses, and the icon swap listens to
  // the video's own events so it stays in sync regardless of which one
  // triggered it.
  const DEFAULT_START_TIME = 0.5;

  document.querySelectorAll<HTMLElement>('.video-frame').forEach((frame) => {
    const video = frame.querySelector('video');
    if (!video) return;

    const startTime = Number(frame.dataset.start ?? DEFAULT_START_TIME);

    const setStartFrame = () => {
      video.currentTime = startTime;
      video.removeEventListener('loadedmetadata', setStartFrame);
    };
    if (video.readyState >= 1) setStartFrame();
    else video.addEventListener('loadedmetadata', setStartFrame);

    const syncIcon = () => frame.classList.toggle('paused', video.paused);
    video.addEventListener('play', syncIcon);
    video.addEventListener('pause', syncIcon);
    syncIcon();

    frame.querySelector('.btn-play-pause')?.addEventListener('click', () => {
      if (video.paused) video.play().catch(() => {});
      else video.pause();
    });

    frame.querySelector('.btn-restart')?.addEventListener('click', () => {
      video.currentTime = startTime;
      video.play().catch(() => {});
    });
  });
</script>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    padding-block: 48px 96px;
  }

  /* ---- Sidebar: back link + section TOC ---- */
  .side {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--fs-lg);
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.15s ease;
  }
  .back:hover {
    color: var(--fg);
  }
  .back-arrow {
    flex-shrink: 0;
  }

  .toc {
    display: none;
    flex-direction: column;
    gap: 4px;
  }
  .toc-link {
    font-size: var(--fs-lg);
    color: var(--faint);
    transition: color 0.15s ease;
  }
  .toc-link:hover {
    color: var(--fg);
  }
  .toc-link.active {
    color: var(--fg);
  }

  /* ---- Main column ---- */
  .project {
    display: flex;
    flex-direction: column;
    gap: 32px;
    min-width: 0;
  }

  .project-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .eyebrow {
    font-size: var(--fs-sm);
    color: var(--muted);
  }

  .project-title {
    font-family: var(--font-serif);
    font-size: 3.25rem;
    line-height: 1.1;
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .hero-media {
    position: relative;
    width: 100%;
    border: 1px solid var(--line);
    overflow: hidden;
    box-sizing: border-box;
  }
  .hero-media-el {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .meta {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: -16px;
    padding-block: 24px;
  }

  .meta-item {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .meta-item dt {
    font-size: var(--fs-sm);
    text-transform: uppercase;
    color: var(--faint);
  }

  .meta-item dd p {
    font-size: var(--fs-m);
    color: var(--faint);
  }

  /* Body content rendered from MDX (flat h2/p/img siblings).
     h2 is the anchored section name (TOC label) — reference styles this as a
     small mono/uppercase eyebrow, not a big heading. h3/h4 are for an optional
     bigger serif statement + smaller grouped sub-point within that section. */
  .prose :global(h2) {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    font-weight: 400;
    text-transform: uppercase;
    color: var(--faint);
    margin-top: 40px;
    margin-bottom: 20px;
    scroll-margin-top: 32px;
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-top: 4px;
    margin-bottom: 24px;
  }

  .prose :global(h4) {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 400;
    letter-spacing: -0.02em;
    color: var(--fg);
    margin-top: 32px;
    margin-bottom: 4px;
  }

  /* Optional multi-column grid — wrap items in
     <div class="cols"><div>...</div>...</div> inside mdx content to use it.
     Works for h4/p sub-points, images, or a mix; columns split evenly
     across however many direct children are given. */
  .prose :global(.cols) {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    column-gap: 12px;
    margin-top: 24px;
    margin-bottom: 24px;
  }
  .prose :global(.cols h4) {
    margin-top: 0;
  }
  .prose :global(.cols p) {
    margin-bottom: 0;
  }
  .prose :global(.cols img) {
    margin-block: 0;
  }
  /* Opt-in narrower, centered variant, e.g. class="cols centered" */
  .prose :global(.cols.centered) {
    width: 66%;
    margin-left: auto;
    margin-right: auto;
  }

  @media (max-width: 600px) {
    .prose :global(.cols) {
      grid-auto-flow: row;
      grid-auto-columns: unset;
      grid-template-columns: 1fr;
      row-gap: 24px;
    }
    .prose :global(.cols.centered) {
      width: 100%;
    }
  }

  .prose :global(p) {
    font-size: var(--fs-base);
    color: var(--muted);
    margin-bottom: 20px;
  }

  .prose :global(img) {
    margin-block: 28px;
    width: 100%;
  }
  .prose :global(video) {
    display: block;
    margin-block: 28px;
    width: 100%;
  }
  /* Opt-in grey outline, matching the homepage project card thumbnails */
  .prose :global(img.outlined),
  .prose :global(video.outlined) {
    /* outline instead of border: doesn't shrink the content box, so video
       pixels keep an exact 1:1 mapping to device pixels (no resample blur) */
    outline: 1px solid var(--line);
    outline-offset: -1px;
  }
  /* Opt-in half-width, e.g. class="outlined half" */
  .prose :global(.half) {
    width: 50%;
  }
  /* Z-pattern stacking: narrower media pushed to opposite edges */
  .prose :global(.align-left) {
    width: 72%;
    margin-right: auto;
  }
  .prose :global(.align-right) {
    width: 72%;
    margin-left: auto;
  }
  /* Half-width media, left-aligned, with a caption set beside it on the
     right, bottom-aligned — wrap <video>/<img> + a
     <div class="media-row-caption"><h3/><p/></div> in <div class="media-row">. */
  .prose :global(.media-row) {
    display: flex;
    align-items: flex-end;
    gap: 32px;
    margin-block: 28px;
  }
  .prose :global(.media-row img),
  .prose :global(.media-row .video-frame) {
    width: 50%;
    flex-shrink: 0;
    margin-block: 0;
  }
  .prose :global(.media-row-caption h3) {
    font-size: 1.4rem;
    margin: 0 0 8px;
  }
  .prose :global(.media-row-caption p) {
    font-size: var(--fs-sm);
    max-width: 32ch;
    margin: 0;
  }
  @media (max-width: 600px) {
    .prose :global(.media-row) {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .prose :global(.media-row img),
    .prose :global(.media-row .video-frame) {
      width: 100%;
    }
  }

  /* Play/pause + restart overlay for a <video> — wrap it in
     <div class="video-frame"> with a <div class="video-controls"> of two
     buttons (see mdx). Controls fade in on hover, like native video chrome. */
  .prose :global(.video-frame) {
    position: relative;
  }
  .prose :global(.video-frame video) {
    display: block;
    width: 100%;
    margin-block: 0;
  }
  .prose :global(.video-controls) {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: flex;
    gap: 8px;
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .prose :global(.video-frame:hover .video-controls),
  .prose :global(.video-frame:focus-within .video-controls) {
    opacity: 1;
  }
  .prose :global(.video-controls button) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    color: #fff;
    cursor: pointer;
  }
  .prose :global(.video-controls button:hover) {
    background: rgba(0, 0, 0, 0.75);
  }
  /* Opt-in variant for videos with dark footage, so the buttons stay legible
     — add class="light" to the .video-controls wrapper. */
  .prose :global(.video-controls.light button) {
    background: rgba(255, 255, 255, 0.85);
    color: #111;
  }
  .prose :global(.video-controls.light button:hover) {
    background: rgba(255, 255, 255, 1);
  }
  .prose :global(.video-controls svg) {
    width: 16px;
    height: 16px;
  }
  .prose :global(.video-controls .icon-play) {
    display: none;
  }
  .prose :global(.video-frame.paused .icon-pause) {
    display: none;
  }
  .prose :global(.video-frame.paused .icon-play) {
    display: block;
  }

  @media (min-width: 768px) {
    .project-grid {
      grid-template-columns: 220px minmax(0, 1fr);
      column-gap: 64px;
    }
    .side {
      grid-column: 1;
      position: sticky;
      top: 32px;
      height: fit-content;
    }
    .project {
      grid-column: 2;
      max-width: 676px;
    }
    .toc {
      display: flex;
    }
    .meta {
      flex-direction: row;
      gap: 48px;
    }
    .meta-item {
      flex: 1 1 0;
    }
  }

  /* Only once the container is comfortably wider than sidebar + content + gaps
     do we switch to the symmetric 1fr/content/1fr centering used at desktop widths */
  @media (min-width: 1280px) {
    .project-grid {
      grid-template-columns: minmax(220px, 1fr) minmax(0, 896px) 1fr;
      column-gap: 160px;
    }
    .project {
      max-width: 788px;
    }
  }

  @media (max-width: 480px) {
    .project-title {
      font-size: 1.9rem;
    }
  }
</style>
