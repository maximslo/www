---
// maximslo.com/portfolio: the home page's black section (the lab grid and
// the footer) on its own, without the white intro sheet above it. The chat
// links here when someone asks to see my work.
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperimentsLab from "../components/ExperimentsLab.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { INTRO_NAME, META_DESCRIPTION } from "../config/intro";
---

<BaseLayout title={`Work — ${INTRO_NAME}`} description={META_DESCRIPTION} dark>
	<a class="portfolio-back" href="/" data-portfolio-back aria-label="Back to chat">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="m15 18-6-6 6-6"></path>
		</svg>
		<span>Chat</span>
	</a>
	<ExperimentsLab />
	<SiteFooter />
</BaseLayout>

<script>
	// Came from the chat on this site: go back instead of loading it fresh, so
	// the conversation is still there (and the browser restores it whole).
	document.querySelector<HTMLAnchorElement>("[data-portfolio-back]")?.addEventListener("click", (event) => {
		if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		let fromHere = false;
		try {
			fromHere = new URL(document.referrer).origin === location.origin;
		} catch {}
		if (fromHere && history.length > 1) {
			event.preventDefault();
			history.back();
		}
	});
</script>

<style>
	/* Pinned top left, over the grid as it scrolls: a pill of frosted
	   glass, the dark-side cousin of the chat's New chat button. */
	.portfolio-back {
		position: fixed;
		z-index: 10;
		top: calc(env(safe-area-inset-top) + 20px);
		left: calc(env(safe-area-inset-left) + 20px);
		display: flex;
		align-items: center;
		gap: 2px;
		height: 36px;
		padding: 0 16px 0 10px;
		font-size: 16px;
		font-weight: 500;
		line-height: 1;
		color: #fff;
		text-decoration: none;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.12);
		-webkit-backdrop-filter: blur(12px) saturate(180%);
		backdrop-filter: blur(12px) saturate(180%);
		/* Glossy: a bright rim along the top edge fading to a faint one
		   below, plus a soft drop so it lifts off the photos. */
		box-shadow:
			inset 0 1px 0.5px rgba(255, 255, 255, 0.35),
			inset 0 0 0 0.5px rgba(255, 255, 255, 0.18),
			0 4px 24px rgba(0, 0, 0, 0.35);
		-webkit-tap-highlight-color: transparent;
		transition:
			transform 200ms ease-out,
			background-color 200ms ease-out;
		/* Its own layer, scaled whole on press, so the letters don't wobble. */
		will-change: transform;
	}

	.portfolio-back:hover {
		background-color: rgba(255, 255, 255, 0.18);
	}

	.portfolio-back:active {
		transform: scale(0.94);
	}

	.portfolio-back:focus-visible {
		outline: 2px solid #fff;
		outline-offset: 2px;
	}

	/* Centred on its letters, not its line box: the font's line box has more
	   room above the capitals than below, which left "Chat" sitting high.
	   Trimmed to cap height and baseline, flexbox centres what you see. */
	.portfolio-back span {
		text-box: trim-both cap alphabetic;
	}

	@supports not (text-box: trim-both cap alphabetic) {
		.portfolio-back span {
			transform: translateY(0.05em);
		}
	}

	.portfolio-back svg {
		width: 20px;
		height: 20px;
	}

	/* The grid starts below the pill: 20px above it, so 20px under it too. */
	:global(body .lab-section.lab-section) {
		padding-top: max(clamp(48px, 5.6vw, 112px), calc(env(safe-area-inset-top) + 76px));
	}

	@media (prefers-reduced-motion: no-preference) {
		.portfolio-back {
			animation: portfolio-back-in var(--page-fade-duration) var(--page-fade-easing) both;
		}
	}

	@keyframes portfolio-back-in {
		from {
			opacity: 0;
		}
	}
</style>
