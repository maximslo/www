---
// maximslo.com/portfolio: the old home page's project section (the lab grid
// and the footer) on its own, on the home page's white rather than the
// near-black it sat on there. The chat
// links here when someone asks to see my work.
import BaseLayout from "../layouts/BaseLayout.astro";
import ExperimentsLab from "../components/ExperimentsLab.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { INTRO_NAME, META_DESCRIPTION } from "../config/intro";
---

<BaseLayout title={`Work — ${INTRO_NAME}`} description={META_DESCRIPTION} bare>
	<a class="portfolio-back" href="/" data-portfolio-back aria-label="Back to chat">
		<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
			<path d="m15 18-6-6 6-6"></path>
		</svg>
		<span>Chat</span>
	</a>
	{/* Tiles start hidden for their entry (below), set before they render so
	    none flashes in first. Never with reduced motion, and never for good:
	    if the entry script hasn't taken over in a few seconds, they show. */}
	<script is:inline>
		// A reload starts at the top, with the entry, rather than wherever the
		// browser last had it scrolled.
		if ("scrollRestoration" in history) history.scrollRestoration = "manual";
		scrollTo(0, 0);
		if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
			document.documentElement.setAttribute("data-entry", "");
			setTimeout(() => {
				if (!document.documentElement.hasAttribute("data-entry-running")) document.documentElement.removeAttribute("data-entry");
			}, 3000);
		}
	</script>
	<ExperimentsLab />
	<SiteFooter />
</BaseLayout>

<script>
	// Came from the chat on this site: go back instead of loading it fresh, so
	// the conversation is still there (and the browser restores it whole).
	document.querySelector<HTMLAnchorElement>("[data-portfolio-back]")?.addEventListener("click", (event) => {
		if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
		let fromHere = false;
		try {
			fromHere = new URL(document.referrer).origin === location.origin;
		} catch {}
		if (fromHere && history.length > 1) {
			event.preventDefault();
			history.back();
		}
	});
</script>

<script>
	/* Project entry, after bruce-cao.com: each tile rises from below at 40%
	   size and fades in, row by row with a 75ms stagger, once its picture has
	   loaded and it's in view. Values are the reference's own (its video
	   cards): 0.5s (0.55s on phones), transform on cubic-bezier(0, .91, 0,
	   1), opacity linear; 400px of travel for tiles on the first screen,
	   their own height for ones scrolled to; only the first 3 rows (5 on
	   phones) and whatever's on the first screen animate, the rest are
	   just there. */
	const root = document.documentElement;
	if (root.hasAttribute("data-entry")) {
		root.setAttribute("data-entry-running", "");
		const phone = matchMedia("(max-width: 480px)").matches;
		const duration = phone ? 550 : 500;
		const rows = phone ? 5 : 3;
		const STAGGER = 75;
		const MARGIN = 40;
		// Don't hold a tile back forever on a slow connection: by then its
		// blurred preview is a fine thing to rise in with.
		const LOAD_WAIT = 1200;

		const columns = [...document.querySelectorAll<HTMLElement>(".lab-column")];
		const reveal = (tile: HTMLElement) => tile.setAttribute("data-entered", "");

		const loaded = (tile: HTMLElement) =>
			new Promise<void>((resolve) => {
				const timer = setTimeout(resolve, LOAD_WAIT);
				const done = () => (clearTimeout(timer), resolve());
				const img = tile.querySelector("img");
				const poster = tile.querySelector("video")?.poster;
				if (img) {
					if (img.complete && img.naturalWidth) return done();
					img.addEventListener("load", done, { once: true });
					img.addEventListener("error", done, { once: true });
					// Lazy: it may not start loading until it's this close anyway.
					img.loading = "eager";
				} else if (poster) {
					const probe = new Image();
					probe.onload = probe.onerror = done;
					probe.src = poster;
				} else done();
			});

		columns.forEach((column, col) => {
			[...column.querySelectorAll<HTMLElement>(":scope > .lab-tile")].forEach((tile, row) => {
				const box = tile.getBoundingClientRect();
				const firstScreen = box.top < innerHeight + MARGIN && box.bottom > 0;
				// Everything on the first screen joins in, so a short grid that
				// fits whole (phones) doesn't have its last row sitting there
				// while the rest rise.
				if (row >= rows && !firstScreen) return reveal(tile);
				const delay = (row * columns.length + col) * STAGGER;
				const ready = loaded(tile);

				const observer = new IntersectionObserver(
					async ([entry]) => {
						if (!entry.isIntersecting && entry.boundingClientRect.top > innerHeight + MARGIN) return;
						observer.disconnect();
						await ready;
						const now = tile.getBoundingClientRect();
						const offset = firstScreen ? 400 : Math.max(innerHeight + now.height - now.top, now.height);
						reveal(tile);
						// Two animations, as the reference's two transitions: the
						// rise eased hard, the fade linear. Held at the start through
						// the stagger, then nothing left behind on the tile (the
						// lightbox measures and animates it).
						tile.animate([{ transform: `translateY(${offset}px) scale(0.4)` }, { transform: "none" }], {
							duration,
							delay,
							easing: "cubic-bezier(0, 0.91, 0, 1)",
							fill: "backwards",
						});
						tile.animate([{ opacity: 0 }, { opacity: 1 }], { duration, delay, easing: "linear", fill: "backwards" });
					},
					{ rootMargin: `0px 0px ${MARGIN}px` },
				);
				observer.observe(tile);
			});
		});
	}
</script>

<style>
	/* The section was built for near-black; here it's on the home page's
	   white. Its colours all come from these, so they're swapped for the
	   page's own: the surface, then the text and dotted link rules of the
	   white pages. */
	/* (:root twice: global.css sets them on :root, which outranks html.) */
	:global(:root:root) {
		--color-bg-reveal: var(--color-bg-page);
		--color-text-on-reveal: var(--color-text-primary);
		--color-text-on-reveal-dim: var(--color-text-secondary);
		--color-link-line-on-reveal: var(--color-link-line);
	}

	/* Hovered links went white, which here is invisible: black instead.
	   (!important: the section's own rules are scoped, so more specific.) */
	:global(.footer-link:hover),
	:global(.footer-link:focus-visible),
	:global(.lightbox-action:hover),
	:global(.lightbox-action:focus-visible) {
		color: #000 !important;
		border-color: #000 !important;
	}

	/* The enlarged view's veil: a white frost over the grid, not a dark one. */
	:global(.lightbox-veil) {
		background: rgba(255, 255, 255, 0.82) !important;
	}

	:global(html[data-entry] .lab-tile:not([data-entered])) {
		opacity: 0;
	}

	/* No slow whole-page fade here: the tiles' own entry is the intro, and
	   the fade under it dimmed them as they rose. */
	:global(html[data-entry] body) {
		opacity: 1;
		animation: none;
	}

	/* Pinned top left, over the grid as it scrolls: the frosted glass of the
	   chat's New chat button, stretched into a pill. */
	.portfolio-back {
		position: fixed;
		z-index: 10;
		top: calc(env(safe-area-inset-top) + 20px);
		left: calc(env(safe-area-inset-left) + 20px);
		display: flex;
		align-items: center;
		gap: 2px;
		height: 36px;
		padding: 0 16px 0 10px;
		font-size: 16px;
		font-weight: 500;
		line-height: 1;
		color: #000;
		text-decoration: none;
		border-radius: 18px;
		background: rgba(255, 255, 255, 0.3);
		-webkit-backdrop-filter: blur(8px) saturate(300%);
		backdrop-filter: blur(8px) saturate(300%);
		box-shadow:
			0 0 32px rgba(0, 0, 0, 0.12),
			inset 0 0 3px 1px #fff;
		-webkit-tap-highlight-color: transparent;
		transition:
			transform 200ms ease-out,
			background-color 200ms ease-out;
		/* Its own layer, scaled whole on press, so the letters don't wobble. */
		will-change: transform;
	}

	.portfolio-back:hover {
		background-color: rgba(255, 255, 255, 0.5);
	}

	.portfolio-back:active {
		transform: scale(0.94);
	}

	.portfolio-back:focus-visible {
		outline: 2px solid #000;
		outline-offset: 2px;
	}

	/* Centred on its letters, not its line box: the font's line box has more
	   room above the capitals than below, which left "Chat" sitting high.
	   Trimmed to cap height and baseline, flexbox centres what you see. */
	.portfolio-back span {
		text-box: trim-both cap alphabetic;
	}

	@supports not (text-box: trim-both cap alphabetic) {
		.portfolio-back span {
			transform: translateY(0.05em);
		}
	}

	.portfolio-back svg {
		width: 20px;
		height: 20px;
	}

	/* The grid starts below the pill: 20px above it, so 20px under it too. */
	:global(body .lab-section.lab-section) {
		padding-top: max(clamp(48px, 5.6vw, 112px), calc(env(safe-area-inset-top) + 76px));
	}

	@media (prefers-reduced-motion: no-preference) {
		.portfolio-back {
			animation: portfolio-back-in 500ms linear both;
		}
	}

	@keyframes portfolio-back-in {
		from {
			opacity: 0;
		}
	}
</style>
