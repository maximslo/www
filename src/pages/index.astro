---
import BaseLayout from "../layouts/BaseLayout.astro";
import AskMe from "../components/AskMe.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import { INTRO_NAME, META_DESCRIPTION } from "../config/intro";
---

{/* Just the chat, in a phone. No reveal slot, so BaseLayout renders the white
    sheet alone and canvas-reveal.ts stands down. */}
<BaseLayout title={INTRO_NAME} description={META_DESCRIPTION}>
	{/* My name, top left beside the phone, in the site's body text (as the
	    old intro set it). Desktop only: at phone widths the chat fills the
	    screen. */}
	<p class="site-name">{INTRO_NAME}</p>
	<PhoneFrame>
		<AskMe layout="phone" />
	</PhoneFrame>
</BaseLayout>

<style>
	.site-name {
		display: none;
	}

	@media (width > 768px) {
		.site-name {
			display: block;
			position: absolute;
			z-index: 2;
			top: 40px;
			left: 64px;
			margin: 0;
			font-size: 20px;
		}
	}
</style>
