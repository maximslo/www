---
import BaseLayout from "../layouts/BaseLayout.astro";
import AskMe from "../components/AskMe.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import { INTRO_NAME, META_DESCRIPTION } from "../config/intro";
---

{/* Just the chat, in a phone. No reveal slot, so BaseLayout renders the white
    sheet alone and canvas-reveal.ts stands down. */}
<BaseLayout title={INTRO_NAME} description={META_DESCRIPTION}>
	<span class="site-mark" aria-hidden="true">M</span>
	<PhoneFrame>
		<AskMe layout="phone" />
	</PhoneFrame>
</BaseLayout>

<style>
	/* The mark in the top-left corner: a single M in the site's own face,
	   semibold. Fixed, so it sits over the page like the phone does, and kept
	   inside the safe area on phones with a notch. It's centred in a 32px box
	   that the hover tile fills; the box is offset so the M itself sits where
	   it would at 24px from the corner. */
	.site-mark {
		--mark-ease: 0.2s cubic-bezier(0.2, 0.2, 0.2, 1);
		position: fixed;
		z-index: 1;
		top: max(18px, env(safe-area-inset-top));
		left: max(16px, env(safe-area-inset-left));
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		font-family: var(--font-sans);
		font-size: 20px;
		font-weight: 600;
		line-height: 1;
		color: var(--color-text-primary);
		user-select: none;
		cursor: default;
		transition: color var(--mark-ease);
	}

	/* The tile behind it, after alexsafayan.com's squircle-xs icon: a dark
	   rounded square, hidden at 60% size, that grows in on hover on his
	   0.2s curve and squeezes to 90% while pressed. Squircle corners where
	   corner-shape is supported, plain rounded ones elsewhere. */
	.site-mark::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: -1;
		background: #171717;
		border-radius: 7px;
		opacity: 0;
		scale: 0.6;
		transition:
			opacity var(--mark-ease),
			scale var(--mark-ease);
	}

	@supports (corner-shape: squircle) {
		.site-mark::before {
			corner-shape: squircle;
			border-radius: 12px;
		}
	}

	.site-mark:hover {
		color: #fff;
	}

	.site-mark:hover::before {
		opacity: 1;
		scale: 1;
	}

	.site-mark:active::before {
		scale: 0.9;
	}

	@media (prefers-reduced-motion: reduce) {
		.site-mark,
		.site-mark::before {
			transition: none;
		}
	}
</style>
