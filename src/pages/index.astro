import PageGrid from "../components/PageGrid.astro";
import SiteIntro from "../components/SiteIntro.astro";
import { INTRO_NAME } from "../config/intro";

const description = `Portfolio by ${INTRO_NAME}.`;
---

<BaseLayout title={INTRO_NAME} description={description}>
	<PageGrid>
		<SiteIntro />
	</PageGrid>
</BaseLayout>
