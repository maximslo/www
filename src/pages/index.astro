---
import BaseLayout from "../layouts/BaseLayout.astro";
import AskMe from "../components/AskMe.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import PhoneApps from "../components/PhoneApps.astro";
import { INTRO_NAME, META_DESCRIPTION } from "../config/intro";
---

{/* Just the chat, in a phone. No reveal slot, so BaseLayout renders the white
    sheet alone and canvas-reveal.ts stands down. */}
<BaseLayout title={INTRO_NAME} description={META_DESCRIPTION}>
	<PhoneFrame>
		{/* The chat, and the portfolio it can switch over to. */}
		<PhoneApps>
			<AskMe layout="phone" />
		</PhoneApps>
	</PhoneFrame>
</BaseLayout>
