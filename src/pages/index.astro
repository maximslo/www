---
// Port of public/mask.html, minus the "Maxim" pixel-art wordmark and the
// name heading. Self-contained page (own styles + script).

import { getCollection } from "astro:content";

const work = await getCollection("work", ({ data }) => !data.draft && !data.unlisted);
// the work grid is ordered by the `order` frontmatter…
const projects = [...work].sort((a, b) => a.data.order - b.data.order);
// …the index list below it is newest-first by date, and excludes external-only
// projects (no blog page) and any marked `hideFromList`
const posts = [...work]
	.filter((p) => !p.data.external && !p.data.hideFromList)
	.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const shortDate = (d: Date) =>
	d.toLocaleDateString("en-US", { timeZone: "UTC", year: "numeric", month: "short", day: "numeric" });

// base path normalized to always end in a slash (BASE_URL can be "/www")
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
// absolute URL of this page, for canonical + social meta
const pageUrl = new URL(base, Astro.site).href;
const ogImage = new URL(`${base}og.png`, Astro.site).href;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${base}fish.svg`} />
		<link rel="icon" type="image/png" href={`${base}fish.png`} />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<link rel="manifest" href={`${base}site.webmanifest`} />
		<meta name="theme-color" content="#fbfbf9" />

		<title>maxim slobodchikov</title>
		<meta
			name="description"
			content="Maxim is a 23-year-old engineer and designer making visual things on and off the web. Previously at the New York Times and the Washington Post."
		/>
		<link rel="canonical" href={pageUrl} />

		<!-- Open Graph (link previews: iMessage, Slack, LinkedIn, Facebook) -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content="maxim slobodchikov" />
		<meta
			property="og:description"
			content="Maxim is a 23-year-old engineer and designer making visual things on and off the web. Previously at the New York Times and the Washington Post."
		/>
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content="Maxim Slobodchikov" />

		<!-- Twitter / X card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content="maxim slobodchikov" />
		<meta
			name="twitter:description"
			content="Maxim is a 23-year-old engineer and designer making visual things on and off the web. Previously at the New York Times and the Washington Post."
		/>
		<meta name="twitter:image" content={ogImage} />
		<script is:inline>
			// set theme before first paint to avoid a flash
			(function () {
				const saved = localStorage.getItem("theme");
				const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
				if (dark) document.documentElement.dataset.theme = "dark";
			})();
		</script>
		<!-- self-hosted DM Sans, preloaded so it is ready before first paint (no FOUT) -->
		<link rel="preload" href={`${base}fonts/dmsans-variable.woff2`} as="font" type="font/woff2" crossorigin />
		<style>
			@font-face {
				font-family: "DM Sans";
				font-style: normal;
				font-weight: 300 700;
				font-display: swap;
				src: url("/fonts/dmsans-variable.woff2") format("woff2");
				/* match Google's latin subset so non-latin glyphs (the ↗ / ← arrows) fall back to the system font, as on the live site */
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
			:root {
				--paper: #fbfbf9;
				--ink: #1a1a1a;
				/* unified text color — everything reads in the same ink */
				--muted: #1a1a1a;
				--label: #9b9893;
				--rule: #cfccc4;
				--thumb-border: #e6e3dd;
				--accent: #e07a5f;
				/* spacing scale: items within a group vs. between groups */
				--space-item: 0.8rem;
				--space-section: 1.9rem;
			}
			html[data-theme="dark"] {
				--paper: #121211;
				--ink: #ece9e3;
				--muted: #ece9e3;
				--label: #807d77;
				--rule: #34332f;
				--thumb-border: #2c2b28;
			}
			html {
				/* baked-in 150% scale — everything is sized in rem, so bumping
				   the root size scales the whole layout like a 150% zoom */
				font-size: 150%;
				/* always reserve the scrollbar gutter so the centered column
				   doesn't shift when a scrollbar appears (e.g. after font load) */
				scrollbar-gutter: stable;
			}
			html,
			body {
				background: var(--paper);
			}
			body,
			.thumb-media {
				transition: background-color 0.25s ease, color 0.25s ease;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				min-height: 100vh;
				background: var(--paper);
				color: var(--ink);
				font-family: "DM Sans", ui-sans-serif, system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
				font-weight: 400;
				letter-spacing: -0.015em;
				display: flex;
				justify-content: center;
				padding: 3rem 1.5rem 4rem;
			}
			.home {
				width: 100%;
				max-width: 27.5rem; /* 440px at the base 16px root */
			}
			nav {
				display: flex;
				align-items: flex-start;
				gap: 1.5rem;
				font-size: 1.55rem;
				line-height: 1;
				padding-top: 2rem;
				margin-bottom: calc(var(--space-item) * 0.75);
			}
			nav a {
				color: var(--muted);
				text-decoration: none;
			}
			nav a:hover,
			nav a.active {
				color: var(--ink);
			}
			nav a:hover {
				text-decoration: underline;
				text-underline-offset: 5px;
			}
			/* push the trailing link to the far right edge of the nav */
			nav a.right {
				margin-left: auto;
			}
			.qa {
				margin: var(--space-section) 0;
			}
			.qa-row {
				display: grid;
				grid-template-columns: 5.5rem 1fr;
				gap: 0.75rem;
				font-size: 0.9rem;
				line-height: 1.4;
				/* top+bottom padding of adjacent rows sums to one --space-item */
				padding: calc(var(--space-item) / 2) 0;
				border-bottom: 1px dashed var(--rule);
			}
			.qa-row:first-child {
				padding-top: 0;
			}
			.qa-row:last-child {
				padding-bottom: 0;
				border-bottom: 0;
			}
			.qa-q {
				color: var(--label);
				text-align: left;
			}
			.qa-a {
				margin: 0;
				text-align: left;
			}
			.links {
				display: flex;
				align-items: center;
				font-size: 0.9rem;
				margin: 0 0 var(--space-section);
			}
			.links a {
				color: var(--muted);
				text-decoration: none;
				margin-right: 1.5rem;
			}
			.theme-toggle {
				margin-left: auto;
				/* nudge down to optically center on the name's first line */
				margin-top: 0.3rem;
				padding: 0;
				border: 0;
				background: none;
				color: var(--muted);
				cursor: pointer;
				line-height: 0;
				flex-shrink: 0;
				font: inherit;
			}
			.theme-toggle svg {
				display: block;
				width: 0.9rem;
				height: 0.9rem;
			}
			.theme-toggle:hover {
				opacity: 0.6;
			}
			.theme-toggle .icon-sun {
				display: none;
			}
			html[data-theme="dark"] .theme-toggle .icon-moon {
				display: none;
			}
			html[data-theme="dark"] .theme-toggle .icon-sun {
				display: block;
			}
			.links a::before {
				content: "↗";
				margin-right: 0.3rem;
				font-size: 1.15em;
				font-weight: 400;
				vertical-align: -0.11em;
			}
			.links a:hover {
				opacity: 0.6;
			}
			.work {
				margin-top: 0;
			}
			.work-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.4rem;
			}
			/* mobile / narrow: keep the big text, drop to 2 columns,
			   and tighten the page padding so nothing overflows */
			/* dated index of every project, below the grid */
			.index {
				/* quite a bit of breathing room below the project grid */
				margin-top: calc(var(--space-section) * 2.5);
			}
			.post {
				display: grid;
				grid-template-columns: 5rem 1fr;
				gap: 0.6rem;
				/* align the date's baseline with the project name */
				align-items: baseline;
				text-decoration: none;
				color: var(--ink);
				padding: 0.55rem 0;
				border-bottom: 1px dashed var(--rule);
			}
			.post:first-child {
				padding-top: 0;
			}
			.post:last-child {
				padding-bottom: 0;
				border-bottom: 0;
			}
			.post-date {
				color: var(--label);
				font-size: 0.6rem;
				line-height: 1.5;
				white-space: nowrap;
			}
			.post-main {
				display: block;
			}
			.post-title {
				font-size: 0.7rem;
				font-weight: 500;
				line-height: 1.5;
				text-decoration: underline;
				text-underline-offset: 3px;
				text-decoration-thickness: 1px;
			}
			.post:hover .post-title {
				text-decoration-thickness: 2px;
			}
			.post-desc {
				display: block;
				font-size: 0.7rem;
				font-weight: 300;
				line-height: 1.5;
				margin-top: 0.2rem;
			}
			.post-tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.35rem;
				margin-top: 0.45rem;
			}
			.tag {
				font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
				font-size: 0.6rem;
				text-transform: uppercase;
				letter-spacing: 0.04em;
				color: var(--label);
				background: var(--thumb-border);
				padding: 0.12rem 0.4rem;
				border-radius: 4px;
				white-space: nowrap;
			}
			@media (max-width: 768px) {
				/* scale the whole layout down on mobile (desktop stays 150%) */
				html {
					font-size: 115%;
				}
				body {
					padding: 1.75rem 1.25rem 2.5rem;
				}
				nav {
					padding-top: 1rem;
					gap: 0.75rem;
				}
				.work-grid {
					grid-template-columns: repeat(2, 1fr);
				}
				.index {
					margin-top: var(--space-section);
				}
			}
			.card {
				display: block;
				text-decoration: none;
			}
			.card .thumb {
				display: block;
				position: relative;
				aspect-ratio: 4 / 3;
				border-radius: 0;
				background: transparent;
				overflow: hidden;
			}
			.thumb-media {
				position: absolute;
				/* overflow the box by 1px so edges never sit exactly on the
				   rounded clip — avoids a dark seam during the scale transition */
				inset: -1px;
				width: calc(100% + 2px);
				height: calc(100% + 2px);
				object-fit: cover;
				display: block;
				transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
				backface-visibility: hidden;
				transform: translateZ(0);
			}
			.card:hover .thumb-media {
				transform: translateZ(0) scale(1.04);
			}
			@media (prefers-reduced-motion: reduce) {
				.thumb-media { transition: none; }
				.card:hover .thumb-media { transform: none; }
			}
			/* floating caption that follows the cursor over a thumbnail */
			.hovercard {
				position: fixed;
				top: 0;
				left: 0;
				z-index: 100;
				pointer-events: none;
				display: flex;
				align-items: baseline;
				gap: 0.5rem;
				padding: 0.28rem 0.55rem;
				background: var(--ink);
				color: var(--paper);
				font-size: 0.78rem;
				white-space: nowrap;
				border-radius: 5px;
				opacity: 0;
				transform: translate3d(-9999px, -9999px, 0);
				transition: opacity 0.16s ease;
			}
			.hovercard.is-visible {
				opacity: 1;
			}
			.hc-meta {
				opacity: 0.6;
			}
			@media (prefers-reduced-motion: reduce) {
				.hovercard { transition: none; }
			}
		</style>
	</head>
	<body>
		<div class="home">
			<nav>
				<a href="#" class="active">Maxim Slobodchikov</a>
				<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
					<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
					<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
				</button>
			</nav>

			<p class="links">
				<a href="https://www.linkedin.com/in/maximslo/">linkedin</a>
				<a href="https://github.com/maximslo">github</a>
				<a href="https://strava.app.link/iaJoaMXRwOb">strava</a>
			</p>

			<dl class="qa">
				<div class="qa-row">
					<dt class="qa-q">who</dt>
					<dd class="qa-a">23-year-old engineer and designer</dd>
				</div>
				<div class="qa-row">
					<dt class="qa-q">what</dt>
					<dd class="qa-a">making visual things on and off the web</dd>
				</div>
				<div class="qa-row">
					<dt class="qa-q">where</dt>
					<dd class="qa-a">previously at the New York Times, Washington Post</dd>
				</div>
			</dl>

			<section class="work" aria-label="Selected work">
				<div class="work-grid">
					{
						projects.map(({ id, data }) => (
							<a class="card" href={data.external ?? `${base}work/${id}/`} data-title={data.title} data-meta={data.date.getUTCFullYear()}>
								<span class="thumb">
									{data.media.type === "video" ? (
										<video class="thumb-media" src={`${base}${data.media.src}`} poster={`${base}${data.media.poster}`} muted loop autoplay playsinline preload="metadata" />
									) : (
										<img class="thumb-media" src={`${base}${data.media.src}`} alt="" loading="lazy" />
									)}
								</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="index" aria-label="All projects">
				{
					posts.map(({ id, data }) => (
						<a class="post" href={`${base}work/${id}/`}>
							<span class="post-date">{shortDate(data.date)}</span>
							<span class="post-main">
								<span class="post-title">{data.title}</span>
								<span class="post-desc">{data.lede}</span>
								{data.tags && data.tags.length > 0 && (
									<span class="post-tags">
										{data.tags.map((t) => (
											<span class="tag">{t}</span>
										))}
									</span>
								)}
							</span>
						</a>
					))
				}
			</section>
		</div>

		<!-- cursor-following project caption (runping.work style) -->
		<div id="hovercard" class="hovercard" aria-hidden="true">
			<span class="hc-title"></span>
			<span class="hc-meta"></span>
		</div>

		<script>
			// dark mode toggle: flip data-theme and remember the choice
			const toggle = document.getElementById("theme-toggle");
			toggle?.addEventListener("click", () => {
				const dark = document.documentElement.dataset.theme === "dark";
				document.documentElement.dataset.theme = dark ? "" : "dark";
				localStorage.setItem("theme", dark ? "light" : "dark");
			});

			// cursor-following project caption (only on hover-capable pointers)
			const hovercard = document.getElementById("hovercard");
			if (hovercard && matchMedia("(hover: hover)").matches) {
				const hcTitle = hovercard.querySelector(".hc-title") as HTMLElement;
				const hcMeta = hovercard.querySelector(".hc-meta") as HTMLElement;
				const OFFSET = 16;
				const place = (e: PointerEvent) => {
					// keep the card from spilling past the right/bottom edges
					const w = hovercard.offsetWidth;
					const h = hovercard.offsetHeight;
					let x = e.clientX + OFFSET;
					let y = e.clientY + OFFSET;
					if (x + w > innerWidth) x = e.clientX - OFFSET - w;
					if (y + h > innerHeight) y = e.clientY - OFFSET - h;
					hovercard.style.transform = `translate3d(${x}px, ${y}px, 0)`;
				};
				document.querySelectorAll<HTMLElement>(".card").forEach((card) => {
					card.addEventListener("pointerenter", (e) => {
						hcTitle.textContent = card.dataset.title || "";
						hcMeta.textContent = card.dataset.meta || "";
						place(e as PointerEvent);
						hovercard.classList.add("is-visible");
					});
					card.addEventListener("pointermove", (e) => place(e as PointerEvent));
					card.addEventListener("pointerleave", () => {
						hovercard.classList.remove("is-visible");
					});
				});
			}

			// project card videos: autoplay, but only while on screen
			const vids = document.querySelectorAll<HTMLVideoElement>("video.thumb-media");
			if (vids.length) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							const v = e.target as HTMLVideoElement;
							if (e.isIntersecting) v.play().catch(() => {});
							else v.pause();
						}
					},
					{ rootMargin: "200px" },
				);
				vids.forEach((v) => io.observe(v));
			}
		</script>
	</body>
</html>
