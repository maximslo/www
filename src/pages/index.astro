---
import BaseLayout from "../layouts/BaseLayout.astro";
import AskMe from "../components/AskMe.astro";
import PhoneFrame from "../components/PhoneFrame.astro";
import { INTRO_NAME, META_DESCRIPTION } from "../config/intro";
---

{/* Just the chat, in a phone. No reveal slot, so BaseLayout renders the white
    sheet alone and canvas-reveal.ts stands down. */}
<BaseLayout title={INTRO_NAME} description={META_DESCRIPTION}>
	<span class="site-mark" aria-hidden="true">M</span>
	<PhoneFrame>
		<AskMe layout="phone" />
	</PhoneFrame>
</BaseLayout>

<style>
	/* The mark in the top-left corner: a single M in the site's own face,
	   semibold. Fixed, so it sits over the page like the phone does, and kept
	   inside the safe area on phones with a notch. */
	.site-mark {
		position: fixed;
		z-index: 1;
		top: max(24px, env(safe-area-inset-top));
		left: max(24px, env(safe-area-inset-left));
		font-family: var(--font-sans);
		font-size: 20px;
		font-weight: 600;
		line-height: 1;
		color: var(--color-text-primary);
		user-select: none;
	}
</style>
