---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';

type Project = Awaited<ReturnType<typeof getCollection<'projects'>>>[number];

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

// Placeholder experience timeline (most recent first)
const experience = [
  { year: 2026, company: 'Washington Post', role: 'Software Engineer II' },
  { year: 2025, company: 'The New York Times', role: 'Front End Engineer' },
  { year: 2025, company: 'Astro', role: 'Open-Source Contributor' },
  { year: 2024, company: 'Wayfair', role: 'Software Engineer Intern' },
  { year: 2023, company: 'NPR', role: 'News Design Intern' },
];

// Placeholder tile gradients + aspect ratios (stand-ins for real thumbnails)
const gradients = [
  'linear-gradient(115deg, #f4a13c 0%, #e86a8b 55%, #8b6fd6 100%)',
  'linear-gradient(135deg, #c7cef0 0%, #dcd7f2 100%)',
  'linear-gradient(120deg, #7c8cf0 0%, #a97bd6 60%, #f0a5c0 100%)',
  'linear-gradient(135deg, #2b3350 0%, #5a6488 100%)',
];
const ratios = ['16 / 9', '8 / 5', '4 / 3', '3 / 2'];

// Fallback gradient/ratio keyed by original order, so cards keep a stable look
const fallbackRatio = (p: Project) => ratios[projects.indexOf(p) % ratios.length];
const fallbackGradient = (p: Project) => gradients[projects.indexOf(p) % gradients.length];

// Build layout blocks: projects sharing a `pair` id render side-by-side as two
// small half-width tiles; everything else is a full-width single.
type Block = { type: 'single' | 'pair'; items: Project[] };
const blocks: Block[] = [];
const pairs = new Map<string, Block>();
for (const p of projects) {
  const key = p.data.pair;
  if (key) {
    const existing = pairs.get(key);
    if (existing) existing.items.push(p);
    else {
      const b: Block = { type: 'pair', items: [p] };
      pairs.set(key, b);
      blocks.push(b);
    }
  } else {
    blocks.push({ type: 'single', items: [p] });
  }
}

// Distribute blocks across two masonry columns
const columns: Block[][] = [[], []];
blocks.forEach((b, i) => columns[i % 2].push(b));
---

<BaseLayout>
  <div class="container page">
    <!-- Hero + experience -->
    <section class="top">
      <div class="hero-col">
        <h1 class="hero-line">
          I'm Maxim, a product designer who <em>engineers</em>.
        </h1>
      </div>

      <div class="exp-col">
        <ul class="timeline">
          {
            experience.map((e) => (
              <li class="timeline-row">
                <span class="tl-year">{e.year}</span>
                <span class="tl-body">
                  <span class="tl-company">{e.company}</span>
                  <span class="tl-role">{e.role}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Work grid (two masonry columns) -->
    <section class="work">
      {
        columns.map((col) => (
          <div class="col">
            {col.map((block) =>
              block.type === 'pair' ? (
                <div class="pair">
                  {block.items.map((p) => (
                    <ProjectCard
                      project={p}
                      fallbackRatio={fallbackRatio(p)}
                      fallbackGradient={fallbackGradient(p)}
                    />
                  ))}
                </div>
              ) : (
                <ProjectCard
                  project={block.items[0]}
                  fallbackRatio={fallbackRatio(block.items[0])}
                  fallbackGradient={fallbackGradient(block.items[0])}
                />
              )
            )}
          </div>
        ))
      }
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-block: 24px;
  }

  /* ---- Hero + experience (two columns) ---- */
  .top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding-top: 28vh;
    padding-bottom: 8px;
  }

  .hero-line {
    max-width: 700px;
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: 2.75rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .hero-line em {
    font-style: italic;
    font-weight: 400;
  }

  /* right column bottom-aligns with the hero */
  .exp-col {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
  }
  .timeline {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .timeline-row {
    display: grid;
    grid-template-columns: 104px 224px 1fr;
    gap: 8px;
    align-items: baseline;
  }
  /* lets tl-company/tl-role act as direct grid items at the wide (side-by-side) layout */
  .tl-body {
    display: contents;
  }
  .tl-year {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }
  .tl-company {
    font-weight: 400;
    color: var(--fg);
  }
  .tl-role {
    color: var(--muted);
  }

  /* ---- Work grid ---- */
  .work {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    align-items: start;
  }
  .col {
    display: flex;
    flex-direction: column;
    gap: 24px;
    min-width: 0; /* allow the grid column to shrink below its content's min-content */
  }

  /* two small tiles side by side within one column */
  .pair {
    display: flex;
    gap: 12px;
  }
  .pair :global(.card) {
    flex: 1 1 0;
    min-width: 0;
  }
  /* stack title over meta in the narrow paired tiles */
  .pair :global(.cap) {
    flex-direction: column;
    align-items: flex-start;
    gap: 2px;
  }

  /* ---- Responsive ---- */
  @media (max-width: 1199px) {
    .top {
      grid-template-columns: 1fr;
      gap: 48px;
      padding-top: 32px;
    }
    .exp-col {
      justify-content: flex-start;
    }
    .work {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .timeline {
      gap: 12px;
    }
    .timeline-row {
      grid-template-columns: 104px 1fr;
    }
    .tl-body {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
  }

  @media (max-width: 520px) {
    .timeline-row {
      grid-template-columns: 72px 1fr;
      row-gap: 2px;
    }
    .tl-role {
      grid-column: 2;
    }
  }

  @media (min-width: 1200px) {
    .hero-line {
      font-size: 3.5rem;
    }
  }
</style>
