---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Terminal from "../components/Terminal.astro";

export async function getStaticPaths() {
	const projects = await getCollection("projects", (p) => !p.data.href);
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { data } = project;
const { Content, headings } = await render(project);

const sections = headings.filter((h) => h.depth === 2);
// One-off: only the Olympics case study gets rounded corners on its prose
// media — everywhere else stays sharp-cornered.
const isOlympics = project.id === "olympics";
const hasMedia = Boolean(data.video || data.image);
const ratio = data.ratio ?? "16 / 9";
// Ported from v2's ProjectCard (home thumbnail) — crops the rendered box
// itself (not just the media) by clipping it and pulling its layout space in
// by the same amount, so it actually gets shorter instead of leaving a gap.
const cropTop = data.cropTop ?? data.cropY ?? 0;
const cropBottom = data.cropBottom ?? data.cropY ?? 0;
const cropStyle =
	cropTop || cropBottom
		? `margin-top:-${cropTop}px;margin-bottom:-${cropBottom}px;clip-path:inset(${cropTop}px 0 ${cropBottom}px 0);`
		: "";
// Mirrors the home thumbnail's own fit/zoom/matte knobs (see index.astro's
// hardcoded project array), so a hero can be made to match its thumbnail.
const mediaStyle = `object-fit:${data.fit ?? "cover"};${data.zoom ? `--zoom:${data.zoom};` : ""}${data.position ? `object-position:${data.position};` : ""}`;

const meta = [
	{ label: "Role", values: [data.role] },
	{ label: "Timeline", values: [data.timeline] },
	{ label: "Team", values: Array.isArray(data.team) ? data.team : [data.team] },
	{ label: "Skills", values: data.skills },
];
---

<BaseLayout
	title={`${data.title} — Maxim Slobodchikov`}
	description={`${data.company} · ${data.status} ${data.year}`}
>
	<Nav />
	<main class="wrap">
		<div class="project-grid">
			<aside class="side">
				{
					sections.length > 0 && (
						<nav class="toc" aria-label="Sections">
							{sections.map((h) => (
								<a href={`#${h.slug}`} class="toc-link">
									{h.text}
								</a>
							))}
						</nav>
					)
				}
			</aside>

			<article class:list={["project", isOlympics && "project-rounded"]}>
				<header class="project-head">
					<p class="eyebrow">{data.company}</p>
					<h1 class="project-title">{data.title}</h1>
				</header>

				{data.heroTerminal && <Terminal />}

				{
					hasMedia && (
						<div class="hero-media" style={`aspect-ratio:${ratio};${cropStyle}${data.matte ? `background:${data.matte};` : ""}`}>
							{data.video ? (
								<video
									class="hero-media-el"
									src={data.video}
									style={mediaStyle}
									autoplay
									loop
									muted
									playsinline
									preload="metadata"
								/>
							) : (
								<img class="hero-media-el" src={data.image} alt={data.title} style={mediaStyle} />
							)}
							<div class="hero-media-overlay" style={data.bg ? `--card-bg: ${data.bg};` : ""} />
						</div>
					)
				}

				<dl class="meta">
					{
						meta.map((m) => (
							<div class="meta-item">
								<dt class="caption">{m.label}</dt>
								<dd>
									{m.values.map((v) =>
										typeof v === "string" ? (
											<p>{v}</p>
										) : (
											<p>
												<a class="link" target="_blank" rel="noreferrer" href={v.href}>
													{v.name}
												</a>
												<sup class="arrow">↗</sup>
											</p>
										),
									)}
								</dd>
							</div>
						))
					}
				</dl>

				<div class="prose">
					<Content />
				</div>
			</article>
		</div>
	</main>
</BaseLayout>

<script>
	// Highlight whichever section heading is currently in view.
	const links = document.querySelectorAll<HTMLAnchorElement>(".toc-link");
	const sections = Array.from(links)
		.map((link) => document.getElementById(link.hash.slice(1)))
		.filter((el): el is HTMLElement => Boolean(el));

	if (sections.length && links.length) {
		const setActive = (id: string) => {
			links.forEach((link) => link.classList.toggle("active", link.hash === `#${id}`));
		};

		// A click now animates through every section between here and the
		// target, and each one crossing the observer band would drag the
		// active highlight along with it. Pin the clicked link instead and
		// ignore the observer until the scroll comes to rest.
		let seeking = false;
		let settle: number | undefined;
		const restIn = (ms: number) => {
			clearTimeout(settle);
			settle = window.setTimeout(() => {
				seeking = false;
			}, ms);
		};

		const observer = new IntersectionObserver(
			(entries) => {
				if (seeking) return;
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					setActive(entry.target.id);
				}
			},
			{ rootMargin: "-10% 0px -75% 0px" },
		);
		sections.forEach((section) => observer.observe(section));

		links.forEach((link) => {
			link.addEventListener("click", () => {
				setActive(link.hash.slice(1));
				seeking = true;
				// Upper bound, in case the click scrolls nowhere (already at
				// the target) and no scroll event ever arrives to release it.
				restIn(1000);
			});
		});

		// Each scroll event pushes the release out, so the lock lasts exactly
		// as long as the animation does regardless of the distance travelled.
		window.addEventListener("scroll", () => { if (seeking) restIn(150); }, { passive: true });
	}

	// Manual play/pause + restart overlay controls for a <video> wrapped in
	// <div class="video-frame">. The buttons just call the video's own
	// play()/pause(), and the icon swap listens to the video's own events so
	// it stays in sync regardless of which one triggered it.
	const DEFAULT_START_TIME = 0.5;

	document.querySelectorAll<HTMLElement>(".video-frame").forEach((frame) => {
		const video = frame.querySelector("video");
		if (!video) return;

		const startTime = Number(frame.dataset.start ?? DEFAULT_START_TIME);

		const setStartFrame = () => {
			video.currentTime = startTime;
			video.removeEventListener("loadedmetadata", setStartFrame);
		};
		if (video.readyState >= 1) setStartFrame();
		else video.addEventListener("loadedmetadata", setStartFrame);

		const syncIcon = () => frame.classList.toggle("paused", video.paused);
		video.addEventListener("play", syncIcon);
		video.addEventListener("pause", syncIcon);
		syncIcon();

		frame.querySelector(".btn-play-pause")?.addEventListener("click", () => {
			if (video.paused) video.play().catch(() => {});
			else video.pause();
		});

		frame.querySelector(".btn-restart")?.addEventListener("click", () => {
			video.currentTime = startTime;
			video.play().catch(() => {});
		});
	});

	// Color-card reveal for the hero media — mirrors index.astro's thumbnail
	// treatment: the overlay starts opaque and fades out once its image/video
	// has actually decoded a frame.
	document.querySelectorAll<HTMLElement>(".hero-media").forEach((hero) => {
		const media = hero.querySelector<HTMLImageElement | HTMLVideoElement>(".hero-media-el");
		const overlay = hero.querySelector<HTMLElement>(".hero-media-overlay");
		if (!media || !overlay) return;

		const reveal = () => overlay.classList.add("is-loaded");

		if (media instanceof HTMLImageElement) {
			if (media.complete && media.naturalWidth > 0) reveal();
			else media.addEventListener("load", reveal, { once: true });
		} else if (media.readyState >= 2) {
			reveal();
		} else {
			media.addEventListener("loadeddata", reveal, { once: true });
		}
	});
</script>

<style>
	.project-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1.5rem;
		padding-block: 2rem 4rem;
	}

	/* ---- Sidebar: section TOC ---- */
	.side {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
	}

	.toc {
		display: none;
		flex-direction: column;
		gap: 0.5rem;
	}

	/* Slide to the section instead of jumping. `:global` because Astro would
	   otherwise scope this to a `html[data-astro-cid-…]` that never matches;
	   it still only ships on project pages, which are the only ones with
	   in-page anchors. `h2`'s `scroll-margin-top` keeps the landing point
	   clear of the sticky nav. */
	:global(html) {
		scroll-behavior: smooth;
	}
	@media (prefers-reduced-motion: reduce) {
		:global(html) {
			scroll-behavior: auto;
		}
	}
	.toc-link {
		color: var(--muted);
		transition: color 0.15s ease;
	}
	.toc-link:hover {
		color: var(--fg);
	}
	.toc-link.active {
		color: var(--accent);
	}

	/* ---- Main column ---- */
	.project {
		display: flex;
		flex-direction: column;
		gap: 2rem;
		min-width: 0;
		/*
		 * Explicit, not the grid/flex-item default: a grid item with auto
		 * inline margins (added at 768px+ below, to center this column in its
		 * wider track) loses the default stretch alignment and shrink-wraps
		 * to its content's intrinsic width instead — which for the CLI case
		 * study's terminal transcripts (fixed `ch`-width `<pre>` grids) is
		 * ~680px, wider than mobile viewports, and doesn't shrink because a
		 * shrink-wrapped box has no independent size to measure a resize
		 * against. Pinning width:100% keeps this column at the track's
		 * width — centering (once max-width kicks in) comes from the auto
		 * margins alone, not from shrink-wrap.
		 */
		width: 100%;
	}

	.project-head {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
	}

	.eyebrow {
		font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 12px;
		font-weight: 300;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.project-title {
		font-size: 1.75rem;
		line-height: 1.15;
		font-weight: 400;
		letter-spacing: -0.01em;
		color: var(--fg);
		margin: 0;
	}

	@media (min-width: 768px) {
		.project-title {
			font-size: 2.5rem;
		}
	}

	.hero-media {
		position: relative;
		width: 100%;
		overflow: hidden;
		outline: 1px solid var(--rule);
		outline-offset: -1px;
		background: var(--thumb-placeholder);
	}
	.hero-media-el {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transform: scale(var(--zoom, 1));
	}

	/*
	 * Same solid-color-frame loading strategy as the homepage thumbnails (see
	 * index.astro's .project-thumb-overlay) — the card starts opaque over the
	 * media and fades out once the asset has actually decoded a frame, rather
	 * than blurring or fading the media itself in.
	 */
	.hero-media-overlay {
		position: absolute;
		inset: 0;
		opacity: 1;
		background: var(--card-bg, var(--thumb-placeholder));
	}

	:global(:root[data-theme="dark"]) .hero-media-overlay {
		background: var(--thumb-placeholder);
	}

	.hero-media-overlay.is-loaded {
		opacity: 0;
		transition: opacity 550ms ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-media-overlay {
			animation: none;
			opacity: 0;
		}
	}

	.meta {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem 1.5rem;
		margin: 0;
		padding-block: 1.5rem;
		text-align: left;
	}

	.meta-item {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.1rem;
	}

	.meta-item dt {
		/* .caption (global.css) already carries margin-bottom: 0.5rem — the
		   same label-to-content gap used everywhere else on the site (hero
		   About/Teams/Links). Leave it as-is instead of the .meta-item gap
		   above, which only spaces the value lines within an item. */
		margin: 0 0 0.5rem;
	}

	.meta-item dd {
		margin: 0;
		color: var(--fg);
	}

	.meta-item dd p {
		margin: 0;
	}

	/* Body content rendered from MDX (flat h2/p/img siblings). h2 is the
	   anchored section name (TOC label) — styled as a small mono/uppercase
	   eyebrow, not a big heading. h3/h4 are an optional bigger statement +
	   smaller grouped sub-point within that section. */

	/* Sits on top of `.project`'s 2rem flex gap for 96px total between the
	   meta block and the first section — the largest break on the page, so
	   the case study reads as starting here rather than continuing the
	   header. `h2:first-child` zeroes its own margin, so this is the whole
	   gap. */
	.prose {
		padding-top: 4rem;
	}

	.prose :global(h2) {
		font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 12px;
		font-weight: 300;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		/* The section break — this top margin is the largest gap in the
		   prose, so each `##` reads as starting a new section rather than
		   continuing the last one. */
		margin: 4rem 0 1.25rem;
		scroll-margin-top: 4.5rem;
	}
	.prose :global(h2:first-child) {
		margin-top: 0;
	}

	.prose :global(h3) {
		font-size: 1.5rem;
		font-weight: 400;
		line-height: 1.2;
		letter-spacing: -0.01em;
		color: var(--fg);
		/* Top stays small — it collapses against the `h2` label's 1.25rem
		   bottom, keeping label and headline paired as one unit. The bottom
		   margin is what separates the headline from its body copy. */
		margin: 0.25rem 0 1.25rem;
	}

	.prose :global(h4) {
		font-size: 1.1rem;
		font-weight: 500;
		letter-spacing: -0.01em;
		color: var(--fg);
		margin: 2rem 0 0.35rem;
	}

	/* Wrap items in <div class="cols"><div>...</div>...</div> inside MDX
	   content to use it — columns split evenly across however many direct
	   children are given. */
	.prose :global(.cols) {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: 1fr;
		column-gap: 1.5rem;
		/* Symmetric like `.media-row`/images: the block's own children are
		   margin-zeroed, and `h3` only carries 0.25rem of its own, so without
		   a bottom margin here whatever follows a `.cols` sits nearly flush. */
		margin-block: 1.5rem;
	}
	.prose :global(.cols h4) {
		margin-top: 0;
	}
	.prose :global(.cols p) {
		margin-bottom: 0;
	}
	.prose :global(.cols img) {
		margin-block: 0;
	}

	/* Opt-in modifier, e.g. class="cols cols-ratio" — for rings.png and
	   social.png, which ship at slightly different intrinsic ratios (1.56 vs
	   1.51). Forces both to the same box and crops instead of letting each
	   column resolve its own height. Scoped to this modifier rather than
	   every .cols, since most uses (e.g. the 1a/1b/1c split below) are
	   already equal-size crops that shouldn't be force-cropped again. */
	.prose :global(.cols-ratio img) {
		aspect-ratio: 3 / 2;
		object-fit: cover;
	}

	@media (max-width: 629px) {
		.prose :global(.cols) {
			grid-auto-flow: row;
			grid-auto-columns: unset;
			grid-template-columns: 1fr;
			row-gap: 1.5rem;
		}

		/* Opt-in modifier, e.g. class="cols cols-keep-row" — for the 1a/1b/1c
		   split below, which reads as one image cut into thirds and should
		   never stack into a column even at mobile widths. Tighter gap since
		   three columns have much less room to share than the default two. */
		.prose :global(.cols.cols-keep-row) {
			grid-auto-flow: column;
			grid-auto-columns: 1fr;
			grid-template-columns: unset;
			row-gap: 0;
			column-gap: 0.4rem;
		}
	}

	/* Opt-in narrower, centered variant, e.g. class="cols centered" — for a
	   single standalone item that shouldn't stretch full-width. */
	.prose :global(.cols.centered) {
		width: 66%;
		margin-inline: auto;
	}

	@media (max-width: 629px) {
		.prose :global(.cols.centered) {
			width: 100%;
		}
	}

	.prose :global(p) {
		/* Same token as `h2` — body copy sits back from the headings, which
		   keep `--fg`. `--muted` is defined per theme, so this tracks both. */
		color: var(--muted);
		margin: 0 0 1.25rem;
	}

	.prose :global(ul),
	.prose :global(ol) {
		color: var(--muted);
		margin: 0 0 1.25rem;
		padding-left: 1.25rem;
	}

	.prose :global(li) {
		margin-bottom: 0.4rem;
	}

	.prose :global(li:last-child) {
		margin-bottom: 0;
	}

	.prose :global(blockquote) {
		border-left: 2px solid var(--rule);
		color: var(--muted);
		font-style: italic;
		margin: 1.5rem 0;
		padding-left: 1rem;
	}

	.prose :global(blockquote p) {
		margin: 0;
	}

	/* Confidentiality notice — same blockquote treatment, just bigger, so it
	   reads as a standalone callout rather than a body-copy aside (see
	   rachelchen.tech's project pages, which use an h3 for this). */
	.prose :global(blockquote.confidential) {
		font-size: 1.35rem;
	}

	.prose :global(img),
	.prose :global(video) {
		display: block;
		width: 100%;
		/* Each image keeps its own shape — only the hero is normalised to
		   16:9. `height: auto` lets the browser derive `aspect-ratio` from the
		   MDX width/height attributes and reserve the box before the file
		   loads; without them a <video> is 300x150 until its metadata arrives,
		   which grew the page ~286px mid-scroll. Give any new media in the
		   MDX its intrinsic dimensions for the same reason. */
		height: auto;
		margin-block: 1.75rem;
	}

	/* Wrap a single <img> in <div class="crop-expand"> to scale it up past the
	   column edges and clip the overflow at the wrapper's normal width —
	   a slight "zoom in" rather than a real full-bleed. */
	.prose :global(.crop-expand) {
		overflow: hidden;
		margin-block: 1.75rem;
	}
	.prose :global(.crop-expand img) {
		width: 105%;
		max-width: 105%;
		margin-left: -2.5%;
		margin-block: 0;
	}

	/* Olympics case study only — rounded corners on its prose media (not the
	   hero above it, which stays sharp everywhere). */
	.project-rounded .prose :global(img),
	.project-rounded .prose :global(video),
	.project-rounded .prose :global(.crop-expand),
	.project-rounded .prose :global(.top-pad) {
		border-radius: 8px;
	}

	/* Wrap a single <img> in <div class="top-pad"> to cap it with a solid
	   band above the image itself — e.g. a screenshot whose own top edge is
	   an awkward crop. Mirrors .crop-expand: the margin that normally lives
	   on the img moves to this wrapper, and the img is reset to flush. */
	.prose :global(.top-pad) {
		background: #fff;
		padding-top: 30px;
		margin-block: 1.75rem;
	}
	.prose :global(.top-pad img) {
		margin-block: 0;
	}

	.prose :global(img.outlined),
	.prose :global(video.outlined) {
		outline: 1px solid var(--rule);
		outline-offset: -1px;
	}

	.prose :global(.half) {
		width: 50%;
	}

	.prose :global(.align-left) {
		width: 72%;
		margin-right: auto;
	}

	.prose :global(.align-right) {
		width: 72%;
		margin-left: auto;
	}

	/* Half-width media, left-aligned, with a caption set beside it on the
	   right, bottom-aligned — wrap <video>/<img> + a
	   <div class="media-row-caption"><h3/><p/></div> in <div class="media-row">. */
	.prose :global(.media-row) {
		display: flex;
		align-items: flex-end;
		gap: 2rem;
		margin-block: 1.75rem;
	}
	.prose :global(.media-row img),
	.prose :global(.media-row .video-frame) {
		width: 50%;
		flex-shrink: 0;
		margin-block: 0;
	}
	.prose :global(.media-row-caption h3) {
		font-size: 1.1rem;
		margin: 0 0 0.5rem;
	}
	.prose :global(.media-row-caption p) {
		font-size: 12px;
		max-width: 32ch;
		margin: 0;
	}

	@media (max-width: 629px) {
		.prose :global(.media-row) {
			flex-direction: column;
			align-items: flex-start;
			gap: 1rem;
		}
		.prose :global(.media-row img),
		.prose :global(.media-row .video-frame) {
			width: 100%;
		}
	}

	/* Play/pause + restart overlay for a <video> — wrap it in
	   <div class="video-frame"> with a <div class="video-controls"> of two
	   buttons (see mdx). Controls fade in on hover, like native video chrome. */
	.prose :global(.video-frame) {
		position: relative;
	}
	.prose :global(.video-frame video) {
		display: block;
		width: 100%;
		margin-block: 0;
	}
	.prose :global(.video-controls) {
		position: absolute;
		right: 0.75rem;
		bottom: 0.75rem;
		display: flex;
		gap: 0.5rem;
		opacity: 0;
		transition: opacity 0.15s ease;
	}
	.prose :global(.video-frame:hover .video-controls),
	.prose :global(.video-frame:focus-within .video-controls) {
		opacity: 1;
	}
	.prose :global(.video-controls button) {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: none;
		border-radius: 999px;
		background: rgba(0, 0, 0, 0.55);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		color: #fff;
		cursor: pointer;
	}
	.prose :global(.video-controls button:hover) {
		background: rgba(0, 0, 0, 0.75);
	}
	/* Opt-in variant for videos with dark footage, so the buttons stay legible
	   — add class="light" to the .video-controls wrapper. */
	.prose :global(.video-controls.light button) {
		background: rgba(255, 255, 255, 0.85);
		color: #111;
	}
	.prose :global(.video-controls.light button:hover) {
		background: rgba(255, 255, 255, 1);
	}
	.prose :global(.video-controls svg) {
		width: 16px;
		height: 16px;
	}
	.prose :global(.video-controls .icon-play) {
		display: none;
	}
