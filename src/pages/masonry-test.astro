---
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";

// Test page only — explores a masonry layout for the homepage thumbnail
// grid. Copied from index.astro's `projects` + thumbnail markup/styles
// rather than imported, since index.astro doesn't export it.
//
// The masonry effect never resizes/crops the actual thumbnail (still the
// same 16:9 box, same width, same media): each card gets its own `tall`
// value (px) added as top+bottom padding around the thumb, in a solid color
// sampled from that project's own `matColor` — the mat just extends the
// card, it never touches the image itself.
//
// `matColor` is picked from the top row of each source asset itself (an
// average of its top ~10px, first frame for video), NOT the hand-picked
// pastel `bg` used elsewhere — `bg` is tuned for the homepage's loading-card
// flash and often doesn't match the asset's actual edge color, which is what
// made the mat bars look wrong here.
const projects = [
	{ title: "The Future of AI & News", subtitle: "OPENAI X WASHINGTON POST", video: "/projects/project-one.mp4", bg: "#d8e3f9", matColor: "#648adc", href: "/openai", tall: 0 },
	{ title: "Designing a CLI", subtitle: "THE WASHINGTON POST", image: "/projects/clihero.png", bg: "#d1eef9", matColor: "#efeeeb", href: "/cli", tall: 120 },
	{ title: "Ask The Post", subtitle: "THE WASHINGTON POST", video: "/projects/atp_newest_trimmed.mp4", bg: "#dcdde0", matColor: "#121212", href: "/openai", tall: 40 },
	{
		title: "Interactive Guide to Your Kitchen",
		subtitle: "NYT COOKING",
		video: "/projects/goal.mp4",
		// goal.mp4 is 1440×1080 (4:3, aspect 1.33) — taller than the default
		// 16:9 (1.78) thumb box. 5:4 (1.25) is still taller than the video's
		// own ratio, so cover-fit (the default — no `fit` set) still crops the
		// sides instead of top/bottom, just shorter than the old 1:1 square.
		// zoom < 1 shrinks the video within that crop, showing a hair more of
		// its edges rather than filling the box edge-to-edge.
		ratio: "5 / 4",
		zoom: 0.9,
		bg: "#f8dede",
		matColor: "#eeeeee",
		href: "/nytcooking",
		tall: 0,
	},
	{
		title: "Open-Source Harness Framework",
		subtitle: "ASTRO + FLUE · 2026",
		image: "/projects/flue2.png",
		fit: "contain",
		zoom: 1.3,
		bg: "#ebdcef",
		matColor: "#dec4e5",
		href: "/astro",
		tall: 80,
	},
	{
		title: "Olympics Medal Tracker",
		subtitle: "THE WASHINGTON POST",
		image: "/projects/wapo11.png",
		// wapo11.png is 1440×1080 (4:3) — the old 16:9 box + "50% 15%" position
		// cropped out real content below the fold and papered over the
		// resulting shortfall with an 80px solid-color bar top and bottom.
		// Matching the box to the image's own 4:3 ratio means cover-fit crops
		// nothing at all, so that extra height comes from real image content
		// instead of a fabricated block. No more bottom bar; top bar is just
		// a small cap.
		ratio: "4 / 3",
		bg: "#c8e3ff",
		matColor: "#85bfff",
		href: "/olympics",
		matTop: 24,
		matBottom: 0,
	},
	{ title: "10,000 Beers", subtitle: "Drinkbot", video: "/projects/newone.mp4", bg: "#d7d6db", matColor: "#0f0f0f", href: "https://drinks.maximslo.com/", external: true, tall: 20 },
	{ title: "Election Developer Tools", subtitle: "The New York Times", image: "/projects/elections12th.png", bg: "#bad4fe", matColor: "#efeeec", href: "/elections", tall: 100 },
	{
		title: "10,000 Beers",
		subtitle: "Drinkbot",
		image: "/projects/drinky-screenshot.png",
		zoom: 0.85,
		position: "50% 35%",
		bg: "#3a84fc",
		matColor: "#5084f7",
		href: "https://drinks.maximslo.com/",
		external: true,
		tall: 0,
	},
];
---

<BaseLayout title="Masonry test">
	<Nav />
	<main class="wrap">
		<section class="work">
			<div class="work-grid">
				{
					projects.map((p) => {
						const Tag = p.href ? "a" : "div";
						const padTop = p.matTop ?? Math.round(p.tall / 2);
						const padBottom = p.matBottom ?? p.tall - padTop;
						return (
							<Tag
									class="project-card"
									{...(p.href ? { href: p.href } : {})}
									{...(p.external ? { target: "_blank", rel: "noreferrer" } : {})}
								>
								<div class="masonry-mat" style={`background:${p.matColor}; padding: ${padTop}px 0 ${padBottom}px;`}>
									<div class="project-thumb" style={`--thumb-bg: ${p.matColor};${p.ratio ? ` aspect-ratio: ${p.ratio};` : ""}`}>
										{p.video && (
											<video
												src={p.video}
												class="project-thumb-img"
												autoplay
												loop
												muted
												playsinline
												style={`${p.fit ? `object-fit: ${p.fit};` : ""}${p.zoom ? `--zoom: ${p.zoom};` : ""}${p.position ? `object-position: ${p.position};` : ""}`}
											/>
										)}
										{p.image && (
											<img
												src={p.image}
												alt={p.title}
												class="project-thumb-img"
												style={`${p.fit ? `object-fit: ${p.fit};` : ""}${p.zoom ? `--zoom: ${p.zoom};` : ""}${p.position ? `object-position: ${p.position};` : ""}`}
											/>
										)}
										<div class="project-thumb-overlay" style={`--card-bg: ${p.bg};`} />
									</div>
								</div>
							</Tag>
						);
					})
				}
			</div>
		</section>
	</main>
</BaseLayout>

<style>
	.work {
		margin-top: 2rem;
		padding-bottom: 3rem;
	}

	.caption {
		font-family: "Geist Mono", ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
		font-size: 12px;
		font-weight: 300;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--muted);
		margin: 0 0 1rem;
	}

	/*
	 * Fixed 3-column masonry via CSS multi-column, not CSS grid: grid would
	 * force every row to the height of its tallest cell, which is exactly
	 * what a masonry layout needs to avoid. Columns fill top-to-bottom and
	 * `break-inside: avoid` keeps each card from being split across two
	 * columns. Always 3 columns — this test page doesn't reflow at narrower
	 * widths.
	 */
	.work-grid {
		column-count: 3;
		column-gap: 0.75rem;
	}

	.project-card {
		display: block;
		break-inside: avoid;
		/* Matches .work-grid's column-gap (0.75rem) so vertical and horizontal
		   spacing between cards read as the same rhythm. */
		margin-bottom: 0.75rem;
	}

	/*
	 * The colored mat that makes the card taller for the masonry effect.
	 * Padding-only — the thumbnail inside is never resized or cropped, so
	 * the mat reads as extra canvas around the same, unmodified thumbnail.
	 * `position: relative` so the hover scrim below (`::after`) can cover the
	 * whole mat — bars included — not just the thumbnail inside it.
	 * Radius + `overflow: hidden` live here rather than on `.project-thumb`
	 * so the whole card — mat and thumb together — rounds as one piece;
	 * rounding only the thumb would leave the mat bars square.
	 */
	.masonry-mat {
		position: relative;
		width: 100%;
		border-radius: 12px;
		overflow: hidden;
	}

	.project-thumb {
		position: relative;
		aspect-ratio: 16 / 9;
		background: var(--thumb-bg, var(--thumb-placeholder));
		overflow: hidden;
		border-radius: 0px;
		width: 100%;
	}

	.project-thumb-img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
		transform: scale(var(--zoom, 1.02));
	}

	.project-thumb-overlay {
		position: absolute;
		inset: 0;
		opacity: 1;
		background: var(--card-bg);
	}

	:global(:root[data-theme="dark"]) .project-thumb-overlay {
		background: var(--thumb-placeholder);
	}

	.project-thumb-overlay.is-loaded {
		opacity: 0;
		transition: opacity 550ms ease;
	}

	@media (prefers-reduced-motion: reduce) {
		.project-thumb-overlay {
			animation: none;
			opacity: 0;
		}
	}

	/*
	 * Lives on .masonry-mat (the full card, bars included) rather than
	 * .project-thumb, so hovering anywhere on the card — including the added
	 * top/bottom mat bars — darkens the whole thing as one piece, not just
	 * the original thumbnail content.
	 */
	.masonry-mat::after {
		content: "";
		position: absolute;
		inset: 0;
		background: rgba(0, 0, 0, 0.2);
		opacity: 0;
		pointer-events: none;
	}

	a.project-card:hover .masonry-mat::after {
		opacity: 1;
	}
</style>

<script>
	// Same color-card reveal as the homepage: overlay starts opaque, fades
	// out once the media has actually decoded a frame.
	document.querySelectorAll<HTMLElement>(".project-thumb").forEach((thumb) => {
		const media = thumb.querySelector<HTMLImageElement | HTMLVideoElement>(".project-thumb-img");
		const overlay = thumb.querySelector<HTMLElement>(".project-thumb-overlay");
		if (!media || !overlay) return;

		const reveal = () => overlay.classList.add("is-loaded");

		if (media instanceof HTMLImageElement) {
			if (media.complete && media.naturalWidth > 0) reveal();
			else media.addEventListener("load", reveal, { once: true });
		} else if (media.readyState >= 2) {
			reveal();
		} else {
			media.addEventListener("loadeddata", reveal, { once: true });
		}
	});
</script>
