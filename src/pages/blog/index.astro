---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const fmt = (d: Date) =>
	d.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
---

<BaseLayout title="blog" description="Writing.">
	<h1>blog</h1>
	<ul class="post-list">
		{
			posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}`}>{post.data.title}</a>
					<time class="muted">{fmt(post.data.date)}</time>
				</li>
			))
		}
	</ul>

	<style>
		.post-list {
			list-style: none;
			padding: 0;
			margin: 2rem 0 0;
		}
		.post-list li {
			display: flex;
			justify-content: space-between;
			gap: 1rem;
			padding: 0.4rem 0;
		}
		time {
			font-family: var(--mono);
			font-size: 0.85rem;
			white-space: nowrap;
		}
	</style>
</BaseLayout>
