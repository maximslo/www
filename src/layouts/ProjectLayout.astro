---
// Shared shell for the per-project pages at /work/<slug>/. Reproduces the
// homepage's identity (paper/ink palette, DM Sans, baked-in 150% scale, the
// pre-paint dark-mode script and toggle) so a project page reads as the same
// site — just a classic, single-column article instead of the work grid.

interface Props {
	title: string;
	description?: string;
	/** Absolute-ish path (relative to base) of an image for link previews. */
	ogImage?: string;
}

const { title, description = "", ogImage } = Astro.props;

// base path normalized to always end in a slash (BASE_URL can be "/www")
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const pageUrl = new URL(Astro.url.pathname.replace(/^\//, ""), Astro.site).href;
const ogImageUrl = new URL(`${base}${ogImage ?? "og.png"}`, Astro.site).href;
const pageTitle = `${title} — maxim slobodchikov`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href={`${base}fish.svg`} />
		<link rel="icon" type="image/png" href={`${base}fish.png`} />
		<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
		<link rel="manifest" href={`${base}site.webmanifest`} />
		<meta name="theme-color" content="#fbfbf9" />

		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={pageUrl} />

		<!-- Open Graph (link previews: iMessage, Slack, LinkedIn, Facebook) -->
		<meta property="og:type" content="article" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:alt" content={title} />

		<!-- Twitter / X card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script is:inline>
			// set theme before first paint to avoid a flash
			(function () {
				const saved = localStorage.getItem("theme");
				const dark = saved ? saved === "dark" : matchMedia("(prefers-color-scheme: dark)").matches;
				if (dark) document.documentElement.dataset.theme = "dark";
			})();
		</script>
		<!-- self-hosted DM Sans, preloaded so it is ready before first paint (no FOUT) -->
		<link rel="preload" href={`${base}fonts/dmsans-variable.woff2`} as="font" type="font/woff2" crossorigin />
		<style>
			@font-face {
				font-family: "DM Sans";
				font-style: normal;
				font-weight: 300 700;
				font-display: swap;
				src: url("/fonts/dmsans-variable.woff2") format("woff2");
				/* match Google's latin subset so non-latin glyphs (the ↗ / ← arrows) fall back to the system font, as on the live site */
				unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+2074, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
			}
			:root {
				--paper: #fbfbf9;
				--ink: #1a1a1a;
				--muted: #1a1a1a;
				--label: #9b9893;
				--rule: #cfccc4;
				--thumb-border: #e6e3dd;
				--accent: #e07a5f;
				--link: #2563eb;
				--space-item: 0.8rem;
				--space-section: 1.9rem;
			}
			html[data-theme="dark"] {
				--paper: #121211;
				--ink: #ece9e3;
				--muted: #ece9e3;
				--label: #807d77;
				--rule: #34332f;
				--thumb-border: #2c2b28;
				--link: #7aa2f7;
			}
			html {
				/* baked-in 150% scale, matching the homepage */
				font-size: 150%;
				/* always reserve the scrollbar gutter so the centered column
				   doesn't shift when a scrollbar appears (e.g. after font load) */
				scrollbar-gutter: stable;
			}
			html,
			body {
				background: var(--paper);
			}
			body {
				transition: background-color 0.25s ease, color 0.25s ease;
			}
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				min-height: 100vh;
				background: var(--paper);
				color: var(--ink);
				font-family: "DM Sans", ui-sans-serif, system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
				font-weight: 400;
				letter-spacing: -0.015em;
				display: flex;
				justify-content: center;
				padding: 3rem 1.5rem 4rem;
			}
			.page {
				width: 100%;
				max-width: 27.5rem; /* 440px at the base 16px root — matches the homepage */
			}
			nav {
				display: flex;
				align-items: flex-start;
				gap: 1.5rem;
				font-size: 0.9rem;
				line-height: 1;
				padding-top: 2rem;
				margin-bottom: var(--space-section);
			}
			.back-link {
				color: var(--muted);
				text-decoration: none;
			}
			.back-link::before {
				content: "←";
				margin-right: 0.4rem;
				vertical-align: -0.02em;
			}
			.back-link:hover {
				text-decoration: underline;
				text-underline-offset: 5px;
			}
			.theme-toggle {
				margin-left: auto;
				/* nudge down to match the homepage toggle's pixel position */
				margin-top: 0.3rem;
				padding: 0;
				border: 0;
				background: none;
				color: var(--muted);
				cursor: pointer;
				line-height: 0;
				flex-shrink: 0;
				font: inherit;
			}
			.theme-toggle svg {
				display: block;
				width: 0.9rem;
				height: 0.9rem;
			}
			.theme-toggle:hover {
				opacity: 0.6;
			}
			.theme-toggle .icon-sun {
				display: none;
			}
			html[data-theme="dark"] .theme-toggle .icon-moon {
				display: none;
			}
			html[data-theme="dark"] .theme-toggle .icon-sun {
				display: block;
			}
			@media (max-width: 768px) {
				html {
					font-size: 115%;
				}
				body {
					padding: 1.75rem 1.25rem 2.5rem;
				}
				nav {
					padding-top: 1rem;
					gap: 0.75rem;
				}
			}
		</style>
	</head>
	<body>
		<div class="page">
			<nav>
				<a class="back-link" href={base}>back</a>
				<button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle dark mode">
					<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
					<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path></svg>
				</button>
			</nav>

			<slot />
		</div>

		<script>
			// dark mode toggle: flip data-theme and remember the choice
			const toggle = document.getElementById("theme-toggle");
			toggle?.addEventListener("click", () => {
				const dark = document.documentElement.dataset.theme === "dark";
				document.documentElement.dataset.theme = dark ? "" : "dark";
				localStorage.setItem("theme", dark ? "light" : "dark");
			});

			// project hero videos: autoplay only while on screen
			const vids = document.querySelectorAll<HTMLVideoElement>("video.hero-media");
			if (vids.length) {
				const io = new IntersectionObserver(
					(entries) => {
						for (const e of entries) {
							const v = e.target as HTMLVideoElement;
							if (e.isIntersecting) v.play().catch(() => {});
							else v.pause();
						}
					},
					{ rootMargin: "200px" },
				);
				vids.forEach((v) => io.observe(v));
			}
		</script>
	</body>
</html>
