---
import "../styles/global.css";
import { INTRO_NAME } from "../config/intro";

interface Props {
	title: string;
	description: string;
	/** A page that's all dark surface (the portfolio): no white sheet above
	    it and no scroll reveal, just the default slot on the dark colour. */
	dark?: boolean;
}

const { title, description, dark = false } = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL("/og-image.png", Astro.site);
---

<html lang="en" data-site-surface={dark ? "reveal" : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="color-scheme" content={dark ? "dark" : "light"} />
		<meta name="theme-color" content={dark ? "#050505" : "#ffffff"} />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="canonical" href={canonicalUrl} />
		<title>{title}</title>

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={INTRO_NAME} />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={`${INTRO_NAME} — site preview`} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />

		<script async src="https://plausible.io/js/pa-7S32kUOaXXAwP92XAjsL0.js"></script>
		<script is:inline>
			window.plausible =
				window.plausible ||
				function () {
					(plausible.q = plausible.q || []).push(arguments);
				};
			plausible.init = plausible.init || function (i) { plausible.o = i || {}; };
			plausible.init();
		</script>
	</head>
	<body>
		{
			dark ? (
				<slot />
			) : (
				<>
					{/* The white sheet and the dark surface it sits on. Pages that pass nothing
					    to `reveal` (404) get the sheet alone — a single centred screen, exactly
					    as before — and canvas-reveal.ts stands down when it finds no section. */}
					<div class="site-page">
						<div class="site-reveal">
							<div class="site-canvas">
								<slot />
							</div>
							<slot name="reveal" />
						</div>
					</div>
				</>
			)
		}

		{
			!dark && (
				<script>
					import "../scripts/canvas-reveal";
				</script>
			)
		}
	</body>
</html>
